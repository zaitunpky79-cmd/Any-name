local function styleBtn(b)
    b.BackgroundColor3, b.BorderSizePixel, b.BorderColor3 = COLORS.Void, 1, COLORS.DarkAbyss
    b.TextColor3, b.Font, b.TextSize = Color3.new(0.8, 0.8, 0.8), Enum.Font.SourceSansBold, 11
    b.MouseEnter:Connect(function() b.BorderColor3 = COLORS.Accent b.TextColor3 = Color3.new(1,1,1) end)
    b.MouseLeave:Connect(function() b.BorderColor3 = COLORS.DarkAbyss b.TextColor3 = Color3.new(0.8,0.8,0.8) end)
end

local function createBtn(txt, pos, size, parent)
