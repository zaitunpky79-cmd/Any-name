local function poseSet(t, rate)
	for k in pairs(poseT) do poseT[k] = t[k] or 0 end
	poseRate = rate or 8
end

-- players --------------------------------------------------------------------------------------------
local function targetHrp(pl)
	local c = pl and pl.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function findPlayer(txt)
	txt = string.lower(txt or ""):match("^%s*(.-)%s*$")
	if txt == "" then return nil end
	local partial
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= lp then
			local n, d = pl.Name:lower(), pl.DisplayName:lower()
			if n == txt or d == txt then return pl end
			if not partial and (n:sub(1, #txt) == txt or d:sub(1, #txt) == txt) then partial = pl end
		end
	end
	return partial
end
local function getMove()
	local mv
	if controls then
		local ok, v = pcall(function() return controls:GetMoveVector() end)
		if ok then mv = v end
	end
	if mv then
		local w = cam.CFrame:VectorToWorldSpace(V(mv.X, 0, mv.Z))
		w = V(w.X, 0, w.Z)
		if w.Magnitude > 0.01 then return w.Unit * math.min(1, mv.Magnitude) end
		return V()
	end
	local d = hum.MoveDirection
	return V(d.X, 0, d.Z)
end

-- skills (anticipation -> action -> follow-through) ----------------------------------------------------------
local skills = {}
local function groundFront(dist)
	local F = V(-math.sin(heading), 0, -math.cos(heading))
	return V(hp.X, gy, hp.Z) + F * dist
end

function skills.Roar()
	poseSet({crouch = 0.5, lean = -0.3, arm = -0.4}, 6)
	task.wait(0.5)
	setGlow("Anger")
	shakeFrom(headPos, 1.2, 2.4, 250)
	poseSet({lean = 0.3, head = 0.8, arm = 2.3, spread = 0.6}, 10)
	task.wait(2.2)
	poseSet({}, 4)
	task.wait(0.6)
end

function skills.Slam()
	poseSet({arm = 2.8, lean = 0.2, head = 0.4, crouch = 0.2}, 6)
	task.wait(0.8)
	poseSet({arm = -0.1, lean = -0.6, head = -0.2, crouch = 0.5}, 22)
	task.wait(0.18)
	local gp = groundFront(1.2 * L)
	shockwave(gp, 9 * L)
	shakeFrom(gp, 1.4, 0.9, 200)
	task.wait(0.2)
	poseSet({}, 3)
	task.wait(0.9)
end

function skills.Punch(pl)
	faceTarget = pl or targetPl
	poseSet({pArm = -1.1, pElbow = 1.1, twist = -0.55, lean = 0.15, crouch = 0.25}, 9) -- wind up
	task.wait(0.5)
	faceTarget = nil
	poseSet({pArm = 1.55, pElbow = -0.2, twist = 0.6, lean = -0.35, crouch = 0.15}, 26) -- strike
	dashT, dashSpd = 0.2, 7 * L
	task.wait(0.14)
	local gp = groundFront(2.2 * L)
	shockwave(gp, 3 * L)
	shakeFrom(gp, 0.9, 0.5, 150)
	task.wait(0.25)
	poseSet({}, 4)
	task.wait(0.8)
end

function skills.Disappear()
	if not hidden then
		poseSet({crouch = 1}, 6)
		task.wait(0.6)
		shockwave(groundFront(0), 5 * L)
		shakeFrom(V(hp.X, gy, hp.Z), 0.8, 0.6, 150)
		sinkTarget = 1
		task.wait(1.1)
		hidden = true
		targetPl = nil
	else
		hidden = false
		poseSet({crouch = 1}, 6)
		sinkTarget = 0
		task.wait(1.1)
		shockwave(groundFront(0), 7 * L)
		shakeFrom(V(hp.X, gy, hp.Z), 1.2, 0.8, 200)
		poseSet({lean = 0.2, head = 0.5, arm = 1.2, spread = 0.4}, 10)
		task.wait(0.8)
		poseSet({}, 4)
		task.wait(0.4)
	end
end

local function runSkill(name, pl)
	if not alive then notify("Spawn first", 2) return end
	if cutActive or busy then return end
	if act then notify("Busy: " .. act, 2) return end
	if hidden and name ~= "Disappear" then notify("Hidden - press Disappear to return", 3) return end
	act = name
	local ok, err = pcall(skills[name], pl)
	if not ok then warn("[NoseyBrick] " .. tostring(err)) end
	poseSet({}, 4)
	setGlow(baseGlow())
	faceTarget = nil
	act = nil
	punchCd = 0.5
end

