mini.Position = UDim2.new(1, -58, 0, 4)
mini.BackgroundColor3 = Color3.fromRGB(52, 52, 66)
mini.Text = "-"
mini.TextColor3 = Color3.new(1, 1, 1)
mini.Font = Enum.Font.GothamBold
mini.TextSize = 14
mini.BorderSizePixel = 0
mini.Parent = main
Instance.new("UICorner", mini).CornerRadius = UDim.new(0, 6)
local minimized = false
mini.MouseButton1Click:Connect(function()
	minimized = not minimized
	body.Visible = not minimized
	main.Size = minimized and UDim2.fromOffset(200, 32) or UDim2.fromOffset(200, GUI_H)
	mini.Text = minimized and "+" or "-"
end)

-- Dragging (kept on screen)
do
	local dragging, dragStart, startPos
	title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	table.insert(conns, UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			local vp = gui.AbsoluteSize
			local nx = math.clamp(startPos.X.Offset + d.X, 0, math.max(0, vp.X - main.AbsoluteSize.X))
			local ny = math.clamp(startPos.Y.Offset + d.Y, 0, math.max(0, vp.Y - 40))
			main.Position = UDim2.new(0, nx, 0, ny)
		end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end
