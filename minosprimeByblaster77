local function runIntro()
	cutActive, skipFlag, busy = true, false, true
	poseSet({kneel = 1, head = -0.9, lean = -0.1}, 6)
	for k in pairs(pose) do pose[k] = poseT[k] end
	repaint(0.12, 0)
	cam.CameraType = Enum.CameraType.Scriptable
	cineShow()
	task.spawn(function()
		local t0, stage = os.clock(), 0
		local H = 24 * UN
		while alive do
			RunService.RenderStepped:Wait()
			local t = os.clock() - t0
			if skipFlag or t >= 8.6 then break end
			if t >= 1.0 and stage < 1 then
				stage = 1
				burst(torsoPos, 34)
				ring(V(hp.X, gy, hp.Z), 18 * UN)
				shakeOn = true
				speech("Free at last.", 2.0)
			end
			if t >= 2.0 and stage < 2 then stage = 2; poseSet({kneel = 1, head = 0.15, lean = -0.05}, 2.2) end
			if t >= 3.4 and stage < 3 then stage = 3; shakeOn = false; poseSet({kneel = 0, head = 0.1}, 1.5) end
			if t >= 5.2 and stage < 4 then stage = 4; speech("O Gabriel...", 1.6) end
			if t >= 6.4 and stage < 5 then
				stage = 5
				poseSet({armLx = 0.6, armRx = 0.6, foreLx = 1.3, foreRx = 1.3, lean = 0.1, head = 0.2}, 8)
				speech("...thy punishment is DEATH.", 2.0)
				ring(V(hp.X, gy, hp.Z), 26 * UN)
				shakeFrom(headPos, 1.2, 0.8, 600 * UN)
			end
			if t >= 7.2 and stage < 6 then
				stage = 6
				titleLbl.Visible, subLbl.Visible = true, true
				fadeText(titleLbl, 0, 0.6)
				fadeText(subLbl, 0.2, 0.8)
			end
			if t < 1.8 then
				repaint((t < 1.0) and 0.12 or (0.12 + smooth((t - 1.0) / 0.8) * 0.88), 0)
			end
			local rc = CFrame.new(hp.X, gy, hp.Z) * CFrame.Angles(0, heading, 0)
			local pos, target, fov
			if t < 1.0 then
				pos = rc:PointToWorldSpace(V(0.9 * H, 0.35 * H, mix(-1.5, -1.35, t) * H))
				target, fov = torsoPos, 60
			elseif t < 3.4 then
				local k = smooth((t - 1.0) / 2.4)
				local a = mix(0.7, 0.0, k)
				local r = mix(1.3, 0.55, k) * H
				pos = rc:PointToWorldSpace(V(math.sin(a) * r, mix(0.35, 0.7, k) * H, -math.cos(a) * r))
				target, fov = headPos, mix(60, 35, k)
			elseif t < 5.6 then
				local k = smooth((t - 3.4) / 2.2)
				pos = rc:PointToWorldSpace(V(mix(0.45, 0.1, k) * H, 0.12 * H, -mix(0.5, 1.1, k) * H))
				target, fov = headPos, mix(55, 65, k)
			else
				local k = smooth((t - 5.6) / 3.0)
				pos = rc:PointToWorldSpace(V(0, 0.7 * H, -mix(1.1, 0.7, k) * H))
				target, fov = headPos, mix(50, 30, k)
			end
			local jitter = shakeOn and V(math.random() - 0.5, math.random() - 0.5, 0) * 0.015 * H or V()
			cam.CFrame = CFrame.lookAt(pos + jitter, target)
			cam.FieldOfView = fov
		end
		cutActive, busy, shakeOn = false, false, false
		poseSet({}, 3)
		repaint(1, 0)
