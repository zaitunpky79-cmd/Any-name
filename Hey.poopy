local function makeButton(text, x, y, w, h, cb)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w, h)
	b.Position = UDim2.fromOffset(x, y)
	b.BackgroundColor3 = Color3.fromRGB(52, 52, 66)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 13
	b.Text = text
	b.BorderSizePixel = 0
	b.Parent = body
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

local function makeLabel(text, x, y, w)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromOffset(w, 28)
	l.Position = UDim2.fromOffset(x, y)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.Gotham
	l.TextSize = 13
	l.Parent = body
	return l
end

-- hold-to-fly button
local function makeHoldButton(text, x, y, w, h, setHeld)
	local b = makeButton(text, x, y, w, h, function() end)
	b.MouseButton1Down:Connect(function() setHeld(true) end)
	b.MouseButton1Up:Connect(function() setHeld(false) end)
	b.MouseLeave:Connect(function() setHeld(false) end)
	return b
end

local buildBtn, autoBtn

----------------------------------------------------------------
-- Control mode: walking is frozen while you steer the UFO by hand
----------------------------------------------------------------
local function restoreHum()
	if savedHum and savedHum.hum and savedHum.hum.Parent then
		local h = savedHum.hum
		h.WalkSpeed = savedHum.WalkSpeed
		h.JumpPower = savedHum.JumpPower
		h.JumpHeight = savedHum.JumpHeight
	end
	savedHum = nil
end

local function freezeHum(hum)
	if savedHum and savedHum.hum == hum then return end
	restoreHum()
	savedHum = {
		hum = hum,
		WalkSpeed = hum.WalkSpeed,
		JumpPower = hum.JumpPower,
		JumpHeight = hum.JumpHeight,
	}
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.JumpHeight = 0
end

local lastSubject = nil
local function applyMode(hum)
	if S.auto then
		restoreHum()
	else
		freezeHum(hum)
	end
	-- camera: follow the UFO when flying by hand (unless you ride it)
	local want = hum
	if camPart and not S.auto and S.camUFO and not S.ride then want = camPart end
	if lastSubject ~= want then
		cam.CameraSubject = want
		lastSubject = want
	end
end

local function pickTarget(root, t)
	local ang = math.random() * TAU
	local rad = math.random(60, 240)
	autoTarget = V(
		root.Position.X + math.cos(ang) * rad,
		root.Position.Y + math.random(35, 130),
		root.Position.Z + math.sin(ang) * rad
	)
	autoUntil = t + 14
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local function step(dt)
	local root, hum = getRoot(), getHum()
	if not root or not hum then return end
	local t = tick()

	applyMode(hum)

	-- desired velocity: autopilot or your joystick / buttons
	local targetVel
	if S.auto then
		if not autoTarget or (autoTarget - pos).Magnitude < 15 or t > autoUntil then
			pickTarget(root, t)
		end
		local d = autoTarget - pos
		targetVel = (d.Magnitude > 1e-3 and d.Unit or V(0, 0, 0)) * (S.speed * 0.75)
	else
		local md = hum.MoveDirection
		local v = (S.upHeld and 1 or 0) - (S.downHeld and 1 or 0)
		targetVel = V(md.X, 0, md.Z) * S.speed + V(0, v * S.speed * 0.6, 0)
	end
	vel = vel:Lerp(targetVel, 1 - math.exp(-dt * 1.8))
	pos += vel * dt

	-- keep above the ground
	local ignore = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ignore, folder) end
	if skin then table.insert(ignore, skin.model) end
	rayParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(V(pos.X, pos.Y + 300, pos.Z), V(0, -2000, 0), rayParams)
	local groundY = hit and hit.Position.Y or nil
	if groundY then
		local minY = groundY + S.size * 1.4
		if pos.Y < minY then
			pos = V(pos.X, pos.Y + (minY - pos.Y) * math.min(1, dt * 6), pos.Z)
			vel = V(vel.X, math.max(vel.Y, 0), vel.Z)
		end
	end

	spin += dt * 0.9

	-- lean into the direction of travel, with a little hover wobble
	local hv = V(vel.X, 0, vel.Z)
	local tilt = CFrame.new()
	if hv.Magnitude > 1 then
		local axis = Vector3.yAxis:Cross(hv.Unit)
		tilt = CFrame.fromAxisAngle(axis, math.clamp(hv.Magnitude / S.speed, 0, 1.2) * math.rad(18))
	end
	local wob = CFrame.Angles(math.sin(t * 1.7) * 0.03, 0, math.cos(t * 1.3) * 0.03)
	local ufoCF = CFrame.new(pos + V(0, math.sin(t * 1.2) * 0.6, 0)) * tilt * wob
	local sz = S.size

	-- camera anchor
	if camPart then camPart.CFrame = CFrame.new(ufoCF.Position) end

	-- ride on top (optional)
	if S.ride then
		local seat = ufoCF:PointToWorldSpace(V(0, 2.7 * sz + 3, 0))
		root.CFrame = CFrame.new(seat) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	-- detailed skin
	if S.skin and skin then
		skin.hull:PivotTo(ufoCF)
		skin.lights:PivotTo(ufoCF * CFrame.Angles(0, -spin, 0))
		local n = #skin.rimLights
		for i, p in ipairs(skin.rimLights) do
			p.Color = Color3.fromHSV((t * 0.25 + i / n) % 1, 0.8, 1)
		end
		local beamLen = groundY and ((ufoCF.Position.Y - 0.95 * sz) - groundY) or 0
		if S.beam and beamLen > 2 then
			skin.beam.Transparency = 0.8
			skin.beam.Size = V(beamLen, 3.5 * sz, 3.5 * sz)
			skin.beam.CFrame = CFrame.new(ufoCF.Position - V(0, 0.95 * sz + beamLen / 2, 0))
				* CFrame.Angles(0, 0, math.pi / 2)
		else
			skin.beam.Transparency = 1
		end
	end

	-- toys form the saucer
	local rot = ufoCF.Rotation
	for _, c in ipairs(claimed) do
		if c.part.Parent then
			c.bp.Position = ufoCF:PointToWorldSpace(slotLocal(c.slot, spin) * sz)
			c.bg.CFrame = rot
		end
	end
end

----------------------------------------------------------------
-- Summon / release
----------------------------------------------------------------
local function release()
	S.active = false
	if heartbeat then heartbeat:Disconnect() heartbeat = nil end
	for _, c in ipairs(claimed) do
		if c.bp then c.bp:Destroy() end
		if c.bg then c.bg:Destroy() end
		if c.part and c.part.Parent then c.part.CanCollide = c.oldCollide end
	end
	claimed = {}
	destroySkin()
	restoreHum()
	local hum = getHum()
	if hum then cam.CameraSubject = hum end
	lastSubject = nil
	if camPart then camPart:Destroy() camPart = nil end
	if buildBtn then buildBtn.Text = "Summon UFO" end
	setStatus("released")
end

local function build()
	if S.busy or S.active then return end
	local root = getRoot()
	if not root then setStatus("no character") return end

	local parts = getToyParts()
	if #parts == 0 then setStatus("no toys found") return end

	S.busy = true
	setStatus("claiming toys...")
	local origin = root.CFrame
	local teleported = false

	for i = 1, math.min(#slots, #parts) do
		local part = parts[i]
		if part.Parent then
			-- only move if the toy is out of grab range
			if (part.Position - root.Position).Magnitude > 30 then
				root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
				teleported = true
				task.wait(0.08)
			end
			if claim(part) then
				local bp = Instance.new("BodyPosition")
				bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
				bp.P = 25000
				bp.D = 1200
				bp.Position = part.Position
				bp.Parent = part

				local bg = Instance.new("BodyGyro")
				bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
				bg.P = 25000
				bg.CFrame = part.CFrame
				bg.Parent = part

				local oldCollide = part.CanCollide
				part.CanCollide = false

				table.insert(claimed, {
					part = part, bp = bp, bg = bg,
					slot = slots[#claimed + 1], oldCollide = oldCollide,
				})
			end
		end
	end
	if teleported then root.CFrame = origin end

	if #claimed == 0 then
		S.busy = false
		setStatus("no toys claimed")
		return
	end

	-- take off ahead of you, up in the air
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 1e-3 and flat.Unit or V(0, 0, -1)
	pos = root.Position + flat * 50 + V(0, 35, 0)
	vel = Vector3.zero
	autoTarget = nil

	camPart = Instance.new("Part")
	camPart.Name = "UFOCam"
	camPart.Anchored = true
	camPart.CanCollide = false
	camPart.CanQuery = false
	camPart.CanTouch = false
	camPart.Transparency = 1
	camPart.Size = V(1, 1, 1)
	camPart.CFrame = CFrame.new(pos)
	camPart.Parent = workspace

	if S.skin then buildSkin() end

	S.active = true
	buildBtn.Text = "Dismiss UFO"
	setStatus(("flying (%d toys)"):format(#claimed))
	heartbeat = RunService.Heartbeat:Connect(step)
	S.busy = false
end

----------------------------------------------------------------
-- Controls
----------------------------------------------------------------
buildBtn = makeButton("Summon UFO", 10, 24, 180, 30, function()
	if S.active then release() else task.spawn(build) end
end)

autoBtn = makeButton("Autopilot: OFF", 10, 60, 180, 30, function(b)
	S.auto = not S.auto
	b.Text = "Autopilot: " .. (S.auto and "ON" or "OFF")
	b.BackgroundColor3 = S.auto and Color3.fromRGB(70, 110, 200) or Color3.fromRGB(52, 52, 66)
	autoTarget = nil
	if S.active then setStatus(S.auto and "autopilot" or "manual flight") end
end)

makeHoldButton("▲ Up", 10, 96, 86, 30, function(h) S.upHeld = h end)
makeHoldButton("▼ Down", 104, 96, 86, 30, function(h) S.downHeld = h end)

local speedLabel = makeLabel("Speed: 60", 10, 132, 90)
makeButton("-", 104, 132, 40, 28, function()
	S.speed = math.max(20, S.speed - 10)
	speedLabel.Text = "Speed: " .. S.speed
end)
makeButton("+", 150, 132, 40, 28, function()
	S.speed = math.min(250, S.speed + 10)
	speedLabel.Text = "Speed: " .. S.speed
end)

local sizeLabel = makeLabel("Size: 6", 10, 164, 90)
local function changeSize(delta)
	S.size = math.clamp(S.size + delta, 3, 12)
	sizeLabel.Text = "Size: " .. S.size
	if S.active and S.skin then buildSkin() end -- rebuilt at the new size
end
makeButton("-", 104, 164, 40, 28, function() changeSize(-1) end)
makeButton("+", 150, 164, 40, 28, function() changeSize(1) end)

makeButton("Beam: ON", 10, 196, 86, 28, function(b)
	S.beam = not S.beam
	b.Text = "Beam: " .. (S.beam and "ON" or "OFF")
end)
makeButton("Ride: OFF", 104, 196, 86, 28, function(b)
	S.ride = not S.ride
	b.Text = "Ride: " .. (S.ride and "ON" or "OFF")
end)
makeButton("Skin: ON", 10, 228, 86, 28, function(b)
	S.skin = not S.skin
	b.Text = "Skin: " .. (S.skin and "ON" or "OFF")
	if S.active then
		if S.skin then buildSkin() else destroySkin() end
	end
end)
makeButton("Cam: UFO", 104, 228, 86, 28, function(b)
	S.camUFO = not S.camUFO
	b.Text = "Cam: " .. (S.camUFO and "UFO" or "Me")
end)

-- PC keys: Space = up, Shift = down
table.insert(conns, UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.Space then S.upHeld = true
	elseif input.KeyCode == Enum.KeyCode.LeftShift then S.downHeld = true end
end))
table.insert(conns, UIS.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Space then S.upHeld = false
	elseif input.KeyCode == Enum.KeyCode.LeftShift then S.downHeld = false end
end))

-- Close / unload
local function unload()
	S.dead = true
	release()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	if gui then gui:Destroy() end
	env.FTAPUfoUnload = nil
end
env.FTAPUfoUnload = unload

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(24, 24)
close.Position = UDim2.new(1, -30, 0, 4)
close.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.Font = Enum.Font.GothamBold
close.TextSize = 12
close.BorderSizePixel = 0
close.Parent = main
Instance.new("UICorner", close).CornerRadius = UDim.new(0, 6)
close.MouseButton1Click:Connect(unload)

