-- layout: every body part is a block of whole bricks -----------------------------------------------
local function layout(cxx, czz, LL)
	local b, o, p = {}, {}, {}
	local function bone(n, par, pv) b[n] = {parent = par, pv = pv}; o[#o + 1] = n end
	local function part(bn, c, nx, nz, ny, kind) p[#p + 1] = {bone = bn, c = c, nx = nx, nz = nz, ny = ny, kind = kind} end
	bone("Root", nil, V(0, 2 * LL, 0))
	bone("Torso", "Root", V(0, 2 * LL, 0))
	bone("Head", "Torso", V(0, 4 * LL, 0))
	part("Torso", V(0, 3 * LL, 0), 4, 2, 2, "torso")
	part("Head", V(0, 4.5 * LL, 0), 3, 2, 1, "head")
	for _, s in ipairs({-1, 1}) do
		local d = s < 0 and "L" or "R"
		bone("Ant" .. d, "Head", V(s * cxx, 5 * LL, 0))
		bone("Arm" .. d, "Torso", V(s * 2.5 * cxx, 4 * LL, 0))
		bone("Fore" .. d, "Arm" .. d, V(s * 2.5 * cxx, 3 * LL, 0))
		bone("Thigh" .. d, "Root", V(s * cxx, 2 * LL, 0))
		bone("Shin" .. d, "Thigh" .. d, V(s * cxx, LL, 0))
		part("Ant" .. d, V(s * cxx, 5.5 * LL, 0), 1, 1, 1, "ant")
		part("Arm" .. d, V(s * 2.5 * cxx, 3.5 * LL, 0), 1, 1, 1, "arm")
		part("Fore" .. d, V(s * 2.5 * cxx, 2.5 * LL, 0), 1, 1, 1, "fore")
		part("Thigh" .. d, V(s * cxx, 1.5 * LL, 0), 2, 2, 1, "thigh")
		part("Shin" .. d, V(s * cxx, 0.5 * LL, 0), 2, 2, 1, "shin")
	end
	return b, o, p
end
local NEED = 0
do
	local _, _, p = layout(1, 1, 3)
	for _, pt in ipairs(p) do NEED += pt.nx * pt.nz * pt.ny end
end

local function slotStyle(kind, i, k, j, nx, ny)
	if kind == "torso" then
		if k == 1 and (i == 2 or i == 3) then return BIB, false end
		if j == ny and (i == 1 or i == nx) then return MID, false end
		return DARK, false
	elseif kind == "head" then
		if k == 1 then
			if i == 2 then return MID, false end
			return DARK, true -- eyes
		end
		return DARK, false
	elseif kind == "ant" then return RUST, true
	elseif kind == "arm" or kind == "thigh" then return DARK, false end
	return MID, false
end

-- owner / brick detection ---------------------------------------------------------------------------
local function ownerState(p)
	local function match(v)
		if v == nil then return nil end
		if typeof(v) == "Instance" then v = v.Name end
		if type(v) == "number" then return v == lp.UserId end
		v = tostring(v):lower()
		return v == lp.Name:lower() or v == lp.DisplayName:lower() or v == tostring(lp.UserId)
	end
	local inst = p
	for _ = 1, 4 do
		if not inst or inst == workspace then break end
		for _, nm in ipairs({"Owner", "owner", "Creator", "creator", "Player", "Builder"}) do
			local a = inst:GetAttribute(nm)
			if a ~= nil then return match(a) end
			local c = inst:FindFirstChild(nm)
			if c and c:IsA("ValueBase") then return match(c.Value) end
		end
		local pl = Players:FindFirstChild(inst.Name)
		if pl and pl:IsA("Player") then return pl == lp end
		inst = inst.Parent
	end
	return nil
end
local function usable(p)
	if not p or not p.Parent or p:IsDescendantOf(char) then return false end
	if p.Anchored then return false end
	local okJ, joints = pcall(function() return p:GetJoints() end)
	if okJ and #joints > 0 then return false end
	if ownerState(p) == false then return false end
	if isnetworkowner then
		local okO, own = pcall(isnetworkowner, p)
		if okO and not own then return false end
	end
	return true
end
-- returns sorted list of the most suitable brick type, its dims {short, mid, long}, and how many exist
local function gather()
	local root = workspace:FindFirstChild("Bricks")
	if not root then return nil, "workspace.Bricks not found" end
	local groups, base = {}, hrp.Position
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and usable(d) then
			local s = d.Size
			local a = {s.X, s.Y, s.Z}
			table.sort(a)
			local key = string.format("%.2f,%.2f,%.2f", a[1], a[2], a[3])
			local g = groups[key]
			if not g then g = {dims = a, list = {}}; groups[key] = g end
			g.list[#g.list + 1] = {d, (d.Position - base).Magnitude, ownerState(d) == true and 0 or 1}
		end
	end
	local best, bestScore
	for _, g in pairs(groups) do
		local score = #g.list
		if math.abs(g.dims[3] - WANT_LONG) < 0.3 then score += 1e6 end
		if not bestScore or score > bestScore then best, bestScore = g, score end
	end
	if not best then return nil, "no free bricks found" end
	table.sort(best.list, function(x, y)
		if x[3] ~= y[3] then return x[3] < y[3] end
		return x[2] < y[2]
	end)
	return best.list, best.dims
end
-- slot axes: shortest brick axis -> rig X, middle -> rig Z, longest -> rig Y
local function orientFor(p)
	local s = p.Size
	local sz = {s.X, s.Y, s.Z}
	local idx = {1, 2, 3}
	table.sort(idx, function(a, b) return sz[a] < sz[b] end)
	local ax = {}
	ax[idx[1]], ax[idx[2]], ax[idx[3]] = V(1, 0, 0), V(0, 0, 1), V(0, 1, 0)
	return CFrame.fromMatrix(V(), ax[1], ax[2])
end

local function groundAt(p, h)
	local res = workspace:Raycast(p + V(0, h, 0), V(0, -(h + 3000), 0), groundP)
	return res and res.Position.Y or p.Y
end
local function refreshFilters()
