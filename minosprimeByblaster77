local COST = {Judgement = 2, ThyEnd = 2, Prepare = 3, Die = 1, Crush = 1, Uppercut = 1, Overhead = 1}

local function runSkill(name)
	if not alive then notify("Spawn first", 2) return end
	if cutActive or busy then return end
	if act then notify("Busy: " .. act, 2) return end
	act = name
	local ok, err = pcall(skills[name])
	if not ok then warn("[MinosPrime] " .. tostring(err)) end
	poseSet({}, 5)
	faceTarget = nil
	liftY = liftY -- smoothed back to the ground in step
	act = nil
	skillCd = math.max(skillCd, 0.4)
end

-- phase handling + stamina AI -----------------------------------------------------------------------------------------------------
local function setPhase(n)
	if not alive or cutActive then notify("Spawn first", 3) return end
	phase = n
	maxStam = (n == 1) and 6 or 12
	stam = maxStam
	if n == 2 then
		shout("WEAK.", Color3.fromRGB(150, 210, 255))
		shakeFrom(headPos, 1.4, 1.0, 400 * UN)
		ring(V(hp.X, gy, hp.Z), 20 * UN, Color3.fromRGB(110, 180, 255))
		repaint(1, 1)
		setFlames(true)
	else
		repaint(1, 0)
		setFlames(false)
	end
	notify("Phase " .. n, 3)
end

local function startAI()
	if aiRun then return end
	aiRun = true
	task.spawn(function()
		while alive and targetPl and aiRun do
			task.wait(0.1)
			if act or busy or cutActive or control then continue end
			if not targetHrp(targetPl) then break end
			local names = {}
			for n, c in pairs(COST) do
				if stam >= c then names[#names + 1] = n end
			end
			if #names == 0 then
				notify("Out of stamina - recovering", 2)
				task.wait((phase == 1) and 2 or 1)
				stam = maxStam
			else
				local pick = names[math.random(#names)]
				stam -= COST[pick]
				runSkill(pick)
				if math.random() < ((phase == 2) and 0.5 or 0.25) and targetPl then runSkill("Snake") end
				task.wait((phase == 1) and 0.6 or 0.25)
			end
		end
		aiRun = false
	end)
end

