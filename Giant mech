local function updateDebris(dt)
	for i = #debrisList, 1, -1 do
		local d = debrisList[i]
		d.life -= dt
		if d.life <= 0 or not d.p.Parent then
			if d.p then d.p:Destroy() end
			table.remove(debrisList, i)
		else
			d.v += V(0, -workspace.Gravity * 0.7 * dt, 0)
			local cf = d.p.CFrame
			local np = cf.Position + d.v * dt
			if np.Y < d.gy then np = V(np.X, d.gy, np.Z); d.v = V(d.v.X * 0.6, math.abs(d.v.Y) * 0.25, d.v.Z * 0.6) end
			d.p.CFrame = CFrame.new(np) * cf.Rotation * CFrame.Angles(d.av.X * dt, d.av.Y * dt, d.av.Z * dt)
		end
	end
end

