local function buildCarSkin(sz)
	local g = newModel(nil, "Car")
	local m = { group = g, wheels = {} }
	local function b(x, y, z, w, h, d, color, mat, tr, rot)
		return mk(g, nil, V(w, h, d) * sz, CFrame.new(x * sz, y * sz, z * sz) * (rot or CFrame.new()), color, mat or Enum.Material.Metal, tr)
	end
	local DARKG = Color3.fromRGB(35, 40, 52)
	local GLASS = Color3.fromRGB(110, 190, 220)
	b(0, 0.95, 0, 4.2, 0.8, 9.0, REDC)
	b(0, 1.5, -2.9, 3.9, 0.45, 3.1, REDC)
	b(0, 2.1, 0.5, 3.6, 1.15, 3.3, REDC)
