----------------------------------------------------------------
-- Math helpers
----------------------------------------------------------------
local function lerp(a, b, t) return a + (b - a) * t end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function track(p, keys)
	if p <= keys[1][1] then return keys[1][2] end
	for i = 2, #keys do
		if p <= keys[i][1] then
			local a, b = keys[i - 1], keys[i]
			local k = smooth((p - a[1]) / (b[1] - a[1]))
			if typeof(a[2]) == "Vector3" then return a[2]:Lerp(b[2], k) end
			return a[2] + (b[2] - a[2]) * k
		end
	end
	return keys[#keys][2]
end

local function moveProfile(p, a0, b0, D, dur)
	if p <= a0 or p >= b0 then return 0 end
	local x = (p - a0) / (b0 - a0)
	return D * 6 * x * (1 - x) / ((b0 - a0) * dur)
end

local function ik(s, w, pole, L)
	local d = w - s
	local dist = d.Magnitude
	if dist < 1e-3 then return s end
	local dir = d / dist
	local mid = (s + w) / 2
	local h = 0
	if dist < 2 * L then h = math.sqrt(L * L - (dist / 2) ^ 2) end
	local perp = pole - dir * pole:Dot(dir)
	if perp.Magnitude < 1e-3 then return mid end
	return mid + perp.Unit * h
end

local function clampReach(sh, target, maxLen)
	local d = target - sh
	local m = d.Magnitude
	if m > maxLen then return sh + d / m * maxLen end
	return target
end

-- Rotation for a toy: its LONG axis along `dir` and its THIN (flat) axis along
-- `nrm`. c.aL / c.aM / c.aT = the toy's longest / middle / thinnest axis (1 X, 2 Y, 3 Z).
local function orient(c, dir, nrm)
	local d = dir.Magnitude > 1e-4 and dir.Unit or V(0, 1, 0)
	local n = nrm - d * nrm:Dot(d)
	if n.Magnitude < 1e-3 then
		n = (math.abs(d.Y) < 0.9) and V(0, 1, 0) or V(1, 0, 0)
		n = n - d * n:Dot(d)
	end
	n = n.Unit
	local m = (((c.aT - c.aL) % 3) == 1) and d:Cross(n) or n:Cross(d)
	local vecs = {}
	vecs[c.aL], vecs[c.aT], vecs[c.aM] = d, n, m
	return CFrame.fromMatrix(Vector3.zero, vecs[1], vecs[2], vecs[3])
end

