local WHITE = Color3.fromRGB(215, 220, 230)
local REDC = Color3.fromRGB(205, 45, 45)
local JOINT = Color3.fromRGB(55, 60, 72)
local NEON = Color3.fromRGB(80, 230, 255)

local function mk(parent, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

local function newModel(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	local root = mk(m, nil, V(0.2, 0.2, 0.2), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic, 1)
	m.PrimaryPart = root
	m.Parent = parent
	return m
end

local function bx(parent, color, mat, tr) return mk(parent, nil, V(1, 1, 1), CFrame.new(), color, mat or Enum.Material.Metal, tr) end
local function cl(parent, color, mat) return mk(parent, Enum.PartType.Cylinder, V(1, 1, 1), CFrame.new(), color, mat or Enum.Material.Metal) end
local function bl(parent, color, mat) return mk(parent, Enum.PartType.Ball, V(1, 1, 1), CFrame.new(), color, mat or Enum.Material.Metal) end

local function placeCyl(part, a, b, dia)
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		part.Size = V(0.05, dia, dia)
		part.CFrame = CFrame.new(a)
		return
	end
	local dir = d / len
	local up = math.abs(dir.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	part.Size = V(len, dia, dia)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
end

local function placeBar(part, a, b, w, dd, hint)
	local diff = b - a
	local len = diff.Magnitude
	if len < 1e-3 then
		part.Size = V(w, dd, 0.05)
		part.CFrame = CFrame.new(a)
		return
	end
	local dir = diff / len
	local h = hint or V(0, 1, 0)
	if math.abs(dir:Dot(h.Unit)) > 0.95 then h = V(1, 0, 0) end
	part.Size = V(w, dd, len)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, h)
end

local function setBall(part, p, d)
	part.Size = V(d, d, d)
	part.CFrame = CFrame.new(p)
end

local function destroySkin()
	if skin then
		skin.model:Destroy()
		for _, k in ipairs({ "mech", "car", "jet" }) do
			if skin[k] then skin[k].group:Destroy() end
		end
		skin = nil
	end
	for _, f in ipairs(fxList) do
		if f.part then f.part:Destroy() end
	end
	fxList = {}
end

local function newEmitter(parent, fire, sz)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.EmissionDirection = Enum.NormalId.Back
	e.Rotation = NumberRange.new(0, 360)
	if fire then
		e.Lifetime = NumberRange.new(0.2, 0.4)
		e.Speed = NumberRange.new(6 * sz, 10 * sz)
		e.SpreadAngle = Vector2.new(5, 5)
		e.Color = ColorSequence.new(Color3.fromRGB(190, 230, 255), Color3.fromRGB(255, 110, 40))
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 * sz), NumberSequenceKeypoint.new(1, 0.1 * sz) })
		e.Transparency = NumberSequence.new(0.1, 1)
		e.LightEmission = 1
	else
		e.Lifetime = NumberRange.new(0.6, 1.2)
		e.Speed = NumberRange.new(1 * sz, 2 * sz)
