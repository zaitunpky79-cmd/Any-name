local function findPlayer(txt)
	txt = string.lower(txt or ""):match("^%s*(.-)%s*$")
	if txt == "" then return nil end
	local partial
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= lp then
			local n, d = pl.Name:lower(), pl.DisplayName:lower()
			if n == txt or d == txt then return pl end
			if not partial and (n:sub(1, #txt) == txt or d:sub(1, #txt) == txt) then partial = pl end
		end
	end
	return partial
end
local function getMove()
	local mv
	if controls then
		local ok, v = pcall(function() return controls:GetMoveVector() end)
		if ok then mv = v end
	end
	if mv then
		local w = cam.CFrame:VectorToWorldSpace(V(mv.X, 0, mv.Z))
		w = V(w.X, 0, w.Z)
		if w.Magnitude > 0.01 then return w.Unit * math.min(1, mv.Magnitude) end
		return V()
	end
	local d = hum.MoveDirection
	return V(d.X, 0, d.Z)
end
local function groundFront(dist)
	local F = V(-math.sin(heading), 0, -math.cos(heading))
	return V(hp.X, gy, hp.Z) + F * dist
end
local function aimPoint()
	local th = targetPl and targetHrp(targetPl)
	if th then return th.Position + V(0, 2, 0) end
	local p = groundFront(geo.height * 2.4)
	return V(p.X, groundAt(V(p.X, gy + geo.height, p.Z), geo.height + 200) + 0.5, p.Z)
end

-- ammo (10 bricks) + laser --------------------------------------------------------------------------------
local function bez3(p0, p1, p2, p3, u)
	local v = 1 - u
	return p0 * (v * v * v) + p1 * (3 * v * v * u) + p2 * (3 * v * u * u) + p3 * (u * u * u)
end
local function dirCF(dir)
	local up = (math.abs(dir.Y) > 0.98) and V(0, 0, 1) or V(0, 1, 0)
	return CFrame.lookAt(V(), dir, up) * CFrame.Angles(-math.pi / 2, 0, 0)
end
local function initAmmo()
	A = {}
	for i = 1, 10 do A[i] = {mode = "rack", t = 0} end
end
local function ammoReady()
	local n = 0
	for i = 1, 10 do if A[i] and A[i].mode == "rack" then n += 1 end end
	return n
end
local function reloadAmmo()
	local n = 0
	for i = 1, 10 do
		local st = A[i]
		if st and st.mode == "spent" then
			st.mode, st.t, st.dur, st.p0 = "ret", -(n * 0.09), 0.9, st.cf.Position
			n += 1
		end
	end
	if n == 0 then notify("Ammo full", 2) else notify("Reloading...", 2) end
end
local function fireShot()
	if not alive or cutActive or busy then return end
	if os.clock() < shotCd then return end
	if laser then return end
	local idx
	for i = 1, 10 do if A[i].mode == "rack" then idx = i; break end end
	if not idx then notify("Out of ammo - Reload [T]", 2) return end
	shotCd = os.clock() + 0.16
	local s = ammoSlots[idx]
	local H = geo.height
	local p0 = (s.rigCF or s.cf or CFrame.new(hp)).Position
	local target = aimPoint()
	local dist = (target - p0).Magnitude
	local st = A[idx]
	local side = V(math.cos(heading), 0, -math.sin(heading))
	st.mode, st.t = "fly", 0
	st.dur = clamp(dist / (H * 9) + 0.6, 0.8, 2.8)
	st.p0 = p0
	st.p1 = p0 + V(0, H * (0.8 + math.random() * 0.3), 0) + side * (math.random() - 0.5) * H * 0.6
	st.p2 = target + V(0, H * 0.7, 0) + side * (math.random() - 0.5) * H * 0.3
	st.p3 = target
	recoil = 1
	boom(p0, H * 0.06, Color3.fromRGB(255, 200, 120))
	dust(p0, 6, H * 0.05)
	shakeFrom(p0, 0.25, 0.2, H * 6)
end

