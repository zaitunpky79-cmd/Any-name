		if pl.Character then f[#f + 1] = pl.Character end
	end
	groundP.FilterDescendantsInstances = f
end

-- glow (local color) --------------------------------------------------------------------------------
local function setGlow(mode)
	glowMode = mode
	for _, s in ipairs(slots) do
		if s.glow and s.p.Parent then
			pcall(function()
				s.p.Color = GLOW[mode]
				s.p.Material = (mode == "Offline") and Enum.Material.SmoothPlastic or Enum.Material.Neon
			end)
		end
	end
end
local function baseGlow()
	if hidden then return "Offline" end
	if targetPl then return "Anger" end
	return "Online"
end

-- avatar rides inside the body so the bricks stay yours ------------------------------------------------
local function carryAvatar(on)
	if on then
		pcall(function() hrp.Anchored = false end)
		pcall(function() hum.PlatformStand = true end)
		avatarSaved = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then avatarSaved[d] = d.CanCollide; d.CanCollide = false end
		end
		pcall(function()
			local old = hrp:FindFirstChild("NoseyAvatarAntiG")
			if old then old:Destroy() end
			local bf = Instance.new("BodyForce")
			bf.Name = "NoseyAvatarAntiG"
			bf.Force = V(0, hrp.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = hrp
		end)
	else
		pcall(function() local bf = hrp:FindFirstChild("NoseyAvatarAntiG"); if bf then bf:Destroy() end end)
		for d, c in pairs(avatarSaved) do pcall(function() d.CanCollide = c end) end
		avatarSaved = {}
		pcall(function() hum.PlatformStand = false end)
		pcall(function() hrp.AssemblyLinearVelocity = V() end)
	end
end
local function setRide(on)
	if on == ride then return end
	ride = on
	carryAvatar(on)
	if on then
		cam.CameraSubject = camPart
		lp.CameraMaxZoomDistance = 3000
		lp.CameraMinZoomDistance = clamp(5 * L, 12, 2900)
	else
		pcall(function() hrp.CFrame = CFrame.new(hp.X, gy + 8, hp.Z) end)
		avatarCF = nil
		cam.CameraSubject = hum
		lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance = oldZoomMax, oldZoomMin
	end
end

-- camera shake + local effects ----------------------------------------------------------------------
RunService:BindToRenderStep("NoseyShake", Enum.RenderPriority.Camera.Value + 1, function()
	local left = shakeEnd - os.clock()
	if left > 0 and not cutActive then
		local a = shakeAmp * math.min(1, left)
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0)
			* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)
	end
end)
local function shakeFrom(pos, power, secs, range)
	local k = clamp(1 - (cam.CFrame.Position - pos).Magnitude / range, 0, 1)
	if k > 0 then shakeAmp, shakeEnd = power * k, os.clock() + secs end
end
local function shockwave(pos, radius)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 120, 60)
	p.Transparency = 0.35
	p.Size = V(0.4, 2, 2)
	p.CFrame = CFrame.new(pos + V(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = V(0.4, radius * 2, radius * 2), Transparency = 1}):Play()
	game:GetService("Debris"):AddItem(p, 0.9)
end

