----------------------------------------------------------------
-- Math helpers
----------------------------------------------------------------
local function lerp(a, b, t) return a + (b - a) * t end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function ik(s, w, pole, L)
	local d = w - s
	local dist = d.Magnitude
	if dist < 1e-3 then return s end
	local dir = d / dist
	local mid = (s + w) / 2
	local h = 0
	if dist < 2 * L then h = math.sqrt(L * L - (dist / 2) ^ 2) end
	local perp = pole - dir * pole:Dot(dir)
	if perp.Magnitude < 1e-3 then return mid end
	return mid + perp.Unit * h
end

-- rotation whose local axis (1 = X, 2 = Y, 3 = Z) points along dir
local function basisFor(dir, hint, axis)
	if dir.Magnitude < 1e-4 then dir = V(0, 1, 0) end
	local d = dir.Unit
	local h = hint
	if h.Magnitude < 1e-4 or math.abs(d:Dot(h.Unit)) > 0.95 then
		h = (math.abs(d.X) < 0.9) and V(1, 0, 0) or V(0, 0, 1)
	end
	local a = h:Cross(d).Unit
	if axis == 1 then
		return CFrame.fromMatrix(Vector3.zero, d, a, d:Cross(a))
	elseif axis == 2 then
		return CFrame.fromMatrix(Vector3.zero, a, d, a:Cross(d))
	else
		return CFrame.fromMatrix(Vector3.zero, a, d:Cross(a), d)
	end
end

-- direction from yaw + pitch-up (forward = -Z)
local function dirYP(yw, pt)
	return V(-math.cos(pt) * math.sin(yw), math.sin(pt), -math.cos(pt) * math.cos(yw))
end

-- direction pointing backwards (+Z) with a yaw and a downward pitch
local function dirBack(yw, down)
	return V(math.cos(down) * math.sin(yw), -math.sin(down), math.cos(down) * math.cos(yw))
end

local function rotZ(v, a)
	return V(v.X * math.cos(a) - v.Y * math.sin(a), v.X * math.sin(a) + v.Y * math.cos(a), v.Z)
end

