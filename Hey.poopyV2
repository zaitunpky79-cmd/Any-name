local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

-- Re-run safe. The other toy scripts use the same toys, so unload them too.
local env = (getgenv and getgenv()) or _G
if env.FTAPUfoUnload then pcall(env.FTAPUfoUnload) end
for _, k in ipairs({
	"FTAPSusanooForm1Unload", "FTAPSusanooHalfUnload", "FTAPSusanooUnload",
	"FTAPHandUnload", "FTAPSnakeUnload",
}) do
	if env[k] then pcall(env[k]) end
end

local MAX_TOYS = 20
local TAU = math.pi * 2
local V = Vector3.new
local TURN_RATE = 1.3 -- plane turn speed (rad/s)

----------------------------------------------------------------
-- State
----------------------------------------------------------------
local S = {
	active = false,
	busy = false,
	dead = false,
	mode = "ufo", -- ufo | plane
	auto = false, -- autopilot
	safe = true, -- indestructible protections
	ride = false, -- carry you on top (off = you stay on the ground)
	skin = true, -- detailed local model
	beam = true, -- tractor beam (UFO)
	camUFO = true, -- camera follows the craft while you fly by hand
	chase = false,
	size = 6, -- studs per unit
	speed = 60,
	upHeld = false,
	downHeld = false,
}
local claimed = {} -- { part, bp, bg, si, oldCollide }
local claimedSet = {}
local heartbeat
local conns = {}
local skin = nil
local camPart = nil
local savedHum = nil
local lastSubject = nil

-- flight state
local pos = Vector3.zero
local vel = Vector3.zero
local spin = 0
local prop = 0
local morph = 0 -- 0 = UFO, 1 = plane
local fwd = V(0, 0, -1) -- plane heading (flat)
local pitch = 0
local bank = 0
local autoTarget = nil
local autoUntil = 0
local safeTimer, refillTimer, reclaimIdx = 0, 0, 0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getRoot()
	local char = lp.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local char = lp.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

----------------------------------------------------------------
-- Toy layouts: slot i has a UFO position and a PLANE position
-- (priority order: with fewer than 20 toys you keep the core of both)
----------------------------------------------------------------
local U = { { k = "apex" }, { k = "bottom" } }
for i = 1, 10 do table.insert(U, { k = "rim", i = i }) end
for i = 1, 5 do table.insert(U, { k = "inner", i = i }) end
for i = 1, 3 do table.insert(U, { k = "dome", i = i }) end

local PL = {
	{ k = "fus", z = 0 }, { k = "fus", z = -1.2 }, { k = "fus", z = 1.2 },
	{ k = "fus", z = -2.4 }, { k = "fus", z = 2.4 },
	{ k = "fus", z = -3.6 }, { k = "fus", z = 3.6 },
	{ k = "wing", x = 1.2 }, { k = "wing", x = -1.2 },
	{ k = "wing", x = 2.4 }, { k = "wing", x = -2.4 },
	{ k = "wing", x = 3.6 }, { k = "wing", x = -3.6 },
	{ k = "wing", x = 4.8 }, { k = "wing", x = -4.8 },
	{ k = "tailV", y = 0.9 }, { k = "tailV", y = 1.8 },
	{ k = "stab", x = 1.4 }, { k = "stab", x = -1.4 },
	{ k = "prop" },
}

local function ufoLocal(s, sp)
	local k = s.k
	if k == "apex" then
		return V(0, 1.9, 0)
	elseif k == "bottom" then
		return V(0, -1.0, 0)
	elseif k == "rim" then
		local a = sp + (s.i - 1) * TAU / 10
		return V(math.cos(a) * 4, 0, math.sin(a) * 4)
	elseif k == "inner" then
		local a = -sp * 0.6 + (s.i - 1) * TAU / 5
		return V(math.cos(a) * 2.3, 0.4, math.sin(a) * 2.3)
	else
		local a = sp * 1.5 + (s.i - 1) * TAU / 3
		return V(math.cos(a) * 0.9, 1.1, math.sin(a) * 0.9)
	end
end

-- plane: nose = -z, wings along x
local function planeLocal(s, pr)
	local k = s.k
	if k == "fus" then
		return V(0, 0, s.z)
	elseif k == "wing" then
		return V(s.x, 0, -0.2 + math.abs(s.x) * 0.18) -- swept back
	elseif k == "tailV" then
		return V(0, s.y, 3.4 + s.y * 0.15)
	elseif k == "stab" then
		return V(s.x, 0.2, 3.7)
	else
		return V(math.cos(pr) * 0.9, math.sin(pr) * 0.9, -4.8) -- propeller
	end
end

----------------------------------------------------------------
-- Toys
----------------------------------------------------------------
local function getToyFolder()
	return workspace:FindFirstChild(lp.Name .. "SpawnedInToys")
		or workspace:FindFirstChild("Ketik_Ketikketik4SpawnedInToys")
end

local function getToyParts()
	local parts = {}
	local folder = getToyFolder()
	if not folder then return parts end
	for _, toy in ipairs(folder:GetChildren()) do
		local sp = toy:FindFirstChild("SoundPart")
		if sp and sp:IsA("BasePart") then
			table.insert(parts, sp)
			if #parts >= MAX_TOYS then break end
		end
	end
	return parts
end

local function claim(part)
	-- The remote name/arguments may change when the game updates.
	return pcall(function()
		RS.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
	end)
end

-- does this client still own the part? (executor helper; unknown = false)
local function ownsPart(part)
	if isnetworkowner then
		local ok, r = pcall(isnetworkowner, part)
		if ok then return r end
	end
	return false
end

local function makeMovers(c)
	local part = c.part
	if not (c.bp and c.bp.Parent == part) then
		local bp = Instance.new("BodyPosition")
		bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bp.P = 25000
		bp.D = 1200
		bp.Position = part.Position
		bp.Parent = part
		c.bp = bp
	end
	if not (c.bg and c.bg.Parent == part) then
		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bg.P = 25000
		bg.CFrame = part.CFrame
		bg.Parent = part
		c.bg = bg
	end
end

local function addToy(part, si)
	local c = { part = part, si = si, oldCollide = part.CanCollide }
	part.CanCollide = false
	makeMovers(c)
	table.insert(claimed, c)
	claimedSet[part] = c
	return c
end

-- drop destroyed toys and pick up new ones to fill the free slots
local function refill()
	for i = #claimed, 1, -1 do
		local c = claimed[i]
		if not c.part.Parent then
			claimedSet[c.part] = nil
			table.remove(claimed, i)
		end
	end
	if #claimed >= #U then return end
	local used = {}
	for _, c in ipairs(claimed) do used[c.si] = true end
	for _, part in ipairs(getToyParts()) do
		if not claimedSet[part] then
			local si
			for i = 1, #U do
				if not used[i] then si = i break end
			end
			if not si then break end
			if claim(part) then
				used[si] = true
				addToy(part, si)
			end
		end
	end
end

----------------------------------------------------------------
-- SKIN: detailed models (client-side parts, only you see them)
----------------------------------------------------------------
local function mk(parent, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

local function newModel(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	local root = mk(m, nil, V(0.2, 0.2, 0.2), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic, 1)
	m.PrimaryPart = root
	m.Parent = parent
	return m
end

local function destroySkin()
	if skin then
		skin.model:Destroy()
		if skin.planeG and not skin.planeG.Parent then skin.planeG:Destroy() end
		if skin.ufoG and not skin.ufoG.Parent then skin.ufoG:Destroy() end
		skin = nil
	end
end

local function buildUfoSkin(parent, sz)
	local ufo = { }
	local hull = newModel(parent, "Hull")
	local flat = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis -> up
	local function disc(y, dia, thick, color, material, transparency)
		return mk(hull, Enum.PartType.Cylinder, V(thick * sz, dia * sz, dia * sz),
			CFrame.new(0, y * sz, 0) * flat, color, material, transparency)
	end
	disc(0.00, 8.0, 0.8, Color3.fromRGB(170, 175, 190), Enum.Material.Metal)
	disc(0.55, 6.2, 0.5, Color3.fromRGB(150, 156, 175), Enum.Material.Metal)
	disc(-0.55, 5.0, 0.5, Color3.fromRGB(105, 110, 130), Enum.Material.Metal)
	disc(-0.95, 2.0, 0.4, Color3.fromRGB(80, 255, 255), Enum.Material.Neon)
	disc(0.0, 8.15, 0.18, Color3.fromRGB(70, 75, 95), Enum.Material.Metal)
	mk(hull, Enum.PartType.Ball, V(3.2, 3.2, 3.2) * sz, CFrame.new(0, 1.0 * sz, 0),
		Color3.fromRGB(130, 225, 255), Enum.Material.Glass, 0.45)
	mk(hull, Enum.PartType.Ball, V(1.1, 1.1, 1.1) * sz, CFrame.new(0, 1.0 * sz, 0),
		Color3.fromRGB(120, 255, 170), Enum.Material.Neon, 0.15)
	mk(hull, nil, V(0.12, 0.9, 0.12) * sz, CFrame.new(0, 2.75 * sz, 0),
		Color3.fromRGB(190, 195, 210), Enum.Material.Metal)
	mk(hull, Enum.PartType.Ball, V(0.3, 0.3, 0.3) * sz, CFrame.new(0, 3.25 * sz, 0),
		Color3.fromRGB(255, 80, 80), Enum.Material.Neon)
	ufo.hull = hull

	local lights = newModel(parent, "Lights")
	ufo.rimLights = {}
	local N = 16
	for i = 1, N do
		local a = (i - 1) * TAU / N
		table.insert(ufo.rimLights, mk(lights, Enum.PartType.Ball, V(0.5, 0.5, 0.5) * sz,
			CFrame.new(math.cos(a) * 4.0 * sz, 0, math.sin(a) * 4.0 * sz),
			Color3.new(1, 1, 1), Enum.Material.Neon))
	end
	for i = 1, 8 do
		local a = (i - 1) * TAU / 8
		mk(lights, Enum.PartType.Ball, V(0.42, 0.42, 0.42) * sz,
			CFrame.new(math.cos(a) * 2.3 * sz, -0.8 * sz, math.sin(a) * 2.3 * sz),
			Color3.fromRGB(255, 240, 150), Enum.Material.Neon)
	end
	ufo.lights = lights

	ufo.beam = mk(parent, Enum.PartType.Cylinder, V(10, 3.5 * sz, 3.5 * sz), CFrame.new(),
		Color3.fromRGB(150, 255, 200), Enum.Material.Neon, 0.8)
	return ufo
end

local function buildPlaneSkin(parent, sz)
	local pl = {}
	local body = newModel(parent, "Body")
	local WHITE = Color3.fromRGB(228, 232, 242)
	local RED = Color3.fromRGB(205, 55, 55)
	local DARK = Color3.fromRGB(70, 75, 90)

	local function cylZ(x, y, z, len, dia, color, mat, tr)
		return mk(body, Enum.PartType.Cylinder, V(len * sz, dia * sz, dia * sz),
			CFrame.new(x * sz, y * sz, z * sz) * CFrame.Angles(0, math.pi / 2, 0), color, mat, tr)
	end
	local function ball(x, y, z, dx, dy, dz, color, mat, tr)
		return mk(body, Enum.PartType.Ball, V(dx, dy, dz) * sz,
			CFrame.new(x * sz, y * sz, z * sz), color, mat, tr)
	end
	local function blk(x, y, z, w, h, d, rot, color, mat, tr)
		return mk(body, nil, V(w, h, d) * sz,
			CFrame.new(x * sz, y * sz, z * sz) * (rot or CFrame.new()), color, mat, tr)
	end

	-- fuselage, nose, tail cone, cockpit
	cylZ(0, 0, 0, 8.0, 1.1, WHITE, Enum.Material.Metal)
	cylZ(0, 0, -0.5, 3.2, 1.12, RED, Enum.Material.Metal) -- red band
	ball(0, 0, -4.0, 1.1, 1.1, 1.1, RED, Enum.Material.Metal)
	ball(0, 0.05, 4.0, 0.8, 0.8, 0.8, WHITE, Enum.Material.Metal)
	ball(0, 0.5, -1.6, 0.8, 0.7, 1.6, Color3.fromRGB(130, 225, 255), Enum.Material.Glass, 0.35)

	-- swept wings + wing engines
	blk(2.45, -0.10, 0.3, 5.0, 0.14, 1.7, CFrame.Angles(0, -0.22, 0), WHITE, Enum.Material.Metal)
	blk(-2.45, -0.10, 0.3, 5.0, 0.14, 1.7, CFrame.Angles(0, 0.22, 0), WHITE, Enum.Material.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		cylZ(sx * 1.6, -0.40, -0.1, 1.2, 0.55, DARK, Enum.Material.Metal)
		ball(sx * 1.6, -0.40, 0.65, 0.45, 0.45, 0.45, Color3.fromRGB(255, 150, 60), Enum.Material.Neon)
	end

	-- tail fin + stabilizers
	blk(0, 1.0, 3.3, 0.12, 1.6, 1.2, CFrame.Angles(0.25, 0, 0), RED, Enum.Material.Metal)
	blk(1.0, 0.2, 3.65, 1.6, 0.1, 0.9, CFrame.Angles(0, -0.25, 0), WHITE, Enum.Material.Metal)
	blk(-1.0, 0.2, 3.65, 1.6, 0.1, 0.9, CFrame.Angles(0, 0.25, 0), WHITE, Enum.Material.Metal)

	-- navigation lights
	ball(-4.85, -0.10, 1.0, 0.25, 0.25, 0.25, Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
	ball(4.85, -0.10, 1.0, 0.25, 0.25, 0.25, Color3.fromRGB(40, 255, 90), Enum.Material.Neon)
	pl.strobe = ball(0, 1.95, 3.85, 0.25, 0.25, 0.25, Color3.new(1, 1, 1), Enum.Material.Neon)
	pl.body = body

	-- propeller (spins)
	local propM = newModel(parent, "Prop")
	mk(propM, nil, V(0.14, 2.4, 0.08) * sz, CFrame.new(), DARK, Enum.Material.Metal, 0.3)
	mk(propM, nil, V(2.4, 0.14, 0.08) * sz, CFrame.new(), DARK, Enum.Material.Metal, 0.3)
	mk(propM, Enum.PartType.Ball, V(0.4, 0.4, 0.4) * sz, CFrame.new(0, 0, -0.1 * sz), RED, Enum.Material.Metal)
	pl.prop = propM
	return pl
end

local function buildSkin()
	destroySkin()
	local sz = S.size
	local model = Instance.new("Model")
	model.Name = "UFOSkin"
	skin = { model = model, showPlane = (morph >= 0.5) }

	skin.ufoG = Instance.new("Model")
	skin.ufoG.Name = "UFO"
	skin.ufo = buildUfoSkin(skin.ufoG, sz)

	skin.planeG = Instance.new("Model")
	skin.planeG.Name = "Plane"
	skin.plane = buildPlaneSkin(skin.planeG, sz)

	-- only the active shape is parented
	if skin.showPlane then skin.planeG.Parent = model else skin.ufoG.Parent = model end

	-- outline so you can always find it, even far away or behind things
	local hl = Instance.new("Highlight")
	hl.Adornee = model
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(150, 255, 255)
	hl.OutlineTransparency = 0.25
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model

	model.Parent = workspace
end

