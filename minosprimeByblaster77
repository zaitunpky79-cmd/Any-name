local KEYS = {
	[Enum.KeyCode.One] = "Judgement", [Enum.KeyCode.Two] = "ThyEnd", [Enum.KeyCode.Three] = "Prepare", [Enum.KeyCode.Four] = "Die",
	[Enum.KeyCode.Five] = "Crush", [Enum.KeyCode.Six] = "Snake", [Enum.KeyCode.Seven] = "Uppercut", [Enum.KeyCode.Eight] = "Overhead",
	[Enum.KeyCode.Q] = "Blink",
}
table.insert(conns, UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightControl then win.Visible = not win.Visible
	elseif KEYS[i.KeyCode] then runSkill(KEYS[i.KeyCode]) end
end))
table.insert(conns, lp.CharacterAdded:Connect(function(c)
	refChar(c)
	if alive then
		refreshFilters()
		if ride then carryAvatar(true); cam.CameraSubject = camPart end
	end
end))
table.insert(conns, RunService.RenderStepped:Connect(function(dt)
	if padFrame then
		local show = control and alive and not cutActive
		padFrame.Visible = show
		ctrlFloat.Visible = not cutActive
		if not show then for k in pairs(pad) do pad[k] = false end end
	end
	if alive and camPart then
		local ok, err = pcall(step, math.min(dt, 0.033))
		if not ok then
			errT += dt
			if errT > 0.5 then errT = 0; notify("script error: " .. tostring(err), 6); warn("[MinosPrime] " .. tostring(err)) end
		end
		filT += dt
		if filT > 2 then filT = 0; refreshFilters() end
	end
	statT += dt
	if statT > 0.5 then
		statT = 0
		syncButtons()
		if os.clock() > noticeUntil then
			if alive then
				local st = act and act:upper() or (targetPl and ("Fighting " .. targetPl.DisplayName)) or (control and "Controlled") or "Idle"
				statusLbl.Text = string.format("%s | Phase %d | stamina %d/%d | %d bricks | speed %g", st, phase, stam, maxStam, #slots, SPEED)
			else
				statusLbl.Text = "Ready. Full Minos Prime = " .. NEED_FULL .. " bricks (1x1x1)."
			end
		end
	end
end))
table.insert(conns, RunService.Heartbeat:Connect(function() if alive then applyTargets() end end))
table.insert(conns, RunService.Stepped:Connect(function() if alive then applyTargets() end end))

