-- THE CUTSCENE: orbital drop -> brace -> crash landing -> hero rise -> hero pose -> visor ignite -> roar orbit -> title
local function runIntro()
	cutActive, skipFlag, busy = true, false, true
	setGlow("Offline")
	for k in pairs(poseT) do poseT[k] = 0 end
	poseSet({dive = 1, stance = 0.2}, 6)
	cam.CameraType = Enum.CameraType.Scriptable
	cineShow()
	fxOn()
	local H = geo.height
	local A0 = clamp(H * 13, 150, 1400)
	fall.y, fall.vy, fall.active, fall.landed, fall.phase = A0, 0, false, false, 1
	fall.hb = math.min(H * 1.6, A0 * 0.3)
	fall.g = 2 * (A0 - fall.hb) / (2.8 * 2.8)
	fall.v1 = fall.g * 2.8
	makeFlame()
	fadeF.BackgroundTransparency = 0
	tween(fadeF, {BackgroundTransparency = 1}, 1.2)
	task.spawn(function()
		local END_L = 9.9
		local t0, last, t = os.clock(), os.clock(), 0
		local tl, tt = nil, 0
		local fired = {}
		local camShk, fovKick, blurV, redT = 0, 0, 0, 0
		local titleT0
		local function cue(tm, key, fn) if t >= tm and not fired[key] then fired[key] = true; fn() end end
		local function cueL(tm, key, fn) if tl and tt >= tm and not fired[key] then fired[key] = true; fn() end end
		local function endAll() return skipFlag or (tl and tt >= END_L) or t > 30 end
		while alive do
			RunService.RenderStepped:Wait()
			local now = os.clock()
			local dt = math.min(now - last, 0.05)
			last = now
			t = now - t0
			if fall.landed and not tl then tl = t end
			tt = tl and (t - tl) or 0
			if endAll() then break end
			local rc = CFrame.new(hp.X, gy, hp.Z) * CFrame.Angles(0, heading, 0)
			local function P(x, y, z) return rc:PointToWorldSpace(V(x * H, y * H, z * H)) end
			local function R(x, y, z) return rc:VectorToWorldSpace(V(x * H, y * H, z * H)) end
			local ground = V(hp.X, gy, hp.Z)

			-- flame follows the feet
			if flamePart then
				flamePart.Position = footPos + V(0, -H * 0.05, 0)
			end

			-- cues: before landing (absolute time) -----------------------------------------------------
			cue(0.2, "rumble", function() camShk = 0.6 end)
			cue(1.2, "go", function() fall.active = true; flameRate(260); flash(0.25, 0.5) end)
			if fall.phase == 2 then
				cue(0, "brake", function()
					flash(0.5, 0.4); blurV = 20; fovKick = 10; camShk = 1.6; flameRate(520)
					poseSet({dive = 0, land = 0.5, stance = 0.4}, 3)
				end)
			end
			if t > 7.5 and not fall.landed then fall.y = 0 end
			if fall.landed then
				cue(0, "touch", function()
					flameRate(0)
					poseSet({land = 1}, 40)
					flash(0.95, 0.7); camShk = 4; fovKick = -20; blurV = 12; redT = 1
					shockwave(ground, H * 2.2, Color3.fromRGB(255, 190, 90))
					task.delay(0.12, function() shockwave(ground, H * 3.4, Color3.fromRGB(255, 130, 50)) end)
					task.delay(0.28, function() shockwave(ground, H * 4.6, Color3.fromRGB(255, 90, 40)) end)
					boom(ground + V(0, H * 0.1, 0), H * 0.9)
					dust(ground, 90, H * 0.8)
					spawnDebris(ground, 40, H * 2.2, H * 0.06)
				end)
			end
			-- cues: after landing (time since touchdown) --------------------------------------------------
			cueL(1.1, "rise1", function() poseSet({land = 0.5, head = 0.15, stance = 0.6}, 2.2) end)
			cueL(2.0, "rise2", function() poseSet({land = 0, side = 0.1, head = 0.1, stance = 0.8, lean = 0.1}, 2.4) end)
			cueL(2.8, "hero", function()
				poseSet({pArm = 3.05, pElbow = 0.05, pArmL = -0.1, pElbowL = 1.4, side = 0.15, stance = 1.1, head = 0.22, lean = 0.2}, 3.2)
				hudLbl.Visible = true
				camShk = 0.6
			end)
			cueL(4.7, "eyes", function() setGlow("Online"); flash(0.6, 0.5); camShk = 1.4; fovKick = -8 end)
			cueL(4.85, "eoff", function() setGlow("Offline") end)
			cueL(4.92, "eon", function() setGlow("Online") end)
			cueL(6.0, "roar", function()
				poseSet({side = 1.1, pArm = 0.6, pArmL = 0.6, lean = 0.35, head = 0.9, stance = 1.2}, 9)
				setGlow("Anger"); redT = 1.4; camShk = 2.6; blurV = 14
				shockwave(ground, H * 1.8, Color3.fromRGB(120, 235, 255))
				task.delay(0.2, function() shockwave(ground, H * 3.0, Color3.fromRGB(255, 80, 60)) end)
				dust(ground, 40, H * 0.5)
			end)
			cueL(7.3, "calm", function() poseSet({side = 0.5, stance = 1.0, lean = 0.2, head = 0.2, pArm = 0.2}, 4) end)
			cueL(7.6, "title", function() titleT0 = tt; setTitleVisible(true); flash(0.55, 0.3); camShk = 1.4 end)
			cueL(9.4, "out", function() tween(fadeF, {BackgroundTransparency = 0}, 0.4) end)

			-- camera ----------------------------------------------------------------------------------------
			local pos, target, fov, roll
			if not tl then
				if t < 2.2 then
					local k = smooth(t / 2.2)
					pos = P(0.1, 0.03, -0.9)
					target = torsoPos
					fov, roll = mix(60, 42, k), 0.08
				elseif fall.phase == 1 then
					pos = torsoPos + R(-1.4, 0.15, -1.6)
					target = torsoPos
					fov, roll = 74, -0.1
				else
					local mid = V(hp.X, gy + math.max(fall.y * 0.55, H * 0.25), hp.Z)
					pos = P(-0.55, 0.05, -1.0)
					target = mid
					fov, roll = 62, 0.04
				end
			elseif tt < 1.2 then
				local k = tt / 1.2
				pos = P(mix(-1.15, -1.0, k), 0.08, -0.25)
				target = P(0, 0.17, -0.1)
				fov, roll = mix(46, 38, k), -0.06
			elseif tt < 2.8 then
				local k = smooth((tt - 1.2) / 1.6)
				local a = mix(-1.3, -0.15, k)
				local r, h = mix(1.2, 0.95, k), mix(0.1, 0.24, k)
				pos = P(math.sin(a) * r, h, -math.cos(a) * r)
				target = headPos:Lerp(torsoPos, 0.3)
				fov, roll = mix(58, 52, k), mix(-0.1, 0, k)
			elseif tt < 4.5 then
				local k = smooth((tt - 2.8) / 1.7)
				pos = P(mix(0.6, 0.15, k), mix(0.04, 0.25, k), -mix(0.75, 1.5, k))
				target = torsoPos + V(0, H * 0.08, 0)
				fov, roll = mix(62, 52, k), mix(0.06, 0, k)
			elseif tt < 6.0 then
				local k = smooth((tt - 4.5) / 1.5)
				pos = headPos + R(mix(0.14, -0.03, k), 0.01, -mix(0.5, 0.2, k))
				target = headPos
				fov, roll = mix(34, 20, k), 0
			elseif tt < 7.6 then
				local k = smooth((tt - 6.0) / 1.6)
				local a = mix(-1.1, 1.0, k)
				local r, h = 1.35, mix(0.1, 0.5, k)
				pos = P(math.sin(a) * r, h, -math.cos(a) * r)
				target = torsoPos
				fov, roll = 60, math.sin(k * math.pi) * 0.06
			else
				local k = smooth((tt - 7.6) / 2.3)
				pos = P(0, 0.06, -mix(1.4, 1.0, k))
				target = headPos
				fov, roll = mix(52, 44, k), 0
			end
			if camShk > 0.01 then
				pos += V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * camShk * 0.012 * H
				camShk *= 0.9 ^ (dt * 60)
			end
			fovKick *= 0.9 ^ (dt * 60)
			if pos.Y < gy + 0.5 then pos = V(pos.X, gy + 0.5, pos.Z) end
			cam.CFrame = CFrame.lookAt(pos, target) * CFrame.Angles(0, 0, roll)
			cam.FieldOfView = clamp(fov + fovKick, 8, 110)

			-- grade, blur, HUD, title ----------------------------------------------------------------------
			redT = math.max(0, redT - dt * 0.4)
			if fxCC then
				local k = clamp(redT, 0, 1)
				fxCC.TintColor = fxCC.TintColor:Lerp(Color3.new(1, 1 - 0.3 * k, 1 - 0.3 * k), clamp(dt * 3, 0, 1))
				fxCC.Saturation = mix(-0.35, -0.1, k)
			end
			if fxBlur then
				fxBlur.Size = blurV
				blurV *= 0.88 ^ (dt * 60)
			end
			if hudLbl.Visible and tl then
				local n = math.floor((tt - 2.8) * 38)
				hudLbl.Text = HUD_TEXT:sub(1, clamp(n, 0, #HUD_TEXT))
				if tt > 7.4 then hudLbl.Visible = false end
			end
			if titleT0 then
				local p = tt - titleT0
				local solved = clamp(p / 0.7, 0, 1)
				local txt = (solved >= 1) and TITLE or scramble(solved)
				if solved >= 1 and math.random() < 0.06 then txt = scramble(0.6) end
				for _, l in ipairs({titleMain, titleR, titleC}) do l.Text = txt end
				titleMain.TextSize = mix(120, 72, smooth(p / 0.25))
				titleR.TextSize, titleC.TextSize = titleMain.TextSize, titleMain.TextSize
				local amp = ((p < 0.7) or math.random() < 0.05) and 10 or 2
				titleR.Position = UDim2.new(0, math.random(-amp, amp), 0.64, math.random(-amp, amp))
				titleC.Position = UDim2.new(0, math.random(-amp, amp), 0.64, math.random(-amp, amp))
				titleMain.Position = UDim2.new(0, 0, 0.64, 0)
				titleMain.TextTransparency = 0
				titleR.TextTransparency, titleC.TextTransparency = 0.55, 0.55
				subLbl.TextTransparency = clamp(1 - (p - 0.7) * 1.5, 0.15, 1)
			end
		end
		-- end of cutscene
		if flamePart then flamePart:Destroy(); flamePart = nil end
		fall.y, fall.vy, fall.active, fall.landed = 0, 0, false, true
		cutActive, busy = false, false
		crouchTarget, crouchRate = 0, 4
		restPose(5)
		setGlow(baseGlow())
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = baseFov
		flashF.BackgroundTransparency = 1
		cineHide()
		tween(fadeF, {BackgroundTransparency = 1}, 0.5)
	end)
end

-- dismiss / summon ----------------------------------------------------------------------------------
local function dismiss()
	skipFlag = true
	cutActive, busy = false, false
	cam.CameraType = Enum.CameraType.Custom
	pcall(function() cam.FieldOfView = baseFov end)
	fadeF.BackgroundTransparency, flashF.BackgroundTransparency = 1, 1
	cineHide()
	endLaser()
	setRide(false)
	for _, s in ipairs(saved) do
		local p = s.p
		if p and p.Parent then
			pcall(function()
				local bf = p:FindFirstChild("NoseyAntiG")
				if bf then bf:Destroy() end
				p.CFrame = s.cf
				p.Anchored = s.anchored
				p.CanCollide = s.collide
				p.Color, p.Material = s.color, s.material
				p.AssemblyLinearVelocity = V()
			end)
		end
	end
	if camPart then camPart:Destroy() end
	if flamePart then flamePart:Destroy() end
	if trailPart then trailPart:Destroy() end
	for _, d in ipairs(debrisList) do if d.p then d.p:Destroy() end end
	debrisList = {}
	camPart, flamePart, trailPart = nil, nil, nil
	pool, slots, saved, ammoSlots, A = {}, {}, {}, {}, {}
	alive, control, targetPl, act, faceTarget = false, false, nil, nil, nil
	equipped, swordEq, swordTarget = false, 0, 0
	curSp, hop, hopT, recoil = 0, 0, 0, 0
	fall.y, fall.active, fall.landed = 0, false, false
	avatarCF = nil
	cam.CameraSubject = hum
end

-- builds / refreshes the per-brick offsets from the current layout
local function assignSlots(create)
	local idx = 0
	local cxs, czs, Ls = cxb * sc, czb * sc, Lb * sc
	for _, pt in ipairs(parts) do
		for j = 1, pt.ny do
			for k = 1, pt.nz do
				for i = 1, pt.nx do
					if not (pt.tube and i > 1 and i < pt.nx and k > 1 and k < pt.nz) then
						idx += 1
						local off = V((i - 0.5 - pt.nx / 2) * cxs, (j - 0.5 - pt.ny / 2) * Ls, (k - 0.5 - pt.nz / 2) * czs)
						local s
						if create then
							local p = pool[idx]
							local color, gl = slotStyle(pt.kind, i, k, j, pt.nx, pt.ny)
							s = {p = p, color = color, gl = gl, orientBase = orientFor(p), ammo = pt.ammo, sword = (pt.bone == "Sword")}
							slots[idx] = s
							saved[idx] = {p = p, cf = p.CFrame, anchored = p.Anchored, collide = p.CanCollide, color = p.Color, material = p.Material}
						else
							s = slots[idx]
						end
						s.bone = pt.bone
						s.off = (pt.c + off) - bones[pt.bone].pv
						s.orient = (pt.rot or CFrame.new()) * s.orientBase
					end
				end
			end
		end
	end
end
local function rebuildGeometry()
	L = Lb * sc
	bones, order, parts, geo = layout(cxb * sc, czb * sc, Lb * sc, tierCur.tpl, tierCur.need - tierCur.base)
	assignSlots(false)
	if trailPart then
		local a0, a1 = trailPart:FindFirstChild("A0"), trailPart:FindFirstChild("A1")
		trailPart.Size = V(0.2, geo.bladeLen, 0.2)
		if a0 then a0.Position = V(0, geo.bladeLen / 2, 0) end
		if a1 then a1.Position = V(0, -geo.bladeLen / 2, 0) end
	end
end

local sizeBox
local function summon()
	if alive then return end
	local list, dims = gather()
	if not list then notify("Cannot spawn: " .. tostring(dims), 6) return end
	local tier = planTier(#list)
	if not tier then
		notify(string.format("Need at least %d bricks of one size (1x1x3), found %d (%.1fx%.1fx%.1f). Stand next to your own bricks.",
			NEED_MIN, #list, dims[1], dims[2], dims[3]), 9)
		return
	end
	tierCur, curNeed, tplCur = tier, tier.need, TEMPLATES[tier.tpl]
	pool = {}
	for i = 1, curNeed do pool[i] = list[i][1] end
	cxb, czb, Lb = dims[1], dims[2], dims[3]
	sc = clamp(scTarget, 1, 10)
	L = Lb * sc
	bones, order, parts, geo = layout(cxb * sc, czb * sc, Lb * sc, tier.tpl, tier.need - tier.base)
	slots, saved, ammoSlots = {}, {}, {}
	assignSlots(true)
	for _, s in ipairs(slots) do
		local p = s.p
		pcall(function() p.Anchored = false; p.CanCollide = false; p.CanTouch = false end)
		pcall(function()
			local bf = Instance.new("BodyForce")
			bf.Name = "NoseyAntiG"
			bf.Force = V(0, p.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = p
		end)
		pcall(function() p.Color = s.color; p.Material = (s.gl == "blade") and Enum.Material.Metal or Enum.Material.SmoothPlastic end)
		if s.ammo then ammoSlots[s.ammo] = s end
	end
	initAmmo()
	pcall(function() lp.MaximumSimulationRadius = math.huge end)
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)

	camPart = mk("Part", {Anchored = true, CanCollide = false, CanQuery = false, Transparency = 1, Size = V(1, 1, 1)}, workspace)
	makeTrail()
	rebuildGeometry()
	refreshFilters()
	oldZoomMax, oldZoomMin = lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance
	baseFov = cam.FieldOfView

	local look = hrp.CFrame.LookVector
	look = V(look.X, 0, look.Z)
	look = look.Magnitude > 1e-3 and look.Unit or V(0, 0, -1)
	heading = math.atan2(look.X, look.Z)
	local sp0 = hrp.Position + look * (geo.height * 0.8 + 10)
	hp = V(sp0.X, 0, sp0.Z)
	gy = groundAt(V(sp0.X, hrp.Position.Y, sp0.Z), 40)
	crouch, crouchTarget, crouchRate, curSp, wavePh = 0, 0, 4, 0, 0
	control, targetPl, equipped, swordEq, swordTarget = false, nil, false, 0, 0
	recoil, hop, hopT, laser = 0, 0, 0, nil
	for k in pairs(pose) do pose[k] = 0; poseT[k] = 0 end
	headPos, torsoPos = V(hp.X, gy + geo.headY, hp.Z), V(hp.X, gy + geo.torsoY, hp.Z)
	handPos, footPos = V(hp.X, gy + geo.height * 0.2, hp.Z), V(hp.X, gy, hp.Z)
	alive = true
	setGlow("Offline")
	setBlade(false)
	runIntro()
	notify(string.format("%d bricks (%s build) | %.0fx | height %.0f studs", curNeed, tier.tpl, sc, geo.height), 6)
end

-- main step -----------------------------------------------------------------------------------------
local function footZ(h, k)
	return -(geo.thighLen * math.sin(h) + geo.shinLen * math.sin(h + k))
end

local function step(dt)
	local t = os.clock()
	-- live resize
	if math.abs(sc - scTarget) > 0.002 then
		sc += (scTarget - sc) * clamp(dt * 4, 0, 1)
		if math.abs(sc - scTarget) < 0.01 then sc = scTarget end
		rebuildGeometry()
	end
	local H = geo.height
	gy = groundAt(V(hp.X, gy, hp.Z), H + 30)
	punchCd = math.max(0, punchCd - dt)

	-- orbital drop (cutscene)
	if fall.active and not fall.landed then
		if fall.phase == 1 then
			fall.vy += fall.g * dt
			fall.y -= fall.vy * dt
			if fall.y <= fall.hb then fall.phase = 2 end
		else
			local vt = (fall.y / math.max(fall.hb, 1)) * fall.v1 * 0.22 + H * 0.35
			fall.vy += (vt - fall.vy) * clamp(dt * 6, 0, 1)
			fall.y -= fall.vy * dt
		end
		if fall.y <= 0 then fall.y = 0; fall.landed = true; fall.landT = t; fall.active = false end
	end

	-- 1) movement intent
	local wantDir, tgtSp = nil, 0
	local spd = SPEED * sc
	if not (busy or act or cutActive) then
		if control then
			local mv = getMove()
			if mv.Magnitude > 0.1 then wantDir, tgtSp = mv.Unit, spd * math.min(1, mv.Magnitude) end
		elseif targetPl then
			local th = targetHrp(targetPl)
			local tHum = th and th.Parent and th.Parent:FindFirstChildOfClass("Humanoid")
			if not th or not targetPl.Parent then
				targetPl = nil
				notify("Target lost", 3)
			elseif tHum and tHum.Health <= 0 then
				targetPl = nil
				notify("Target down", 3)
			else
				local flat = V(th.Position.X - hp.X, 0, th.Position.Z - hp.Z)
				local dist = flat.Magnitude
				local reach = H * 0.33
				if dist > 1e-3 then wantDir = flat.Unit end
				if dist > reach * 0.8 then tgtSp = spd * smooth((dist - reach * 0.8) / (H * 0.3) + 0.2) end
				aiShotT -= dt
				aiLaserT -= dt
				if dist > reach * 2 and dist < H * 8 and aiShotT <= 0 then fireShot(); aiShotT = 0.9 end
				if dist > H * 1.5 and dist < H * 6 and aiLaserT <= 0 then task.spawn(runSkill, "Laser"); aiLaserT = 14 end
				if dist <= reach and punchCd <= 0 then
					local pick = equipped and "Slash" or ((math.random() < 0.65) and "Punch" or "Slam")
					task.spawn(runSkill, pick, targetPl)
				end
			end
		end
	end
	if act and faceTarget then
		local th = targetHrp(faceTarget)
		if th then
			local flat = V(th.Position.X - hp.X, 0, th.Position.Z - hp.Z)
			if flat.Magnitude > 1e-3 then
				heading += clamp(adiff(math.atan2(-flat.X, -flat.Z), heading) * math.min(1, dt * 6), -5 * dt, 5 * dt)
			end
		end
	end
	if wantDir then
		local d = adiff(math.atan2(-wantDir.X, -wantDir.Z), heading)
		heading += clamp(d * math.min(1, dt * 3), -2.2 * dt, 2.2 * dt)
	end
	local F = V(-math.sin(heading), 0, -math.cos(heading))
	curSp += (tgtSp - curSp) * math.min(1, dt * ((tgtSp > curSp) and 1.6 or 4))
	if curSp > 0.2 then hp = hp + F * curSp * dt end
	if dashT > 0 then dashT -= dt; hp = hp + F * dashSpd * dt end

	-- 2) pose blending
	crouch += (crouchTarget - crouch) * clamp(dt * crouchRate, 0, 1)
	local kp = clamp(dt * poseRate, 0, 1)
	for key, v in pairs(pose) do pose[key] = v + (poseT[key] - v) * kp end
	hop += (hopT - hop) * clamp(dt * 9, 0, 1)
	recoil = math.max(0, recoil - dt * 3)
	swordEq += clamp(swordTarget - swordEq, -dt * 2, dt * 2)
	local ce = clamp(crouch + pose.crouch, 0, 1.2)
	local landK, diveK = pose.land, pose.dive

	-- 3) walk cycle (weighty mech gait, cadence tied to ground speed)
	local sp = curSp
	local a = clamp(sp / (50 * sc), 0, 1)
	local walking = clamp(sp / (4 * sc), 0, 1)
	local idle = 1 - walking
	local legLen = geo.thighLen + geo.shinLen + geo.footH
	local swing = (0.24 + 0.34 * a) * (1 - math.min(ce, 1) * 0.8)
	if sp > 0.2 * sc then
		wavePh += dt * clamp(math.pi * sp / (2 * (geo.thighLen + geo.shinLen) * math.max(swing, 0.12)), 0.4, 7)
	end
	local sw, cw = math.sin(wavePh), math.cos(wavePh)
	local amp = swing * walking
	local hip = ce * 0.9
	local hL, hR = hip + sw * amp, hip - sw * amp
	local bend = (0.3 + 0.8 * a) * walking
	local kL = -ce * 1.5 - math.max(0, cw) * bend
	local kR = -ce * 1.5 - math.max(0, -cw) * bend
	if landK > 0.001 then
		hL, kL = mix(hL, 1.45, landK), mix(kL, -2.4, landK)
		hR, kR = mix(hR, 0.14, landK), mix(kR, -1.75, landK)
	end

	local armSw = sw * (0.12 + 0.4 * a) * walking
	local breathe = math.sin(t * 1.2) * 0.015
	local servo = math.sin(t * 7.3) * 0.004 * idle
	local lag = a * 0.25
	local lookYaw = math.sin(t * 0.5) * 0.28 * idle * (act and 0 or 1) * (1 - landK)
	local stance = pose.stance

	local rot = {
		Root = CFrame.new(),
		Torso = CFrame.Angles(-ce * 0.5 - a * 0.2 + pose.lean - landK * 0.95 - diveK * 0.1 + breathe + recoil * 0.1,
			pose.twist - sw * 0.1 * walking, cw * 0.04 * walking),
		Head = CFrame.Angles(ce * 0.35 + a * 0.2 + pose.head - breathe + landK * 0.85 + diveK * 0.2 - recoil * 0.08 + servo, lookYaw + pose.headYaw,
			math.sin(t * 0.6) * 0.03),
		ArmL = CFrame.Angles(ce * 0.3 - a * 0.12 - armSw + pose.arm + pose.pArmL - landK * 0.9 - diveK * 0.35, pose.spread, 0.05 + pose.side + diveK * 0.3),
		ArmR = CFrame.Angles(ce * 0.3 - a * 0.12 + armSw + pose.arm + pose.pArm + landK * 1.25 - diveK * 0.35, -pose.spread, -0.05 - pose.side - diveK * 0.3),
		ForeL = CFrame.Angles(0.12 + a * 0.25 + ce * 0.3 + pose.pElbowL + math.max(0, -armSw) * 0.7 + diveK * 0.2, 0, 0),
		ForeR = CFrame.Angles(0.12 + a * 0.25 + ce * 0.3 + pose.pElbow + math.max(0, armSw) * 0.7 + diveK * 0.2, 0, 0),
		HandL = CFrame.Angles(0.1 + a * 0.2 + math.sin(t * 1.5) * 0.02, 0, 0),
		HandR = CFrame.Angles(0.1 + a * 0.2 + math.sin(t * 1.5 + 1.3) * 0.02, 0, 0),
		ThighL = CFrame.Angles(hL, 0, -stance * 0.12 - diveK * 0.05), ThighR = CFrame.Angles(hR, 0, stance * 0.12 + diveK * 0.05),
		ShinL = CFrame.Angles(kL, 0, 0), ShinR = CFrame.Angles(kR, 0, 0),
		FootL = CFrame.Angles(-(hL + kL) + math.max(0, cw) * 0.25 * walking, 0, 0),
		FootR = CFrame.Angles(-(hR + kR) + math.max(0, -cw) * 0.25 * walking, 0, 0),
	}
	for _, s in ipairs({-1, 1}) do
		local d = s < 0 and "L" or "R"
		for n = 1, tplCur.fins do
			rot["Fin" .. d .. n] = CFrame.Angles(lag * 0.8 + math.sin(t * 2 - n) * 0.04 - pose.head * 0.2, 0, -s * (math.sin(t * 2.4 + n) * 0.05 + pose.side * 0.1))
		end
	end

	-- keep the planted foot on the ground; feet stay under the body when crouching / landing
	local reach = math.max(
		geo.thighLen * math.cos(hL) + geo.shinLen * math.cos(hL + kL) + geo.footH,
		geo.thighLen * math.cos(hR) + geo.shinLen * math.cos(hR + kR) + geo.footH)
	local baseY = gy + (reach - legLen) + fall.y + hop
	local fz = (footZ(hL, kL) + footZ(hR, kR)) * 0.5
	local baseCF = CFrame.new(hp.X, baseY, hp.Z) * CFrame.Angles(0, heading, 0) * CFrame.new(0, 0, fz * clamp(ce + landK, 0, 1))

	-- 4) forward kinematics
	local M = {}
	for _, name in ipairs(order) do
		if name ~= "Sword" then
			local b = bones[name]
			local r = rot[name] or CFrame.new()
			if b.parent then
				M[name] = M[b.parent] * CFrame.new(b.pv - bones[b.parent].pv) * r
			else
				M[name] = CFrame.new(b.pv) * r
			end
		end
	end
	-- sword: stowed on the back <-> held in the right fist (orientation driven by pose.swPitch / swYaw / swRoll)
	local torsoW = baseCF * M.Torso
	local stowW = torsoW * geo.stowRel
	local gripPos = (baseCF * M.HandR * CFrame.new(0, -geo.fistHalf, 0)).Position
	local heldW = CFrame.new(gripPos) * torsoW.Rotation * CFrame.Angles(0, pose.swYaw, 0) * CFrame.Angles(pose.swPitch, 0, 0) * CFrame.Angles(0, 0, pose.swRoll)
	local e = smooth(swordEq)
	local swordW = stowW:Lerp(heldW, e) + V(0, math.sin(e * math.pi) * H * 0.18, 0)
	if equipped and swordEq >= 1 then swordW = swordW * CFrame.Angles(0, 0, math.sin(t * 2) * 0.015) end

	for _, s in ipairs(slots) do
		local base = s.sword and swordW or (baseCF * M[s.bone])
		local cf = base * CFrame.new(s.off) * s.orient
		s.rigCF = cf
		s.cf = cf
	end
	updateAmmo(dt)
	updateLaser(dt, torsoW)
	for _, s in ipairs(slots) do
		local cf = s.cf
		if s.last and dt > 0 then
			local v = (cf.Position - s.last) / dt
			if v.Magnitude > 250 then v = v.Unit * 250 end
			s.vel = v
		else
			s.vel = V()
		end
		s.last = cf.Position
	end

	headPos = (baseCF * M.Head * CFrame.new(V(0, geo.headY, 0) - bones.Head.pv)).Position
	torsoPos = (baseCF * M.Torso * CFrame.new(V(0, geo.torsoY, 0) - bones.Torso.pv)).Position
	handPos = (baseCF * M.HandR * CFrame.new(0, -geo.fistHalf, 0)).Position
	footPos = (baseCF * M.FootL * CFrame.new(0, -geo.footH, 0)).Position
	if trailPart then
		trailPart.CFrame = swordW * CFrame.new(0, geo.bladeY0 + geo.bladeLen / 2, 0)
	end

	-- footsteps: camera thud + dust on every plant
	local cwPos = cw >= 0
	if cwPos ~= lastCwPos then
		lastCwPos = cwPos
		if walking > 0.35 and not cutActive then
			local d = cwPos and "R" or "L"
			local fp = (baseCF * M["Foot" .. d] * CFrame.new(0, -geo.footH, 0)).Position
			local gp = V(fp.X, gy, fp.Z)
			shakeFrom(gp, 0.18, 0.22, H * 6)
			shockwave(gp, H * 0.12, Color3.fromRGB(200, 190, 170))
			if sc >= 1.5 then dust(gp, 6, H * 0.06) end
		end
	end

	-- 5) avatar inside the body + guard (stay the closest player so the bricks stay yours)
	avatarCF = CFrame.new(torsoPos)
	radT += dt
	if radT > 1 then
		radT = 0
		pcall(function() lp.MaximumSimulationRadius = math.huge end)
		pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)
	end
	guardT += dt
	if guardT > 0.1 then
		guardT = 0
		threats = {}
		local near = 120 + 4 * L
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= lp then
				local th = targetHrp(pl)
				if th and (th.Position - torsoPos).Magnitude < near + H then
					local bp, bd
					for _, s in ipairs(slots) do
						local d = (s.cf.Position - th.Position).Magnitude
						if not bd or d < bd then bd, bp = d, s.cf.Position end
					end
					if bd and bd < near then threats[#threats + 1] = {pos = bp, d = bd} end
				end
			end
		end
		table.sort(threats, function(x, y) return x.d < y.d end)
	end
	if #threats > 0 and ride then
		local k = (math.floor(os.clock() * 8) % #threats) + 1
		avatarCF = CFrame.new(threats[k].pos)
	end
	setRide(not cutActive)
	if not ride then avatarCF = nil end

	camPart.Position = headPos + V(0, 0.15 * H, 0)
	if ride then lp.CameraMinZoomDistance = clamp(H * 0.7, 12, 5000) end
end

local function applyTargets()
	for _, s in ipairs(slots) do
		local p = s.p
		if p.Parent and s.cf then
			p.CFrame = s.cf
			p.AssemblyLinearVelocity = s.vel or V()
			p.AssemblyAngularVelocity = V()
		end
	end
	if avatarCF and ride and hrp and hrp.Parent then
		hrp.CFrame = avatarCF
		hrp.AssemblyLinearVelocity = V()
		hrp.AssemblyAngularVelocity = V()
	end
end

