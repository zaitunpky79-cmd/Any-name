local function lerp(a, b, t) return a + (b - a) * t end
local function clamp(x, a, b) return math.clamp(x, a, b) end
local function smooth(x) x = clamp(x, 0, 1); return x * x * (3 - 2 * x) end
local function adiff(a, b) return (a - b + math.pi) % TAU - math.pi end
local function spr(key, target, w, z, dt)
	local s = S3[key]
	if not s then s = {x = target, v = 0}; S3[key] = s end
	local a = w * w * (target - s.x) - 2 * z * w * s.v
	s.v += a * dt
	s.x += s.v * dt
	return s.x
end

-- avatar: UNANCHORED so its position replicates; carried inside him only while he rages -------
local function carryAvatar(on)
	if on then
		pcall(function() hrp.Anchored = false end)
		pcall(function() hum.PlatformStand = true end)
		avatarSaved = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then avatarSaved[d] = d.CanCollide; d.CanCollide = false end
		end
		pcall(function()
			local old = hrp:FindFirstChild("ScpAvatarAntiG")
			if old then old:Destroy() end
			local bf = Instance.new("BodyForce")
			bf.Name = "ScpAvatarAntiG"
			bf.Force = Vector3.new(0, hrp.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = hrp
		end)
	else
		pcall(function() local bf = hrp:FindFirstChild("ScpAvatarAntiG"); if bf then bf:Destroy() end end)
		for d, c in pairs(avatarSaved) do pcall(function() d.CanCollide = c end) end
		avatarSaved = {}
		pcall(function() hum.PlatformStand = false end)
		pcall(function() hrp.Anchored = false end)
		pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
	end
end
local function setRide(on)
	if on == ride then return end
	ride = on
	carryAvatar(on)
	if on then
		cam.CameraSubject = camPart
		lp.CameraMaxZoomDistance = 3000
		lp.CameraMinZoomDistance = math.min(9 * Kb * CFG.Size, 2900)
	else
		avatarCF = nil
		cam.CameraSubject = hum
		if oldZoomMax then lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance = oldZoomMax, oldZoomMin end
	end
end

-- bricks (same selection rules as mech v3) -----------------------------------
local function toPart(o)
	if not o then return nil end
	if o:IsA("BasePart") then return o end
	return o:FindFirstChildWhichIsA("BasePart", true)
end
local function collect(container, from, to)
	local kids, out, seen = container:GetChildren(), {}, {}
	for i = from, math.min(to, #kids) do
		local p = toPart(kids[i])
		if p and not seen[p] then seen[p] = true; out[#out + 1] = p end
	end
	return out
end
local function usable(p, rep)
	if not p or not p.Parent or p:IsDescendantOf(char) then return false end
	if p.Anchored then rep.anchored += 1 return false end
	local okJ, joints = pcall(function() return p:GetJoints() end)
	if okJ and #joints > 0 then rep.welded += 1 return false end
	if isnetworkowner then
		local okO, own = pcall(isnetworkowner, p)
		if okO and not own then rep.notOwned += 1 return false end
	end
	rep.ok += 1
	return true
end
local function gather()
	local root = workspace:FindFirstChild("Bricks")
	if not root then return nil end
	local rep = {anchored = 0, welded = 0, notOwned = 0, ok = 0, total = 0}
	local ranged = collect(root, CFG.From, CFG.To)
	if #ranged == 0 then
		local sub = root:FindFirstChild(lp.Name) or root:FindFirstChild("master_ofbuilds")
		if sub then ranged = collect(sub, CFG.From, CFG.To) end
	end
	local out, seen, parents = {}, {}, {}
	local function consider(p)
		if p and not seen[p] and #out < CFG.Want then
			seen[p] = true
			rep.total += 1
			if not CFG.Strict then rep.ok += 1; out[#out + 1] = p
			elseif usable(p, rep) then out[#out + 1] = p end
		end
	end
	for _, p in ipairs(ranged) do parents[p.Parent] = true; consider(p) end
	if #out < CFG.Want then
		local extra = {}
		for par in pairs(parents) do
			for _, d in ipairs(par:GetChildren()) do
				if d:IsA("BasePart") and not seen[d] then extra[#extra + 1] = d end
			end
		end
		table.sort(extra, function(x, y) return (x.Position - hrp.Position).Magnitude < (y.Position - hrp.Position).Magnitude end)
		for _, p in ipairs(extra) do
			if #out >= CFG.Want then break end
			consider(p)
		end
	end
	return out, rep
end

-- colors (LOCAL ONLY): pale flesh ----------------------------------------------------
local function paint(p, c)
	pcall(function() p.Color = c; p.Material = Enum.Material.SmoothPlastic end)
end
local function applyColors()
	if not CFG.Recolor then return end
	local FLESH, HEAD, FING = Color3.fromRGB(214, 186, 174), Color3.fromRGB(226, 200, 188), Color3.fromRGB(186, 150, 138)
	for k, lst in pairs(P) do
		for _, p in ipairs(lst) do
			if k == "head" or k == "jaw" then paint(p, HEAD)
			elseif k == "fingL" or k == "fingR" then paint(p, FING)
			else paint(p, FLESH) end
		end
	end
end

-- summon / dismiss ---------------------------------------------------------
local function dismiss()
	setRide(false)
	for _, s in ipairs(saved) do
		local p = s.p
		if p and p.Parent then
			pcall(function()
				local bf = p:FindFirstChild("ScpAntiG")
				if bf then bf:Destroy() end
				p.CFrame = s.cf
				p.Anchored = s.anchored
				p.CanCollide = s.collide
				p.Color, p.Material = s.color, s.material
				p.AssemblyLinearVelocity = Vector3.zero
			end)
		end
	end
	if camPart then camPart:Destroy() end
	camPart, pool, P = nil, {}, {}
	saved, orient, targets = {}, {}, {}
	lastPos, driftBad = {}, {}
	alive, armed, rage, ride = false, false, nil, false
	avatarCF = nil
	pcall(function() cam.FieldOfView = baseFov end)
	cam.CameraSubject = hum
end

local function groundAt(p, h)
	local res = workspace:Raycast(p + Vector3.new(0, h, 0), Vector3.new(0, -3000, 0), groundP)
	return res and res.Position.Y or p.Y
end
local function refreshFilters()
	local f = {char, camPart}
	for _, p in ipairs(pool) do f[#f + 1] = p end
	tapP.FilterDescendantsInstances = f
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then f[#f + 1] = pl.Character end
	end
	groundP.FilterDescendantsInstances = f
end

local function summon()
	if alive then return end
	local list, rep = gather()
	if not list then notify("✘ workspace.Bricks not found") return end
	local N = #list
	if N < CFG.MinBricks then
		notify(string.format("✘ Need %d+ bricks that can replicate (20 ideal), found %d (of %d checked): %d anchored, %d welded, %d not yours.",
			CFG.MinBricks, N, rep.total, rep.anchored, rep.welded, rep.notOwned), 9)
		return
	end
	pool = list
	local fPer = clamp(math.floor((N - 12) / 2), 1, 4)
	P = {head = {}, jaw = {}, torso = {}, armL = {}, armR = {}, legL = {}, legR = {}, fingL = {}, fingR = {}}
	local idx = 0
	local function take(key, n)
		for i = 1, n do idx += 1; P[key][i] = list[idx] end
	end
	take("head", 1); take("jaw", 1); take("torso", 2)
	take("armL", 2); take("armR", 2); take("legL", 2); take("legR", 2)
	take("fingL", fPer); take("fingR", fPer)

	saved, orient, targets = {}, {}, {}
	lastPos, driftBad = {}, {}
	local sumLong, sumMid, anchoredCount = 0, 0, 0
	for i, p in ipairs(pool) do
		saved[i] = {p = p, cf = p.CFrame, anchored = p.Anchored, collide = p.CanCollide, color = p.Color, material = p.Material}
		local s = p.Size
		local mx, mn = math.max(s.X, s.Y, s.Z), math.min(s.X, s.Y, s.Z)
		sumLong += mx
		sumMid += s.X + s.Y + s.Z - mx - mn
		if s.X == mx and s.X > s.Y then orient[p] = CFrame.Angles(0, 0, math.pi / 2)
		elseif s.Z == mx and s.Z > s.Y then orient[p] = CFrame.Angles(-math.pi / 2, 0, 0)
		else orient[p] = CFrame.new() end
		if p.Anchored then anchoredCount += 1 end
		pcall(function() p.Anchored = false; p.CanCollide = false end)
		pcall(function()
			local bf = Instance.new("BodyForce")
			bf.Name = "ScpAntiG"
			bf.Force = Vector3.new(0, p.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = p
		end)
	end
	Kb = clamp(sumLong / N, 1, 20)
	Tb = clamp(sumMid / N, 0.3, 10)
	pcall(function() lp.MaximumSimulationRadius = math.huge end)
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)

	camPart = Instance.new("Part")
	camPart.Anchored, camPart.CanCollide, camPart.Transparency, camPart.Size, camPart.CanQuery = true, false, 1, Vector3.one, false
	camPart.Parent = workspace
	refreshFilters()

	oldZoomMax, oldZoomMin = lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance
	baseFov = cam.FieldOfView
	local look = hrp.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 1e-3 and flat.Unit or Vector3.new(0, 0, -1)
	pos = hrp.Position + flat * 14 * Kb / 3
	pos = Vector3.new(pos.X, groundAt(pos, 30), pos.Z)
	yaw = math.atan2(flat.X, flat.Z) -- faces the player who summoned him
	ph = 0
	S3, S = {}, {}
	shake, fovKick, armed, rage, ride = 0, 0, false, nil, false
	alive = true
	applyColors()
	notify(string.format("✔ SCP-096 ready • %d bricks • brick %.1f long → he stands %.1f studs tall%s", N, Kb, 5.55 * Kb,
		anchoredCount > 0 and string.format(" • ⚠ %d anchored", anchoredCount) or ""), 7)
end

-- rig helpers --------------------------------------------------------------
local function place(p, cf)
	targets[p] = cf * orient[p]
end
local function boneCF(a, b, side)
	local dir = b - a
	if dir.Magnitude < 1e-3 then dir = Vector3.new(0, -1, 0) end
	dir = dir.Unit
	local x = side - dir * side:Dot(dir)
	if x.Magnitude < 1e-3 then x = Vector3.xAxis end
	return CFrame.fromMatrix((a + b) / 2, x.Unit, dir)
end
local function chain(list, i0, n, a, b, side)
	local rot = boneCF(a, b, side).Rotation
	for k = 1, n do
		local p = list[i0 + k - 1]
		if p then place(p, CFrame.new(a:Lerp(b, (k - 0.5) / n)) * rot) end
	end
end
local function ik2(a, tgt, l1, l2, pole)
	local v = tgt - a
	local dist = clamp(v.Magnitude, 0.2, (l1 + l2) * 0.999)
	local vu = v.Magnitude > 1e-4 and v.Unit or Vector3.new(0, -1, 0)
	local along = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(0, l1 * l1 - along * along))
	local pp = pole - vu * pole:Dot(vu)
	pp = pp.Magnitude > 1e-4 and pp.Unit or Vector3.yAxis
	return a + vu * along + pp * h, a + vu * dist
end
local function applyTargets()
	for p, cf in pairs(targets) do
		if p.Parent then
			p.CFrame = cf
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
			lastPos[p] = cf.Position
		end
	end
	if avatarCF and ride and hrp and hrp.Parent then
		hrp.CFrame = avatarCF
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end
local function checkDrift()
	local lim = 0.6 * Kb
	for p, wrote in pairs(lastPos) do
		if p.Parent then
			local d = (p.Position - wrote).Magnitude
			local n = driftBad[p] or 0
			driftBad[p] = d > lim and math.min(10, n + 1) or math.max(0, n - 1)
		end
	end
end
local function visibleCount()
	local n, owned = 0, 0
	for _, p in ipairs(pool) do
		n += 1
		local good = (driftBad[p] or 0) < 3
		if good and isnetworkowner then
			local ok, o = pcall(isnetworkowner, p)
			if ok and not o then good = false end
		end
		if good then owned += 1 end
	end
	return owned, n
end

-- the rig: head, jaw, torso, arms, legs, fingers ---------------------------------------
local function drawSCP(dt, e)
	local u = e.u
	local function V(x, y, z) return Vector3.new(x * u, y * u, z * u) end
	local function T(x, y, z) return CFrame.new(x * u, y * u, z * u) end
	local t = e.t
	local sit, runW, sh = S.sit, S.run, S.shake
	local G = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local right = G.RightVector
	local jit = Vector3.new(math.sin(t * 37), math.sin(t * 41 + 1), math.sin(t * 29 + 2)) * 0.045 * u * sh
	local bob = 0.1 * u * runW * math.abs(math.sin(TAU * ph)) + math.sin(t * 1.4) * 0.02 * u * sit

	-- pelvis: tall when standing, on the ground when sitting
	local pelvisY = lerp(2.62 * u, 0.62 * u, sit) - 0.1 * u * runW + bob
	local pelvisZ = lerp(0, 0.9 * u, sit)
	local pelvis = G * CFrame.new(0, pelvisY, pelvisZ) * CFrame.new(jit)
	local fwd = pelvis.LookVector

	-- legs: 2-bone IK; sitting = feet planted in front, knees up
	local stride, lift = 2.4 * u, 0.9 * u
	local kneeW = {}
	for _, side in ipairs({-1, 1}) do
		local lst = (side < 0) and P.legL or P.legR
		local phl = (ph + (side > 0 and 0.5 or 0)) % 1
		local fx, fy = 0, 0
		if phl < 0.5 then fx = lerp(stride / 2, -stride / 2, phl / 0.5)
		else
			local uu = (phl - 0.5) / 0.5
			fx, fy = lerp(-stride / 2, stride / 2, smooth(uu)), math.sin(math.pi * uu) * lift
		end
		fx, fy = fx * runW, fy * runW
		local ankle = G * Vector3.new(side * 0.42 * u, fy + 0.04 * u, lerp(-fx, -1.0 * u, sit))
		local hipW = pelvis * V(side * 0.33, 0, 0)
		local knee, ank = ik2(hipW, ankle, 1.35 * u, 1.35 * u, fwd + right * side * 0.25)
		chain(lst, 1, 1, hipW, knee, right)
		chain(lst, 2, 1, knee, ank, right)
		kneeW[side] = knee
	end

	-- torso (2 bricks) curled forward when calm
	local twist = S.twist + sh * math.sin(t * 13) * 0.12 - math.sin(TAU * ph) * 0.15 * runW
	local tor = pelvis * T(0, 0.1, 0) * CFrame.Angles(-S.lean + math.sin(t * 1.4) * 0.015, twist, S.roll)
	place(P.torso[1], tor * T(0, 0.55, 0))
	place(P.torso[2], tor * T(0, 1.15, 0))

	-- head + jaw
	local headBase = tor * T(0, 1.75, -0.1) * CFrame.Angles(S.headP + sh * math.sin(t * 19) * 0.08,
		S.headY + S.hshake * math.sin(t * 17) * 0.6, S.roll + S.hshake * math.sin(t * 23) * 0.12)
	place(P.head[1], headBase * T(0, 0.5, 0))
	local jawAng = S.jaw + 0.12 * S.jaw * math.sin(t * 28)
	place(P.jaw[1], headBase * T(0, 0.12, -0.12) * CFrame.Angles(-jawAng, 0, 0) * T(0, 0, -0.42) * CFrame.Angles(math.pi / 2, 0, 0))

	-- arms: 2-bone IK; calm = left hand over the face, right arm wrapped over the knee
	local shoulders = {[-1] = tor * V(-0.62, 1.5, 0), [1] = tor * V(0.62, 1.5, 0)}
	local nf = #P.fingL
	for _, side in ipairs({-1, 1}) do
		local lst = (side < 0) and P.armL or P.armR
		local fing = (side < 0) and P.fingL or P.fingR
		local hand = G * V(S[side < 0 and "hLx" or "hRx"], S[side < 0 and "hLy" or "hRy"], S[side < 0 and "hLz" or "hRz"])
		hand += jit * 2
		if side < 0 then
			hand = hand:Lerp(headBase * V(0, 0.45, -0.32), S.cover)
		else
			hand = hand:Lerp(kneeW[1] + Vector3.new(0, 0.18 * u, 0) + G.LookVector * 0.25 * u, S.wrap)
		end
		local shoulder = shoulders[side]
		local pole = tor:VectorToWorldSpace(Vector3.new(side * 0.8, -0.3, 0.9))
		local el, wr = ik2(shoulder, hand, 1.45 * u, 1.45 * u, pole)
		chain(lst, 1, 1, shoulder, el, right)
		chain(lst, 2, 1, el, wr, right)
		-- fingers: spread + curl
		local d = wr - el
		d = d.Magnitude > 1e-3 and d.Unit or Vector3.new(0, -1, 0)
		local sideV = right - d * right:Dot(d)
		sideV = sideV.Magnitude > 1e-3 and sideV.Unit or Vector3.xAxis
		local upv = d:Cross(sideV)
		upv = upv.Magnitude > 1e-3 and upv.Unit or Vector3.yAxis
		local palm = (side < 0 and S.cover > 0.5) and (headBase * V(0, 0.45, -0.1) - wr) or G.LookVector
		palm = palm.Magnitude > 1e-3 and palm.Unit or G.LookVector
		for k, p in ipairs(fing) do
			local spreadA = (k - (nf + 1) / 2) * 0.26 * S.spread
			local c1 = CFrame.fromAxisAngle(sideV, S.curl) * d
			local c2 = CFrame.fromAxisAngle(sideV, -S.curl) * d
			local v = (c1:Dot(palm) > c2:Dot(palm)) and c1 or c2
			v = CFrame.fromAxisAngle(upv, spreadA) * v
			place(p, boneCF(wr, wr + v * 0.8 * u, sideV))
		end
	end
	avatarCF = CFrame.new(pelvis * V(0, 1.0, 0))
end

-- movement with (optional) wall collision ---------------------------------------------------
local function moveFlat(delta, u)
	if delta.Magnitude < 1e-4 then return end
	if CFG.Noclip then pos += delta return end
	local r = 0.9 * u
	local function blocked(d)
		if d.Magnitude < 1e-4 then return nil end
		for _, hh in ipairs({0.6, 1.5}) do
			local res = workspace:Raycast(pos + Vector3.new(0, hh * u, 0), d.Unit * (d.Magnitude + r), groundP)
			if res and math.abs(res.Normal.Y) < 0.6 then return res end
		end
		return nil
	end
	local res = blocked(delta)
	if not res then pos += delta return end
	local n = Vector3.new(res.Normal.X, 0, res.Normal.Z)
	if n.Magnitude < 1e-3 then return end
	n = n.Unit
	local slide = delta - n * delta:Dot(n)
	if slide.Magnitude > 1e-3 and not blocked(slide) then pos += slide end
end

-- anger: target a player ---------------------------------------------------------------
local function targetHrp(pl)
	local c = pl and pl.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function endRage(why)
	rage = nil
	setRide(false)
	if why then notify(why, 4) end
end
local function startRage(pl)
	if not alive or rage or not pl then return end
	if not targetHrp(pl) then notify("That player has no character", 3) return end
	rage = {t = 0, target = pl, stage = "stand", gt = 0}
	refreshFilters()
	setRide(true)
	notify("Target: " .. pl.DisplayName, 5)
end
local function pickPlayerAt(x, y)
	local ray = cam:ScreenPointToRay(x, y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 3000, tapP)
	if hit then
		local inst = hit.Instance
		while inst and inst ~= workspace do
			local pl = Players:GetPlayerFromCharacter(inst)
			if pl and pl ~= lp then return pl end
			inst = inst.Parent
		end
	end
	local best, bd = nil, 90
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= lp then
			local r = targetHrp(pl)
			if r then
				local v, on = cam:WorldToScreenPoint(r.Position)
				if on then
					local d = (Vector2.new(v.X, v.Y) - Vector2.new(x, y)).Magnitude
					if d < bd then best, bd = pl, d end
				end
			end
		end
	end
	return best
end

-- main step ----------------------------------------------------------------
local function step(dt)
	frameId += 1
	local t = os.clock()
	local u = Kb * CFG.Size
	local e = {t = t, u = u}

	-- calm idle goals (image 1): sitting, curled, face covered, shivering
	local goal = {sit = 1, lean = 1.0, headP = -0.7, headY = 0, jaw = 0, spread = 0.5, curl = 0.85,
		shake = armed and 0.2 or 0.03, hshake = armed and 0.12 or 0, run = 0, cover = 1, wrap = 1, twist = 0, roll = 0,
		hLx = -0.6, hLy = 0.8, hLz = -0.8, hRx = 0.6, hRy = 0.8, hRz = -0.8}
	if t > nextTw then twT = t; nextTw = t + 3 + math.random() * 4 end
	local tw = math.max(0, 1 - (t - twT) / 0.4)
	goal.shake += 0.5 * tw
	goal.lean += math.sin(t * 0.9) * 0.03
	goal.headP += math.sin(t * 0.6) * 0.05

	local speed = CFG.Speed
	local runRate = 0
	if rage then
		rage.t += dt
		local tt = rage.t
		local th = targetHrp(rage.target)
		if not th or not rage.target.Parent then endRage("Target lost - calming down") goto afterRage end
		do
			local to = th.Position - pos
			local flat = Vector3.new(to.X, 0, to.Z)
			local dist = flat.Magnitude
			local want = math.atan2(-flat.X, -flat.Z)
			-- model faces -Z in its own frame; yaw is the rotation about Y
			local face = math.atan2(-flat.X, -flat.Z)
			local turn = (tt > 6.2 and rage.stage == "run") and 10 or 3
			yaw += adiff(face, yaw) * math.min(1, dt * turn)
			local hang = {hLx = -1.15, hLy = 1.35, hLz = -0.9, hRx = 1.15, hRy = 1.35, hRz = -0.9}
			if tt < 1.8 then
				rage.stage = "stand"
				local p = smooth(tt / 1.8)
				goal.sit, goal.lean, goal.headP = 1 - p, lerp(1.0, 0.4, p), lerp(-0.7, -0.1, p)
				goal.cover, goal.wrap = 1 - smooth((tt - 0.2) / 0.7), 1 - smooth((tt - 0.4) / 0.7)
				goal.shake, goal.hshake, goal.curl, goal.spread = 0.3 + 0.3 * p, 0.2, lerp(0.85, 0.5, p), 0.6
				for k, v in pairs(hang) do goal[k] = v end
			elseif tt < 4.0 then
				rage.stage = "shake"
				goal.sit, goal.lean, goal.headP = 0, 0.45, -0.12
				goal.cover, goal.wrap, goal.shake, goal.hshake, goal.curl, goal.spread = 0, 0, 1.0, 1.0, 1.0, 0.6
				for k, v in pairs(hang) do goal[k] = v end
				shake = math.max(shake, 0.8)
			elseif tt < 6.2 then
				rage.stage = "scream"
				goal.sit, goal.lean, goal.headP, goal.jaw = 0, -0.15, 0.7, 1.25
				goal.cover, goal.wrap, goal.shake, goal.hshake, goal.curl, goal.spread = 0, 0, 0.7, 0.2, 0.15, 1.2
				goal.hLx, goal.hLy, goal.hLz, goal.hRx, goal.hRy, goal.hRz = -2.3, 3.0, -1.4, 2.3, 3.0, -1.4
				shake = math.max(shake, 2.0)
				fovKick = math.max(fovKick, 1.0)
			else
				local stopDist = math.max(8, 1.3 * u)
				if rage.stage ~= "grab" then
					rage.stage = "run"
					if dist > stopDist then
						local stepLen = math.min(speed * dt, dist - stopDist + 0.5)
						moveFlat(flat.Unit * stepLen, u)
						runRate = speed / (2 * 2.4 * u)
					else
						rage.stage = "grab"
						rage.gt = 0
					end
				end
				if rage.stage == "run" then
					local sw = math.sin(TAU * ph)
					goal.sit, goal.lean, goal.headP, goal.jaw = 0, 0.55, 0.45, 0.9
					goal.cover, goal.wrap, goal.shake, goal.hshake, goal.run, goal.curl, goal.spread = 0, 0, 0.35, 0.15, 1, 0.3, 1.0
					goal.hLx, goal.hLy, goal.hLz = -0.95, 1.8 + 0.5 * math.abs(sw), -(0.4 + 1.5 * sw)
					goal.hRx, goal.hRy, goal.hRz = 0.95, 1.8 + 0.5 * math.abs(sw), -(0.4 - 1.5 * sw)
				else
					rage.gt += dt
					goal.sit, goal.lean, goal.headP, goal.jaw = 0, 0.4, 0.5, 1.1
					goal.cover, goal.wrap, goal.shake, goal.hshake, goal.curl, goal.spread = 0, 0, 0.5, 0.2, 0.2, 1.3
					goal.hLx, goal.hLy, goal.hLz, goal.hRx, goal.hRy, goal.hRz = -0.8, 3.1, -3.0, 0.8, 3.1, -3.0
					shake = math.max(shake, 0.8)
					if rage.gt > 5 then endRage("He calmed down (tap another player or press Calm)") end
				end
			end
		end
	end
	::afterRage::

	for k, v in pairs(goal) do
		local w, z = 9, 0.8
		if k == "jaw" then w, z = 13, 0.5 elseif k == "shake" or k == "hshake" then w, z = 12, 1
		elseif k == "sit" then w, z = 6, 0.95 elseif k:sub(1, 1) == "h" and #k == 3 then w, z = 11, 0.65 end
		S[k] = spr(k, v, w, z, dt)
	end
	ph = (ph + runRate * dt) % 1

	-- ground
	pos = Vector3.new(pos.X, lerp(pos.Y, groundAt(pos, 6 * u), math.min(1, dt * 12)), pos.Z)

	drawSCP(dt, e)
	if not ride then avatarCF = nil end

	shake = math.max(0, shake - dt * 3)
	fovKick = fovKick * math.exp(-3 * dt)
	pcall(function() cam.FieldOfView = baseFov + 14 * fovKick end)
	camPart.Position = pos + Vector3.new(0, 3 * u, 0)
		+ Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * shake * u * 0.2
	applyTargets()
end

