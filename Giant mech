		p.Material, p.Color = Enum.Material.Slate, Color3.fromRGB(95, 90, 84)
		p.CFrame = CFrame.new(pos + V(0, 0.5, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		p.Parent = workspace
		local a = math.random() * TAU
		debrisList[#debrisList + 1] = {p = p, v = V(math.cos(a), 0, math.sin(a)) * power * (0.3 + math.random()) + V(0, power * (0.5 + math.random()), 0),
			av = V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 8, life = 2.4, gy = pos.Y}
	end
