end

-- rigid position + orientation: the toy snaps exactly onto its bone
local function makeMovers(c)
	local part = c.part
	if not (c.att and c.att.Parent == part) then
		if c.att then c.att:Destroy() end
		local att = Instance.new("Attachment")
		att.Name = "DragonAtt"
		att.Parent = part
		c.att = att
		c.ap, c.ao = nil, nil
	end
	if not (c.ap and c.ap.Parent == part) then
		local ap = Instance.new("AlignPosition")
		ap.Mode = Enum.PositionAlignmentMode.OneAttachment
		ap.Attachment0 = c.att
		ap.RigidityEnabled = true
		ap.Position = part.Position
		ap.Parent = part
		c.ap = ap
	end
	if not (c.ao and c.ao.Parent == part) then
		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = c.att
		ao.RigidityEnabled = true
		ao.CFrame = part.CFrame.Rotation
		ao.Parent = part
		c.ao = ao
	end
end

local function longestAxis(part)
	local s = part.Size
	if s.X >= s.Y and s.X >= s.Z then return 1, s.X end
	if s.Y >= s.X and s.Y >= s.Z then return 2, s.Y end
	return 3, s.Z
end

local function addToy(part, si)
	local axis, len = longestAxis(part)
	local c = { part = part, si = si, oldCollide = part.CanCollide, axis = axis, len = len }
	part.CanCollide = false
	makeMovers(c)
	table.insert(claimed, c)
	claimedSet[part] = c
	return c
end

local function refill()
	for i = #claimed, 1, -1 do
		local c = claimed[i]
		if not c.part.Parent then
			claimedSet[c.part] = nil
			table.remove(claimed, i)
		end
	end
	if #claimed >= #SLOTS then return end
	local used = {}
	for _, c in ipairs(claimed) do used[c.si] = true end
	for _, part in ipairs(getToyParts()) do
		if not claimedSet[part] then
			local si
			for i = 1, #SLOTS do
				if not used[i] then si = i break end
			end
			if not si then break end
			if claim(part) then
				used[si] = true
				addToy(part, si)
			end
		end
	end
end

-- a size at which a leg bone is about as long as your toys
local function fitSize()
	local total, n = 0, 0
	for _, c in ipairs(claimed) do
		total += c.len
		n += 1
	end
	if n == 0 then return nil end
	return math.clamp(math.floor(total / n / 1.7 + 0.5), 3, MAX_SIZE)
end

