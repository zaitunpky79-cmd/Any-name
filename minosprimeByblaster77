local function dismiss()
	skipFlag = true
	aiRun = false
	cutActive, busy = false, false
	cam.CameraType = Enum.CameraType.Custom
	pcall(function() cam.FieldOfView = baseFov end)
	cineHide()
	setFlames(false)
	setRide(false)
	for _, s in ipairs(saved) do
		local p = s.p
		if p and p.Parent then
			pcall(function()
				local bf = p:FindFirstChild("MinosAntiG")
				if bf then bf:Destroy() end
				p.CFrame = s.cf
				p.Anchored = s.anchored
				p.CanCollide = s.collide
				p.Color, p.Material, p.Transparency = s.color, s.material, s.transparency
				p.AssemblyLinearVelocity = V()
			end)
		end
	end
	if camPart then camPart:Destroy() end
	camPart = nil
	pool, slots, saved, lost, heartSlots = {}, {}, {}, {}, {}
	alive, control, targetPl, act, faceTarget = false, false, nil, nil, nil
	liftY, curSp, phase = 0, 0, 1
	cam.CameraSubject = hum
end

local function claimAll(list)
	pcall(function() hum.PlatformStand = true end)
	for i, e in ipairs(list) do
		pcall(function()
			hrp.CFrame = e[1].CFrame
			hrp.AssemblyLinearVelocity = V()
		end)
		if i % 4 == 0 then RunService.Heartbeat:Wait() end
	end
	pcall(function() hum.PlatformStand = false end)
end

local function summon()
	if alive then return end
	local list, dims = gather()
	if not list then notify("Cannot spawn: " .. tostring(dims), 7) return end
	local avail = #list
	if avail < NEED_CORE then
		notify(string.format("Need at least %d bricks (full %d), found %d of %.1fx%.1fx%.1f.", NEED_CORE, NEED_FULL, avail, dims[1], dims[2], dims[3]), 9)
		return
	end
	local home = hrp.CFrame
	notify("Claiming bricks...", 6)
	claimAll(list)
	pcall(function() hrp.CFrame = home; hrp.AssemblyLinearVelocity = V() end)

	cd = V(dims[1], dims[3], dims[2]) -- long side = rig Y
	UN = (cd.X + cd.Y + cd.Z) / 3
	local allCells
	bones, order, allCells, info = layout(cd)
	local drop = {}
	for _, g in ipairs(DROP_ORDER) do
		if totalOf(allCells, drop) <= avail then break end
		drop[g] = true
	end
	local cells = {}
	for _, c in ipairs(allCells) do
		if not (c.opt and drop[c.opt]) then cells[#cells + 1] = c end
	end
	local need = #cells
	pool = {}
	for i = 1, need do pool[i] = list[i][1] end

	slots, saved, heartSlots = {}, {}, {}
	for i, c in ipairs(cells) do
	local p = s.p
		pcall(function() p.Anchored = false; p.CanCollide = false end)
		pcall(function()
			local bf = Instance.new("BodyForce")
			bf.Name = "MinosAntiG"
			bf.Force = V(0, p.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = p
		end)
		pcall(function() p.Material = (s.tag == "hole") and Enum.Material.SmoothPlastic or Enum.Material.Neon end)
	end
	pcall(function() lp.MaximumSimulationRadius = math.huge end)
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)

	camPart = mk("Part", {Anchored = true, CanCollide = false, CanQuery = false, Transparency = 1, Size = V(1, 1, 1)}, workspace)
	refreshFilters()
	oldZoomMax, oldZoomMin = lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance
	baseFov = cam.FieldOfView

	local look = home.LookVector
	look = V(look.X, 0, look.Z)
	look = look.Magnitude > 1e-3 and look.Unit or V(0, 0, -1)
	heading = math.atan2(look.X, look.Z) -- faces you
	local sp0 = home.Position + look * (14 * UN + 12)
	hp = V(sp0.X, 0, sp0.Z)
	gy = groundAt(V(sp0.X, home.Position.Y, sp0.Z), 60)
	curSp, liftY, phase, stam, maxStam = 0, 0, 1, 6, 6
	phAcc, gaitBlend, prevSp, accSm = 0, 0, 0, 0
	control, targetPl = false, nil
	for k in pairs(pose) do pose[k] = 0; poseT[k] = 0 end
	headPos, torsoPos = V(hp.X, gy + 20 * UN, hp.Z), V(hp.X, gy + 15 * UN, hp.Z)
	world = {}
	alive = true
	repaint(0.12, 0)
	runIntro()
	local dropped = {}
	for k in pairs(drop) do dropped[#dropped + 1] = k end
	notify(string.format("Built with %d bricks%s", need, #dropped > 0 and (" (without: " .. table.concat(dropped, ", ") .. ")") or " - full Minos Prime"), 7)
end

-- gait IK ------------------------------------------------------------------------------------------------------------------------------
local function legIK(seg, f, dy)
	local d = math.sqrt(f * f + dy * dy)
	d = clamp(d, 0.3, 2 * seg - 0.02)
	local kneeInt = math.acos(clamp((2 * seg * seg - d * d) / (2 * seg * seg), -1, 1))
	local alpha = math.acos(clamp(d / (2 * seg), -1, 1))
	local phi = math.atan2(f, -dy)
	return phi + alpha, -(math.pi - kneeInt)
end

-- MAIN STEP -----------------------------------------------------------------------------------------------------------------------------
local function step(dt)
	local t = os.clock()
	gy = groundAt(V(hp.X, gy, hp.Z), info.hipY + 40 * UN)
	skillCd = math.max(0, skillCd - dt)
	local effSpeed = SPEED * ((phase == 2) and 1.3 or 1)

	-- 1) movement intent
	local wantDir, tgtSp = nil, 0
	if not (busy or act or cutActive) then
		if control then
			local mv = getMove()
			if mv.Magnitude > 0.1 then wantDir, tgtSp = mv.Unit, effSpeed * math.min(1, mv.Magnitude) end
		elseif targetPl then
			local th = targetHrp(targetPl)
			local tHum = th and th.Parent and th.Parent:FindFirstChildOfClass("Humanoid")
			if not th or not targetPl.Parent then
				targetPl = nil
				notify("Target lost", 3)
			elseif tHum and tHum.Health <= 0 then
				targetPl = nil
				notify("Target down", 3)
			else
				local flat = V(th.Position.X - hp.X, 0, th.Position.Z - hp.Z)
				local dist = flat.Magnitude
				if dist > 1e-3 then wantDir = flat.Unit end
				local keep = 14 * UN
				if dist > keep then tgtSp = effSpeed * smooth((dist - keep) / (4 * UN) + 0.25) end
			end
		end
	end
	if act and faceTarget then
		local th = targetHrp(faceTarget)
		if th then
			local flat = V(th.Position.X - hp.X, 0, th.Position.Z - hp.Z)
			if flat.Magnitude > 1e-3 then
				heading += clamp(adiff(math.atan2(-flat.X, -flat.Z), heading) * math.min(1, dt * 8), -6 * dt, 6 * dt)
			end
		end
	end
	if wantDir then
		local d = adiff(math.atan2(-wantDir.X, -wantDir.Z), heading)
		heading += clamp(d * math.min(1, dt * 4), -3 * dt, 3 * dt)
	end
	local F = F3()
	curSp += (tgtSp - curSp) * math.min(1, dt * ((tgtSp > curSp) and 2.2 or 4))
	if curSp > 0.2 then hp = hp + F * curSp * dt end
	if dashT > 0 then dashT -= dt; hp = hp + F * dashSpd * dt end
	if not act and liftY ~= 0 then liftY += (0 - liftY) * clamp(dt * 8, 0, 1) end

	-- 2) blending
	local kp = clamp(dt * poseRate, 0, 1)
	for key, v in pairs(pose) do pose[key] = v + (poseT[key] - v) * kp end
	p2s += (((phase == 2) and 1 or 0) - p2s) * clamp(dt * 3, 0, 1)
	local ceC = clamp(pose.crouch, 0, 1)
	local kneelF = clamp(pose.kneel, 0, 1)
	local airF = clamp(pose.air, 0, 1)

	-- 3) gait + 2-bone IK
	local sp = math.max(curSp, dashT > 0 and dashSpd or 0)
	local a = clamp(sp / 50, 0, 1)
	local seg = info.seg
	local legLen = 2 * seg
	gaitBlend += (clamp((sp - 1) / 4, 0, 1) - gaitBlend) * clamp(dt * 6, 0, 1)
	local duty = 0.55
	local stepS = clamp(sp * 0.25, 1.2 * UN, 4 * UN)
	local freq = clamp(sp * duty / (2 * stepS), 0, 2.4)
	phAcc += dt * freq
	local ph = phAcc % 1
	local lift = clamp(0.8 * UN + sp * 0.03, 0.8 * UN, 2.2 * UN)
	local acc = (curSp - prevSp) / math.max(dt, 1e-3)
	prevSp = curSp
	accSm += (acc - accSm) * clamp(dt * 5, 0, 1)

	local Hh = info.Fh + legLen * mix(mix(0.94, 0.33, ceC), 0.4, kneelF)
	Hh += gaitBlend * (-0.3 * UN) * (0.5 + 0.5 * math.cos(4 * math.pi * ph))
	Hh += math.sin(t * 1.5) * 0.05 * UN * (1 - gaitBlend)

	local function footTarget(leg, off)
		local u = (ph + off) % 1
		local gf, gl, swingK = 0, 0, 0
		if u < duty then
			gf = stepS - 2 * stepS * (u / duty)
		else
			local k = (u - duty) / (1 - duty)
			gf = -stepS + 2 * stepS * smooth(k)
			gl = lift * math.sin(math.pi * k)
			swingK = k
		end
		local idle = (leg == "L") and 0.8 * UN or -0.6 * UN
		local kneelPos = (leg == "L") and 3.2 * UN or -3.8 * UN
		local f = mix(mix(idle, gf, gaitBlend), kneelPos, kneelF)
		local ly = gl * gaitBlend * (1 - kneelF)
		return f, info.Fh + ly - Hh, swingK
	end
	local fL, dyL, swL = footTarget("L", 0)
	local fR, dyR, swR2 = footTarget("R", 0.5)
	local hL, kL = legIK(seg, fL, dyL)
	local hR, kR = legIK(seg, fR, dyR)
	hL += pose.legLh; kL += pose.legLk
	hR += pose.legRh; kR += pose.legRk
	if airF > 0.001 then
		hL, kL = mix(hL, pose.aLh, airF), mix(kL, pose.aLk, airF)
		hR, kR = mix(hR, pose.aRh, airF), mix(kR, pose.aRk, airF)
	end

	for i, off in ipairs({0, 0.5}) do
		local idx = math.floor(phAcc + off)
		if idx ~= stepIdx[i] then
			stepIdx[i] = idx
			if gaitBlend > 0.5 and airF < 0.2 then shakeFrom(V(hp.X, gy, hp.Z), 0.35 + 0.3 * p2s + 0.3 * a, 0.25, 120 * UN) end
		end
	end

	-- upper body
	local sph, cph = math.sin(2 * math.pi * ph), math.cos(2 * math.pi * ph)
	local breathe = math.sin(t * 1.6) * 0.015
	local accLean = clamp(-accSm * 0.003, -0.15, 0.2)
	local lean = -0.06 - ceC * 0.5 - kneelF * 0.35 - a * 0.2 + accLean + pose.lean + breathe
	local twist = cph * 0.12 * gaitBlend + pose.twist
	local roll = sph * 0.03 * gaitBlend + math.sin(t * 0.8) * 0.012 * (1 - gaitBlend)
	local swArm = math.cos(2 * math.pi * (ph - 0.08)) * gaitBlend
	local armLx = 0.1 + p2s * 0.55 + ceC * 0.3 - swArm * 0.45 + pose.armLx + pose.arm + breathe
	local armRx = 0.1 + p2s * 0.55 + ceC * 0.3 + swArm * 0.45 + pose.armRx + pose.arm - breathe
	local foreL = 0.35 + p2s * 0.9 + kneelF * 0.2 + math.max(0, -swArm) * 0.4 + pose.foreLx
	local foreR = 0.35 + p2s * 0.9 + kneelF * 0.2 + math.max(0, swArm) * 0.4 + pose.foreRx
	local scan = math.sin(t * 0.5) * 0.25 * (1 - p2s) * (1 - kneelF)
	local headX = -lean * 0.6 + 0.12 + pose.head
	local splay = 0.04
	local jitter = shakeOn and math.sin(t * 40) * 0.03 or 0
	local rot = {
		Root = CFrame.Angles(pose.pitch, 0, 0),
		Waist = CFrame.Angles(lean * 0.45, twist * 0.4, roll * 0.4 + jitter),
		Chest = CFrame.Angles(lean * 0.55, twist * 0.6, roll * 0.6 + jitter),
		Head = CFrame.Angles(headX, scan + pose.headY - twist * 0.7, -roll * 0.6),
		ArmL = CFrame.Angles(armLx, 0, -(0.1 + pose.armLz)),
		ArmR = CFrame.Angles(armRx, 0, 0.1 + pose.armRz),
		ForeL = CFrame.Angles(foreL, 0, 0),
		ForeR = CFrame.Angles(foreR, 0, 0),
		ThighL = CFrame.Angles(0, 0, -splay) * CFrame.Angles(hL, 0, 0),
		ThighR = CFrame.Angles(0, 0, splay) * CFrame.Angles(hR, 0, 0),
		ShinL = CFrame.Angles(kL, 0, 0),
		ShinR = CFrame.Angles(kR, 0, 0),
		FootL = CFrame.Angles(-(hL + kL) + 0.28 * math.sin(math.pi * swL) * gaitBlend, 0, 0) * CFrame.Angles(0, 0, splay),
		FootR = CFrame.Angles(-(hR + kR) + 0.28 * math.sin(math.pi * swR2) * gaitBlend, 0, 0) * CFrame.Angles(0, 0, -splay),
	}
	local baseCF = CFrame.new(hp.X, gy + Hh - info.hipY + liftY, hp.Z) * CFrame.Angles(0, heading, 0)

	-- 4) forward kinematics
	local M = {}
	for _, name in ipairs(order) do
		local b = bones[name]
		if b.parent then
			M[name] = M[b.parent] * CFrame.new(b.pv - bones[b.parent].pv) * rot[name]
		else
			M[name] = CFrame.new(b.pv) * rot[name]
		end
		world[name] = baseCF * M[name]
	end
	for _, s in ipairs(slots) do
		s.cf = world[s.bone] * CFrame.new(s.off) * s.orient
	end
	-- nothing may sink into the ground
	local lowest = math.huge
	for _, s in ipairs(slots) do
		local c = s.cf
		local _, _, _, _, _, _, r10, r11, r12 = c:GetComponents()
		local sz = s.p.Size
		local low = c.Position.Y - 0.5 * (math.abs(r10) * sz.X + math.abs(r11) * sz.Y + math.abs(r12) * sz.Z)
		if low < lowest then lowest = low end
	end
	if lowest < gy - 0.02 then
		local shift = V(0, gy - lowest, 0)
		for _, s in ipairs(slots) do s.cf = s.cf + shift end
		for k, w in pairs(world) do world[k] = w + shift end
	end
	headPos = (world.Head * CFrame.new(info.headC - bones.Head.pv)).Position
	torsoPos = (world.Chest * CFrame.new(info.chestC - bones.Chest.pv)).Position
	camPart.Position = headPos + V(0, 0.3 * UN, 0)

	-- heart pulse
	for _, s in ipairs(heartSlots) do
		if s.p.Parent and not cutActive then
			pcall(function() s.p.Color = HEART:Lerp(Color3.new(1, 0.85, 0.85), math.max(0, math.sin(t * (3 + 3 * p2s))) * 0.45) end)
		end
	end

	-- 5) simulation radius, lost bricks
	radT += dt
	if radT > 1 then
		radT = 0
		pcall(function() lp.MaximumSimulationRadius = math.huge end)
		pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)
	end
	lostT += dt
	if lostT > 0.25 and isnetworkowner then
		lostT = 0
		local l2 = {}
		for _, s in ipairs(slots) do
			local ok, own = pcall(isnetworkowner, s.p)
			if ok and not own then l2[#l2 + 1] = s end
		end
		lost = l2
	end
	setRide(not cutActive)
end

-- every frame: pin bricks, then teleport the avatar through every brick (keeps you the closest player)
local function gcd(x, y) while y ~= 0 do x, y = y, x % y end return x end
local function applyTargets()
	for _, s in ipairs(slots) do
		local p = s.p
		if p.Parent and s.cf then
			p.CFrame = s.cf
			p.AssemblyLinearVelocity = V()
			p.AssemblyAngularVelocity = V()
		end
	end
	if ride and hrp and hrp.Parent and #slots > 0 then
		local n = #slots
		local stride = 7
		for _, c in ipairs({7, 5, 3, 1}) do
			if gcd(n, c) == 1 then stride = c break end
		end
		cycle = (cycle + stride) % n
		local pick = slots[cycle + 1]
		if #lost > 0 and cycle % 2 == 0 then pick = lost[(cycle % #lost) + 1] end
		if pick and pick.cf then
			hrp.CFrame = CFrame.new(pick.cf.Position)
			hrp.AssemblyLinearVelocity = V()
			hrp.AssemblyAngularVelocity = V()
		end
	end
end

