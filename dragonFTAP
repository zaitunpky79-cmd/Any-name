----------------------------------------------------------------
-- Pose: the whole dragon skeleton (body space, units, origin on the
-- ground under the body center, +x right, +y up, -z forward)
----------------------------------------------------------------
local function computePose(t, dt, c)
	local rb = runBlend
	local air = c.airW
	local gw = smooth(speedNow / 3) * (1 - air) -- ground gait weight
	local standEff = math.max(standW, danceW)

	-- gait: legs are phase-shifted (walk = 4-beat, run = diagonal trot)
	local Aeff = lerp(1.1, 1.7, rb)
	local d = lerp(0.72, 0.5, rb)
	local A, Hh = Aeff * gw, lerp(0.45, 0.9, rb) * gw
	if speedNow > 0.4 and air < 0.5 then
		phase = (phase + dt * math.pi * d * speedNow / (Aeff * S.size)) % TAU
	end
	local function foot(ph)
		local u = (ph / TAU) % 1
		if u < d then
			local tt = u / d
			local heel = math.clamp((tt - 0.75) / 0.25, 0, 1)
			return A * (1 - 2 * tt), 0, -0.5 * heel * gw
		else
			local tt = (u - d) / (1 - d)
			local e = (1 - math.cos(math.pi * tt)) / 2
			local si = math.sin(math.pi * tt)
			return -A + 2 * A * e, Hh * si, 0.35 * si * gw
		end
	end
	local offs = { FL = lerp(0.25, 0.5, rb), FR = lerp(0.75, 1.0, rb), HL = 0, HR = 0.5 }

	-- emote drivers
	local b = t * math.pi * 4 -- dance beat (2 per second)
	local hb = t * TAU * 1.4 -- happy-jump beat
	local hopY = (math.max(0, math.sin(hb)) * 1.8 - math.max(0, -math.sin(hb)) * 0.5) * hopW
	local swayX = 0.5 * math.sin(b / 2) * danceW

	-- spine ---------------------------------------------------------
	local bodyY = 2.9 + lerp(0.08, 0.16, rb) * gw * math.cos(2 * phase) - 0.7 * c.crouch
	bodyY += -0.22 * c.flap * air -- downstroke lifts the body
	local rock = 0.10 * gw * math.sin(phase + 0.5)
	local hip = V(0.12 * gw * math.sin(phase), bodyY - rock, 1.6)
	local chest = V(-0.12 * gw * math.sin(phase), bodyY + 0.2 + rock, -1.6)
	-- sit: dog-like (hips down, chest up)
	hip = hip:Lerp(V(0, 1.0, 2.0), sitW)
	chest = chest:Lerp(V(0, 3.2, -0.3), sitW)
	-- stand / dance: rear up on the hind legs
	local sBounce = (-0.25 + 0.3 * math.cos(b)) * danceW
	hip = hip:Lerp(V(swayX, 2.9 + sBounce, 1.0), standEff)
	chest = chest:Lerp(V(swayX * 1.4, 6.0 + sBounce, 0.0), standEff)
	-- happy jump
	hip += V(0, hopY, 0)
	chest += V(0, hopY, 0)
	local mid = (hip + chest) / 2
	local axis = (chest - hip)
	axis = axis.Magnitude > 1e-3 and axis.Unit or V(0, 0, -1)

	local J = { hip = hip, chest = chest, mid = mid, seat = mid + V(0, 0.8, 0) }

	-- legs ----------------------------------------------------------
	local sitAnk = { FL = V(-1.0, 0.2, -0.6), FR = V(1.0, 0.2, -0.6), HL = V(-1.5, 0.2, 0.9), HR = V(1.5, 0.2, 0.9) }
	local legAir = c.air2 -- 0..1 tuck
	for _, id in ipairs(LEGIDS) do
		local side = (id:sub(2, 2) == "L") and -1 or 1
		local front = id:sub(1, 1) == "F"
		local s, lift, pt = foot(phase + offs[id] * TAU)
		local ank = V(side * 1.35, 0.2 + lift, (front and -1.5 or 1.5) - s)
		-- tucked in flight
		local tuck = front and V(side * 0.9, bodyY - 1.3, -1.2) or V(side * 0.9, bodyY - 1.0, 2.7)
		ank = ank:Lerp(tuck, legAir)
		ank = ank:Lerp(sitAnk[id], sitW)
		-- stand: hind legs straight down, front arms forward (dance waves them)
		local standAnk
		if front then
			local wave = danceW * math.sin(b + (side > 0 and math.pi or 0))
			standAnk = chest + V(side * 1.2, -1.0 + 1.6 * math.max(0, wave) * 0.9 + 0.3 * wave, -1.3)
		else
			standAnk = V(side * 1.2, 0.2 + 0.3 * math.max(0, side * math.sin(b / 2)) * danceW, 1.3)
		end
		ank = ank:Lerp(standAnk, standEff)
		ank += V(0, math.max(0, hopY) * 0.9, 0) -- legs follow the body in a hop
		local topBase = front and chest or hip
		local top = topBase + V(side * 1.05, -0.15, 0)
		local pole = front and V(side * 0.6, 0.0, 0.9) or V(side * 0.5, 0.25, -0.9)
		if not front then pole = pole:Lerp(V(side * 1, 1, -0.3), sitW) end
		if front then pole = pole:Lerp(V(side * 0.6, 0.8, 0.3), standEff) end
		J["top" .. id] = top
		J["knee" .. id] = ik(top, ank, pole, LEG)
		J["ank" .. id] = ank
		J["toe" .. id] = ank + V(0, 0.65 * math.sin(pt) - 0.15, -0.7 * math.cos(pt))
	end

	-- neck + head ---------------------------------------------------
	local fire = fireW
	local nP = { 1.05, 0.6, -0.1 }
	local flightP = { 0.35, 0.12, 0.0 }
	local sitP = { 1.25, 0.85, 0.2 }
	local standP = { 0.95, 0.35, 0.0 }
	local fireP = { 1.3, 1.0, 0.4 }
	local nY = {}
	for i = 1, 3 do
		local pt = nP[i]
		pt = lerp(pt, flightP[i], air)
		pt = lerp(pt, sitP[i], sitW)
		pt = lerp(pt, standP[i], standEff)
		pt = lerp(pt, fireP[i], fire)
		pt += 0.07 * gw * math.sin(2 * phase - i * 0.6) + 0.12 * hopW * math.sin(hb * 2 - i * 0.5)
		pt += 0.12 * danceW * math.sin(b - i * 0.5)
		nP[i] = pt
		nY[i] = (0.18 * math.sin(t * 0.7 - i * 0.5) * (1 - 0.7 * air) + c.turn * 0.4 * (i / 3)) * (1 - fire)
		nY[i] += 0.25 * danceW * math.sin(b / 2 - i * 0.4)
	end
	local n0 = chest + axis * 0.5 + V(0, 0.2, 0)
	local d1, d2, d3 = dirYP(nY[1], nP[1]), dirYP(nY[2], nP[2]), dirYP(nY[3], nP[3])
	J.n0 = n0
	J.n1 = n0 + d1 * 1.5
	J.n2 = J.n1 + d2 * 1.4
	J.n3 = J.n2 + d3 * 1.2
	local headPitch = nP[3] - 0.2 + 0.5 * fire
	local hd = dirYP(nY[3], headPitch)
	J.hd = hd
	J.snout = J.n3 + hd * 1.6
	-- jaw: breathes, opens for fire, grins when happy, sings when dancing
	local jawOpen = 0.05 + 0.03 * math.sin(t * 1.2) + 0.8 * fire + 0.35 * hopW + danceW * (0.3 + 0.2 * math.sin(b))
	J.jawBase = J.n3 + hd * 0.2 + V(0, -0.15, 0)
	J.jawTip = J.jawBase + dirYP(nY[3], headPitch - jawOpen) * 1.4
	local hr = hd:Cross(V(0, 1, 0))
	hr = hr.Magnitude > 1e-3 and hr.Unit or V(1, 0, 0)
	J.hornBase, J.hornTip, J.eye = {}, {}, {}
	for i, sgn in ipairs({ -1, 1 }) do
		J.hornBase[i] = J.n3 + hd * 0.3 + V(0, 0.35, 0) + hr * (0.3 * sgn)
		J.hornTip[i] = J.hornBase[i] + (-hd * 0.6 + V(0, 0.8, 0) + hr * (0.35 * sgn)).Unit * 1.4
		J.eye[i] = J.n3 + hd * 0.95 + V(0, 0.4, 0) + hr * (0.42 * sgn)
	end

	-- tail: a chain that waves; swishes against turns ---------------
	local mv = math.clamp(speedNow / 30, 0, 1)
	local tailYaw, tailDown = { 0.12, 0.12, 0.12, 0.12, 0.12 }, { 0.18, 0.12, 0.06, 0.02, 0.0 }
	local acc, accP = 0, 0
	local prev = hip
	J.t0 = hip
	local lens = { 1.6, 1.5, 1.4, 1.2, 1.0 }
	local wag = 1 + 3 * hopW + danceW * 1.2
	for i = 1, 5 do
		local delta = (0.10 + 0.14 * mv + 0.12 * air) * math.sin(t * 1.6 * wag - i * 0.7) - c.turn * 0.12
		delta = lerp(delta, 0.4, sitW) -- sit: tail curls beside the body
		acc += delta
		local down = tailDown[i]
		down = lerp(down, -0.1 - i * 0.03, air)
		down = lerp(down, 0.3, sitW)
		down = lerp(down, 0.35 + i * 0.05, standEff)
		prev = prev + dirBack(acc, down) * lens[i]
		if air < 0.5 then prev = V(prev.X, math.max(prev.Y, 0.3), prev.Z) end
		J["t" .. i] = prev
	end

	-- wings -----------------------------------------------------------
	local e = math.max(c.wingE, 0.55 * hopW, 0.6 * danceW)
	local amp = c.amp
	if hopW > 0.01 or danceW > 0.01 then amp = math.max(amp, 0.45) end
	local bias = c.bias
	local ph = flapPh
	local p1 = bias + amp * 0.6 * math.sin(ph)
	local p2 = bias * 1.2 + amp * 0.9 * math.sin(ph - 0.7)
	local p3 = bias * 1.4 + amp * 1.2 * math.sin(ph - 1.4)
	local hUnf, hFold = V(1, 0.25, -0.35).Unit, V(0.12, 0.55, 0.8).Unit
	local fUnf, fFold = V(1, 0.05, 0.55).Unit, V(0.0, 0.15, 1).Unit
	local sUnf = { V(1, 0.1, -0.25), V(0.85, 0, 0.45), V(0.55, -0.08, 0.85), V(0.25, -0.12, 1) }
	local sFold = { V(0.15, 0.25, 1), V(0.1, 0.15, 1), V(0.08, 0.05, 1), V(0.04, -0.05, 1) }
	local sLen = { 3.4, 3.6, 3.2, 2.4 }
	for _, side in ipairs({ -1, 1 }) do
		local key = (side < 0) and "L" or "R"
		local function m(v) return V(v.X * side, v.Y, v.Z) end -- mirror the right wing
		local S0 = V(1.1, chest.Y + 0.9, chest.Z + 0.4)
		local E = S0 + rotZ(hFold:Lerp(hUnf, e).Unit, p1) * 2.0
		local Wr = E + rotZ(fFold:Lerp(fUnf, e).Unit, p2) * 2.2
		J["wS" .. key], J["wE" .. key], J["wW" .. key] = m(S0), m(E), m(Wr)
		for i = 1, 4 do
			J["wF" .. i .. key] = m(Wr + rotZ(sFold[i]:Lerp(sUnf[i], e).Unit, p3) * sLen[i])
		end
		J["wB" .. key] = V(0.8 * side, hip.Y + 0.3, hip.Z - 0.6)
	end

	-- feet on the ground never pass through it; toes follow
	return J
end

----------------------------------------------------------------
-- Control / camera / ride
----------------------------------------------------------------
local function restoreHum()
	if savedHum and savedHum.hum and savedHum.hum.Parent then
		local h = savedHum.hum
		h.WalkSpeed = savedHum.WalkSpeed
		h.JumpPower = savedHum.JumpPower
		h.JumpHeight = savedHum.JumpHeight
	end
	savedHum = nil
end

local function freezeHum(hum)
	if savedHum and savedHum.hum == hum then return end
	restoreHum()
	savedHum = {
		hum = hum,
		WalkSpeed = hum.WalkSpeed,
		JumpPower = hum.JumpPower,
		JumpHeight = hum.JumpHeight,
	}
	hum.WalkSpeed = 0 -- your joystick steers the dragon, not your avatar
	hum.JumpPower = 0
	hum.JumpHeight = 0
end

local function applyControl(hum)
	freezeHum(hum)
	if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
	-- riding: the camera follows you (you travel with the dragon)
	local want = hum
	if camPart and S.camFollow and not rideWeld then want = camPart end
	if lastSubject ~= want then
		cam.CameraSubject = want
		lastSubject = want
	end
	local zoom = S.camFollow and S.size * 8 or origZoom.min
	if lastZoom ~= zoom then
		lp.CameraMinZoomDistance = zoom
		lp.CameraMaxZoomDistance = math.max(origZoom.max, S.size * 55)
		lastZoom = zoom
	end
end

-- the joystick direction in the world (falls back to the controls module
-- because a seated humanoid may not update MoveDirection)
local function getMove(hum)
	local md = hum.MoveDirection
	if md.Magnitude > 0.05 then return V(md.X, 0, md.Z) end
	if controls then
		local ok, mv = pcall(function() return controls:GetMoveVector() end)
		if ok and mv and mv.Magnitude > 0.05 then
			local wv = cam.CFrame:VectorToWorldSpace(V(mv.X, 0, mv.Z))
			wv = V(wv.X, 0, wv.Z)
			if wv.Magnitude > 0.01 then return wv.Unit * math.min(1, mv.Magnitude) end
		end
	end
	return V(0, 0, 0)
end

local function mount()
	if rideWeld or not S.active then return end
	local root, hum = getRoot(), getHum()
	local saddle
	for _, c in ipairs(claimed) do
		if c.si == 1 then saddle = c end
	end
	if not (root and hum and saddle and saddle.part.Parent and lastSeat) then
		setStatus("no saddle toy yet")
		return
	end
	-- put the avatar on the saddle ONCE, then glue it with a physics weld
	root.CFrame = lastSeat
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	local w = Instance.new("WeldConstraint")
	w.Part0 = saddle.part
	w.Part1 = root
	w.Parent = saddle.part
	rideWeld = w
	hum.Sit = true
	setStatus("riding")
end

local function dismount(bodyCF)
	if rideWeld then
		rideWeld:Destroy()
		rideWeld = nil
	end
	local root, hum = getRoot(), getHum()
	if hum then hum.Sit = false end
	if root then
		local side = bodyCF and (pos + bodyCF.RightVector * (4 * S.size) + V(0, 4, 0)) or (root.Position + V(0, 4, 0))
		root.CFrame = CFrame.new(side)
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

----------------------------------------------------------------
-- Actions
----------------------------------------------------------------
local lastBodyCF
local function setEmote(name)
	if not S.active then return end
	if name and (S.flyGoal or vel.Y ~= 0 and false) then
		setStatus("land first")
		return
	end
	S.emote = (S.emote == name) and nil or name
	for n, b in pairs(emoteBtns) do
		b.BackgroundColor3 = (n == S.emote) and Color3.fromRGB(70, 110, 200) or Color3.fromRGB(52, 52, 66)
	end
	setStatus(S.emote and ("emote: " .. S.emote) or "ready")
end

local function setFly(on)
	if not S.active then return end
	S.flyGoal = on
	if on then
		S.emote = nil
		for _, b in pairs(emoteBtns) do b.BackgroundColor3 = Color3.fromRGB(52, 52, 66) end
		if pos.Y - (lastGroundY or pos.Y) < 1 then
			launchT0 = tick()
			climbUntil = tick() + 3
		end
	end
	flyBtn.Text = "Fly: " .. (on and "ON" or "OFF")
	flyBtn.BackgroundColor3 = on and Color3.fromRGB(70, 110, 200) or Color3.fromRGB(52, 52, 66)
	setStatus(on and "taking off" or "landing")
end

local function breatheFire()
	if not S.active then return end
	fireUntil = tick() + 2.4
	setStatus("fire!")
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
lastGroundY = nil

local function step(dt)
	local root, hum = getRoot(), getHum()
	if not root or not hum then return end
	local t = tick()
	local sz = S.size

	applyControl(hum)
	if rideWeld and not hum.Sit then hum.Sit = true end

	-- ground height under the dragon
	local ignore = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ignore, folder) end
	if skin then table.insert(ignore, skin.model) end
	rayParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(V(pos.X, pos.Y + 8 * sz, pos.Z), V(0, -4000, 0), rayParams)
	local gy = hit and hit.Position.Y or pos.Y
	lastGroundY = gy
	local alt = math.max(0, pos.Y - gy)
	local inAir = S.flyGoal or alt > 0.4

	-- input
	local mv = getMove(hum)
	local moveInput = mv.Magnitude > 0.1
	if moveInput and S.emote then
		S.emote = nil -- moving cancels an emote
		for _, b in pairs(emoteBtns) do b.BackgroundColor3 = Color3.fromRGB(52, 52, 66) end
	end

	-- emote weights
	local function toward(cur, goal, rate) return cur + (goal - cur) * (1 - math.exp(-dt * rate)) end
	sitW = toward(sitW, (S.emote == "sit") and 1 or 0, 3)
	hopW = toward(hopW, (S.emote == "hop") and 1 or 0, 5)
	standW = toward(standW, (S.emote == "stand") and 1 or 0, 3)
	danceW = toward(danceW, (S.emote == "dance") and 1 or 0, 3)
	fireW = toward(fireW, (t < fireUntil) and 1 or 0, 6)

	local flySpeed = 14 * sz * S.speedMul
	local ctx = { crouch = 0, flap = 0, amp = 0.15, bias = 0.0, wingE = 0, turn = 0 }
	local newYaw = yaw

	if not inAir then
		-- ======== GROUND ========
		local runOn = S.run
		local target = 0
		if moveInput and not S.emote then
			target = (runOn and 10 or 4) * sz * S.speedMul
		end
		speedNow = toward(speedNow, target, 5)
		runBlend = toward(runBlend, (runOn and moveInput) and 1 or 0, 4)
		if moveInput and not S.emote then
			local want = math.atan2(-mv.X, -mv.Z)
			local diff = (want - yaw + math.pi) % TAU - math.pi
			local step = math.clamp(diff, -2.6 * dt, 2.6 * dt)
			newYaw = yaw + step
			ctx.turn = math.clamp(step / math.max(dt, 1e-3) / 2.6, -1, 1)
		end
		local facing = V(-math.sin(yaw), 0, -math.cos(yaw))
		pos += facing * speedNow * dt
		pos = V(pos.X, pos.Y + (gy - pos.Y) * math.min(1, dt * 15), pos.Z)
		vel = facing * speedNow
		pitch = toward(pitch, 0, 6)
		roll = toward(roll, 0, 6)
		ctx.airW = 0
		ctx.air2 = 0
		ctx.wingE = 0.02
		ctx.amp, ctx.bias = 0.05, 0.05
	else
		-- ======== AIR (takeoff / flight / landing) ========
		local launchP = (t - launchT0)
		local crouching = S.flyGoal and launchP < 0.45 and alt < 1
		local tv
		local autoOn = S.auto and S.flyGoal
		if autoOn then
			if not autoTarget or (autoTarget - pos).Magnitude < 15 * sz or t > autoUntil then
				local ang = math.random() * TAU
				local rad = math.random(40, 140) * sz / 5 * 2
				autoTarget = V(homePos.X + math.cos(ang) * rad, gy + math.random(25, 80) * sz / 5, homePos.Z + math.sin(ang) * rad)
				autoUntil = t + 16
			end
			local dvec = autoTarget - pos
			tv = (dvec.Magnitude > 1e-3 and dvec.Unit or V(0, 0, 0)) * (flySpeed * 0.75)
		elseif S.flyGoal then
			local vIn = (S.upHeld and 1 or 0) - (S.downHeld and 1 or 0)
			local vy = vIn * flySpeed * 0.6
			if t < climbUntil and not crouching then vy = math.max(vy, flySpeed * 0.5) end
			if crouching then vy = 0 end
			tv = V(mv.X * flySpeed, vy, mv.Z * flySpeed)
			if crouching then tv = V(0, 0, 0) end
		else
			-- landing: slow down and come straight down
			local descend = -math.clamp(alt * 0.8, 6, flySpeed * 0.45)
			tv = V(0, descend, 0)
		end
		vel = vel:Lerp(tv, 1 - math.exp(-dt * 1.8))
		pos += vel * dt
		if S.safe then
			local floorY = workspace.FallenPartsDestroyHeight + 100
			if pos.Y < floorY then pos = V(pos.X, floorY, pos.Z) end
		end
		if pos.Y < gy then
			pos = V(pos.X, gy, pos.Z)
			vel = V(vel.X, math.max(vel.Y, 0), vel.Z)
		end

		local hv = V(vel.X, 0, vel.Z)
		local hsp = hv.Magnitude
		speedNow = toward(speedNow, 0, 6)
		if hsp > 2 then
			local want = math.atan2(-hv.X, -hv.Z)
			local diff = (want - yaw + math.pi) % TAU - math.pi
			local step = math.clamp(diff, -2.2 * dt, 2.2 * dt)
			newYaw = yaw + step
			ctx.turn = math.clamp(step / math.max(dt, 1e-3) / 2.2, -1, 1)
		end
		-- pitch: nose up when climbing, down when speeding; bank into turns
		pitch = toward(pitch, math.clamp(vel.Y / flySpeed, -1, 1) * 0.5 - math.clamp(hsp / flySpeed, 0, 1) * 0.22, 3)
		roll = toward(roll, math.clamp(-ctx.turn * 0.55, -0.6, 0.6), 4)

		ctx.airW = smooth(alt / (3 * sz))
		ctx.air2 = ctx.airW
		local effort = math.clamp(math.max(vel.Y / (flySpeed * 0.5), 0) + (hsp < flySpeed * 0.3 and 0.6 or 0), 0, 1)
		if crouching then
			ctx.crouch = smooth(launchP / 0.45)
			ctx.wingE, ctx.amp, ctx.bias = 0.85, 0.5, 0.5
			ctx.air2 = 0
		elseif S.flyGoal then
			ctx.wingE = 1
			ctx.amp = 0.3 + 0.55 * effort
			ctx.bias = 0.12
		else
			ctx.wingE = 1 -- air-brake while landing
			ctx.amp, ctx.bias = 0.3, 0.55
		end
		if alt < 0.5 and not S.flyGoal then
			vel = Vector3.zero
		end
		local omega = TAU * (1.1 + 0.5 * (ctx.amp > 0.5 and 1 or 0))
		flapPh += dt * omega
		ctx.flap = math.cos(flapPh)
		ctx.speedH = hsp
	end
	yawRate = (newYaw - yaw) / math.max(dt, 1e-3)
	yaw = newYaw

	-- ground flap (fluttering wings for emotes) runs here too
	if not inAir then
		local omega = TAU * (hopW > 0.1 and 2.2 or (danceW > 0.1 and 1.8 or 1.0))
		flapPh += dt * omega
		ctx.flap = math.cos(flapPh)
		if hopW > 0.1 or danceW > 0.1 then ctx.amp = 0.45 end
	end

	-- the pose and the body frame (tilted around the body center)
	local J = computePose(t, dt, ctx)
	local cY = 2.9 * sz
	local bodyCF = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
		* CFrame.new(0, cY, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, roll) * CFrame.new(0, -cY, 0)
	lastBodyCF = bodyCF
	local function W(pt) return bodyCF:PointToWorldSpace(pt * sz) end

	-- rider seat
	lastSeat = CFrame.new(W(J.seat) + bodyCF.UpVector * 1.6 + bodyCF.UpVector * 0.8 * sz) * bodyCF.Rotation

	if S.skin and skin then updateSkin(J, bodyCF) end

	-- camera anchor; keep homePos when riding or not auto
	if camPart then camPart.CFrame = CFrame.new(pos + V(0, 3.2 * sz, 0)) end
	if not S.auto then homePos = pos end

	-- indestructible upkeep
	if S.safe then
		safeTimer += dt
		if safeTimer >= 0.1 and #claimed > 0 then
			safeTimer = 0
			reclaimIdx = reclaimIdx % #claimed + 1
			local c = claimed[reclaimIdx]
			if c.part.Parent then
				if not ownsPart(c.part) then claim(c.part) end
				c.part.CanCollide = false
			end
		end
		refillTimer += dt
		if refillTimer >= 1.5 then
			refillTimer = 0
			refill()
		end
	end

	-- toys: centered on their skin bone, long axis rotated along it
	for _, c in ipairs(claimed) do
		local part = c.part
		if part.Parent then
			local s = SLOTS[c.si]
			local pa, pb = J[s.a], J[s.b]
			local tgt = W((pa + pb) / 2)
			local rot = basisFor(bodyCF:VectorToWorldSpace(pb - pa), bodyCF:VectorToWorldSpace(V(0, 1, 0)), c.axis)
			if S.safe then
				makeMovers(c)
				if part.AssemblyLinearVelocity.Magnitude > 600 + sz * 60 then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
				if (part.Position - tgt).Magnitude > 400 and not (rideWeld and c.si == 1) then
					part.CFrame = CFrame.new(tgt) * rot
				end
			end
			c.ap.Position = tgt
			c.ao.CFrame = rot
			end
	end
end

----------------------------------------------------------------
-- Summon / release
----------------------------------------------------------------
local function release()
	S.active = false
	S.emote = nil
	S.flyGoal = false
	if heartbeat then heartbeat:Disconnect() heartbeat = nil end
	dismount(lastBodyCF)
	for _, c in ipairs(claimed) do
		if c.ap then c.ap:Destroy() end
		if c.ao then c.ao:Destroy() end
		if c.att then c.att:Destroy() end
		if c.part and c.part.Parent then c.part.CanCollide = c.oldCollide end
	end
	claimed, claimedSet = {}, {}
	destroySkin()
	restoreHum()
	cam.CameraType = Enum.CameraType.Custom
	local hum = getHum()
	if hum then cam.CameraSubject = hum end
	lastSubject = nil
	if origZoom then
		lp.CameraMinZoomDistance = origZoom.min
		lp.CameraMaxZoomDistance = origZoom.max
	end
	lastZoom = nil
	if camPart then camPart:Destroy() camPart = nil end
	if buildBtn then buildBtn.Text = "Summon Dragon" end
	setStatus("released")
end

local function setSize(v)
	S.size = math.clamp(v, 3, MAX_SIZE)
	sizeLabel.Text = "Size: " .. S.size
	lastZoom = nil
	if S.active and S.skin then buildSkin() end
end

local function build()
	if S.busy or S.active then return end
	local root = getRoot()
	if not root then setStatus("no character") return end

	local parts = getToyParts()
	if #parts == 0 then setStatus("no toys found") return end

	S.busy = true
	setStatus("claiming toys...")
	local origin = root.CFrame
	local teleported = false

	for i = 1, math.min(#SLOTS, #parts) do
		local part = parts[i]
		if part.Parent then
			if (part.Position - root.Position).Magnitude > 30 then
				root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
				teleported = true
				task.wait(0.08)
			end
			if claim(part) then
				addToy(part, #claimed + 1)
			end
		end
	end
	if teleported then root.CFrame = origin end

	if #claimed == 0 then
		S.busy = false
		setStatus("no toys claimed")
		return
	end

	-- size the skin to your toys so every toy is as long as its bone
	local fit = fitSize()
	if fit then S.size = fit end
	sizeLabel.Text = "Size: " .. S.size

	-- appear in front of you, facing you
	local look = root.CFrame.LookVector
	local flat = V(look.X, 0, look.Z)
	flat = flat.Magnitude > 1e-3 and flat.Unit or V(0, 0, -1)
	yaw = math.atan2(flat.X, flat.Z) -- faces back toward you
	local spot = root.Position + flat * (S.size * 12)
	local ign = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ign, folder) end
	rayParams.FilterDescendantsInstances = ign
	local hit = workspace:Raycast(V(spot.X, root.Position.Y + 30, spot.Z), V(0, -500, 0), rayParams)
	pos = V(spot.X, hit and hit.Position.Y or (root.Position.Y - 3), spot.Z)
	vel, speedNow, runBlend, phase = Vector3.zero, 0, 0, 0
	pitch, roll, yawRate = 0, 0, 0
	sitW, hopW, standW, danceW, fireW = 0, 0, 0, 0, 0
	homePos = pos
	S.flyGoal, S.emote = false, nil

	origZoom = origZoom or { min = lp.CameraMinZoomDistance, max = lp.CameraMaxZoomDistance }
	camPart = Instance.new("Part")
	camPart.Name = "DragonCam"
	camPart.Anchored = true
	camPart.CanCollide = false
	camPart.CanQuery = false
	camPart.CanTouch = false
	camPart.Transparency = 1
	camPart.Size = V(1, 1, 1)
	camPart.CFrame = CFrame.new(pos + V(0, 3.2 * S.size, 0))
	camPart.Parent = workspace

	if S.skin then buildSkin() end

	S.active = true
	buildBtn.Text = "Dismiss Dragon"
	setStatus(("ready (%d toys)"):format(#claimed))
	heartbeat = RunService.Heartbeat:Connect(step)
	S.busy = false
	if S.ride then task.delay(0.6, mount) end
end

