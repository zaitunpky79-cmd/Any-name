-- step helpers that read the rig (called from step) ---------------------------------------------------------
local function updateAmmo(dt)
	local H = geo.height
	for i = 1, 10 do
		local st, s = A[i], ammoSlots[i]
		if st and s and s.rigCF then
			if st.mode == "fly" then
				st.t += dt
				local u = clamp(st.t / st.dur, 0, 1)
				local pos = bez3(st.p0, st.p1, st.p2, st.p3, u)
				local nxt = bez3(st.p0, st.p1, st.p2, st.p3, math.min(u + 0.03, 1))
				local d = nxt - pos
				d = d.Magnitude > 1e-3 and d.Unit or V(0, -1, 0)
				s.cf = CFrame.new(pos) * dirCF(d) * s.orient
				if u >= 1 then
					st.mode = "spent"
					st.cf = CFrame.new(st.p3 + V(0, 0.5 * L, 0)) * CFrame.Angles((math.random() - 0.5) * 0.7, math.random() * TAU, (math.random() - 0.5) * 0.7) * s.orient
					boom(st.p3, H * 0.22, Color3.fromRGB(255, 150, 50))
					shockwave(st.p3, H * 0.3, Color3.fromRGB(255, 160, 70))
					dust(st.p3, 14, H * 0.12)
					spawnDebris(st.p3, 4, H * 0.5, H * 0.02)
					shakeFrom(st.p3, 0.7, 0.35, H * 7)
					reloadAuto = os.clock() + 1.2
				end
			elseif st.mode == "spent" then
				s.cf = st.cf
			elseif st.mode == "ret" then
				st.t += dt
				if st.t < 0 then
					s.cf = st.cf
				else
					local u = clamp(st.t / st.dur, 0, 1)
					local e = smooth(u)
					local tgt = s.rigCF.Position
					local pos = bez3(st.p0, st.p0 + V(0, H * 0.8, 0), tgt + V(0, H * 0.6, 0), tgt, e)
					local nxt = bez3(st.p0, st.p0 + V(0, H * 0.8, 0), tgt + V(0, H * 0.6, 0), tgt, math.min(e + 0.03, 1))
					local d = nxt - pos
					d = d.Magnitude > 1e-3 and d.Unit or V(0, 1, 0)
					s.cf = CFrame.new(pos) * dirCF(d) * s.orient
					if u >= 1 then st.mode = "rack"; s.cf = s.rigCF end
				end
			end
		end
	end
	if reloadAuto > 0 and os.clock() > reloadAuto then
		reloadAuto = 0
		local anyFly, anyReady = false, false
		for i = 1, 10 do
			if A[i].mode == "fly" then anyFly = true end
			if A[i].mode == "rack" then anyReady = true end
		end
		if not anyFly and not anyReady then reloadAmmo() end
	end
end

local function updateLaser(dt, torsoW)
	if not laser then return end
	local H = geo.height
	laser.t += dt
	local t = laser.t
	local muzzle = (torsoW * CFrame.new(geo.muzzleRel)).Position
	local desired = (aimPoint() - muzzle)
	desired = desired.Magnitude > 1e-3 and desired.Unit or V(0, 0, -1)
	laser.dir = laser.dir and laser.dir:Lerp(desired, clamp(dt * 2.5, 0, 1)) or desired
	if laser.dir.Magnitude < 1e-3 then laser.dir = desired end
	local dir = laser.dir.Unit
	local n = #laser.ids
	local up0 = (math.abs(dir.Y) > 0.98) and V(1, 0, 0) or V(0, 1, 0)
	local right = dir:Cross(up0).Unit
	local up = right:Cross(dir).Unit
	local Lbeam = H * 3.2
	local T1, T2, T3 = 1.1, 2.6, 0.8
	laser.spin += dt * ((t < T1) and (4 + 26 * (t / T1)) or 16)
	for j, i in ipairs(laser.ids) do
		local s = ammoSlots[i]
		local rigPos = s.rigCF.Position
		local pos, cf
		if t < T1 then
			local e = smooth(t / 0.55)
			local ang = (j / n) * TAU + laser.spin
			local R = H * 0.1 * (1 - 0.35 * (t / T1))
			local ringPos = muzzle + dir * (H * 0.12) + (right * math.cos(ang) + up * math.sin(ang)) * R
			pos = rigPos:Lerp(ringPos, e) + V(0, math.sin(e * math.pi) * H * 0.25, 0)
			cf = CFrame.new(pos) * dirCF(dir) * CFrame.Angles(0, ang, 0)
		elseif t < T1 + T2 then
			local t1 = t - T1
			local frac = (((j - 1) / n) + t1 * 1.4) % 1
			pos = muzzle + dir * (H * 0.1 + frac * Lbeam)
			cf = CFrame.new(pos) * dirCF(dir) * CFrame.Angles(0, laser.spin + j, 0)
		else
			local u = clamp((t - T1 - T2) / T3, 0, 1)
			local e = smooth(u - (j - 1) / n * 0.25)
			local frac = (((j - 1) / n) + T2 * 1.4) % 1
			local from = muzzle + dir * (H * 0.1 + frac * Lbeam)
			pos = from:Lerp(rigPos, e) + V(0, math.sin(e * math.pi) * H * 0.3, 0)
			cf = CFrame.new(pos) * dirCF((rigPos - from).Magnitude > 1 and (rigPos - from).Unit or dir) * CFrame.Angles(0, laser.spin, 0)
		end
		s.cf = cf * s.orient
	end
	-- local visuals
	if laserOrb then
		local r = (t < T1) and mix(0.5, H * 0.14, smooth(t / T1)) or ((t < T1 + T2) and H * 0.16 or mix(H * 0.16, 0.5, smooth((t - T1 - T2) / T3)))
		laserOrb.Size = V(r, r, r)
		laserOrb.Position = muzzle + dir * (H * 0.1)
	end
	if laserBeam then
		if t >= T1 and t < T1 + T2 then
			local endP = muzzle + dir * Lbeam
			local mid = (muzzle + endP) / 2
			laserBeam.Size = V(Lbeam, H * 0.035 * (0.8 + 0.4 * math.random()), H * 0.035)
			laserBeam.CFrame = CFrame.lookAt(mid, endP) * CFrame.Angles(0, math.pi / 2, 0)
			laserBeam.Transparency = 0.45 + 0.2 * math.random()
		else
			laserBeam.Transparency = 1
		end
	end
	if t >= T1 and not laser.fired then
		laser.fired = true
		boom(muzzle + dir * (H * 0.12), H * 0.3, Color3.fromRGB(150, 240, 255))
		shockwave(V(hp.X, gy, hp.Z), H * 1.2, Color3.fromRGB(120, 235, 255))
		shakeFrom(muzzle, 1.4, 2.4, H * 9)
		recoil = 1.6
	end
	if t >= T1 + T2 + T3 then endLaser() end
end

