local function assign(infos)
	local Ls, Fs = {}, {}
	for _, info in ipairs(infos) do
		table.insert(info.kind == "L" and Ls or Fs, info)
	end
	table.sort(Ls, function(a, b) return a.len > b.len end)
	table.sort(Fs, function(a, b) return a.len > b.len end)
	local result, open = {}, {}
	for si, slot in ipairs(SLOTS) do
		local list = (slot.pref == "L") and Ls or Fs
		if #list > 0 then
			result[si] = table.remove(list, 1)
		else
			table.insert(open, si)
		end
	end
	for _, si in ipairs(open) do
		result[si] = table.remove(Ls, 1) or table.remove(Fs, 1)
	end
	return result
end

local function makeMovers(c)
	local part = c.part
	if not (c.att and c.att.Parent == part) then
		if c.att then c.att:Destroy() end
		local att = Instance.new("Attachment")
		att.Name = "MechaAtt"
		att.Parent = part
		c.att = att
		c.ap, c.ao = nil, nil
	end
	if not (c.ap and c.ap.Parent == part) then
		local ap = Instance.new("AlignPosition")
		ap.Mode = Enum.PositionAlignmentMode.OneAttachment
		ap.Attachment0 = c.att
		ap.RigidityEnabled = true
		ap.Position = part.Position
		ap.Parent = part
		c.ap = ap
	end
	if not (c.ao and c.ao.Parent == part) then
		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = c.att
		ao.RigidityEnabled = true
		ao.CFrame = part.CFrame.Rotation
		ao.Parent = part
		c.ao = ao
	end
end

local function addToy(info, si)
	local part = info.part
	local c = {
		part = part, si = si, id = SLOTS[si].id, oldCollide = part.CanCollide,
		kind = info.kind, aL = info.aL, aM = info.aM, aT = info.aT, len = info.len,
	}
	part.CanCollide = false
	makeMovers(c)
	table.insert(claimed, c)
	claimedSet[part] = c
	return c
end

local function refill()
	for i = #claimed, 1, -1 do
		local c = claimed[i]
		if not c.part.Parent then
			claimedSet[c.part] = nil
			table.remove(claimed, i)
		end
	end
	if #claimed >= #SLOTS then return end
	local used = {}
	for _, c in ipairs(claimed) do used[c.si] = true end
	local fresh = {}
	for _, info in ipairs(getToyInfos()) do
		if not claimedSet[info.part] then table.insert(fresh, info) end
	end
	for si = 1, #SLOTS do
		if not used[si] and #fresh > 0 then
			local pick = 1
			for i, info in ipairs(fresh) do
				if info.kind == SLOTS[si].pref then pick = i break end
			end
			local info = table.remove(fresh, pick)
			if claim(info.part) then
				used[si] = true
				addToy(info, si)
			end
		end
	end
end

-- a size where a thigh is about as long as your ladders
local function fitSize()
	local total, n = 0, 0
	for _, c in ipairs(claimed) do
		if c.kind == "L" then
			total += c.len
			n += 1
		end
	end
	if n == 0 then
		for _, c in ipairs(claimed) do
			total += c.len
			n += 1
		end
	end
	if n == 0 then return nil end
	return math.clamp(math.floor(total / n / 1.9 + 0.5), 3, MAX_SIZE)
end

----------------------------------------------------------------
-- MECH rig (body space: units, origin on the ground under the pelvis,
-- +x right, +y up, -z forward)
----------------------------------------------------------------
local THIGH, UARM = 1.9, 1.75
local PELV_Y = 3.55
local HIP_W, SH_W = 0.95, 1.7

local D1 = { -- robot dance: arm poses (hand rel shoulder, torso frame), one per beat
	{ V(0.9, 1.6, -0.7), V(-0.9, -0.9, -1.0) },
	{ V(0.9, 0.2, -2.2), V(-0.9, 1.6, -0.7) },
	{ V(2.9, 0.2, -0.5), V(-2.9, 0.2, -0.5) },
	{ V(0.3, 0.0, -2.6), V(-0.3, 0.0, -2.6) },
}

local function computeMech(t, dt, att)
	local rb = runBlend
	local w = smooth(speedNow / 3)
	local Aeff = lerp(0.95, 1.5, rb) -- half stride
	local d = lerp(0.62, 0.45, rb)
	local A, Hh = Aeff * w, lerp(0.45, 0.9, rb) * w
	lastPhase = phase
	if speedNow > 0.4 then
		phase = (phase + dt * math.pi * d * speedNow / (Aeff * S.size)) % TAU
	end
	local stompL = speedNow > 3 and phase < lastPhase
	local stompR = speedNow > 3 and lastPhase < math.pi and phase >= math.pi

	-- one foot: forward offset, lift, toe pitch (stance slides back, swing arcs forward)
	local function foot(ph)
		local u = (ph / TAU) % 1
		if u < d then
			local tt = u / d
			local heel = math.clamp((tt - 0.72) / 0.28, 0, 1)
			return A * (1 - 2 * tt), 0, -0.55 * heel * w
		else
			local tt = (u - d) / (1 - d)
			local e = (1 - math.cos(math.pi * tt)) / 2
			local si = math.sin(math.pi * tt)
			return -A + 2 * A * e, Hh * si, 0.32 * si * w
		end
	end
	local sL, lL, pL = foot(phase)
	local sR, lR, pR = foot(phase + math.pi)

	if att and att.stW and att.stW > 0 then
		local fl = (att.front == "L") and 1.0 or -1.0
		sL, sR = lerp(sL, fl, att.stW), lerp(sR, -fl, att.stW)
		lL, lR = lerp(lL, 0, att.stW), lerp(lR, 0, att.stW)
		pL, pR = lerp(pL, 0, att.stW), lerp(pR, 0, att.stW)
	end

	-- heavy gait: the body rides up over the stance leg (walk) or springs (run),
	-- sways sideways, and the hips and shoulders twist against each other
	local pelvisY = PELV_Y + lerp(0.09, -0.22, rb) * w * math.cos(2 * (phase - math.pi * d))
	local sway = lerp(0.26, 0.14, rb) * w * -math.cos(phase - math.pi * d)
	local pelvisYaw = -0.11 * w * math.cos(phase)
	local torsoYaw = 0.15 * w * math.cos(phase)
	local lean = 0.02 + lerp(0.04, 0.30, rb) * w
	local tRoll = 0.035 * w * math.cos(phase - math.pi * d) -- leans a touch over the stance leg
	local headYaw = math.clamp(yawRate * 0.3, -0.6, 0.6)
	local headPitch, headRoll = 0, 0
	pelvisY += math.sin(t * 1.4) * 0.03 * (1 - w) -- breathing
	-- idle servo twitches
	headYaw += (0.05 * math.sin(t * 0.7) + 0.03 * math.sin(t * 1.9)) * (1 - w)

	local beat = t * 2 -- 120 bpm
	local bi, bf = math.floor(beat) % 4, beat % 1
	local snap = smooth(math.min(bf * 2.5, 1))
	local pb = math.pi * beat

	-- dance 1 (robot)
	if d1W > 0.001 then
		pelvisY = lerp(pelvisY, PELV_Y - 0.3 + 0.25 * math.abs(math.sin(pb)), d1W)
		sway = lerp(sway, 0.35 * math.sin(pb), d1W)
		pelvisYaw = lerp(pelvisYaw, 0.25 * math.sin(pb), d1W)
		torsoYaw = lerp(torsoYaw, -0.3 * math.sin(pb), d1W)
		headYaw = lerp(headYaw, ((bi % 2 == 0) and 0.5 or -0.5) * snap, d1W)
		sL, sR = lerp(sL, 0, d1W), lerp(sR, 0, d1W)
		lL = lerp(lL, 0.6 * math.max(0, math.sin(pb)), d1W)
		lR = lerp(lR, 0.6 * math.max(0, -math.sin(pb)), d1W)
	end
	-- dance 2 (disco point)
	if d2W > 0.001 then
		pelvisY = lerp(pelvisY, PELV_Y - 0.35 + 0.3 * math.abs(math.sin(pb)), d2W)
		sway = lerp(sway, 0.45 * math.sin(pb * 0.5), d2W)
		pelvisYaw = lerp(pelvisYaw, 0.4 * math.sin(pb * 0.5), d2W)
		torsoYaw = lerp(torsoYaw, -0.35 * math.sin(pb * 0.5), d2W)
		tRoll = lerp(tRoll, 0.12 * math.sin(pb * 0.5), d2W)
		headPitch = lerp(headPitch, 0.12 * math.sin(pb * 2), d2W)
		sL, sR = lerp(sL, 0, d2W), lerp(sR, 0, d2W)
		lL = lerp(lL, 0.5 * math.max(0, math.sin(pb * 0.5)), d2W)
		lR = lerp(lR, 0.5 * math.max(0, -math.sin(pb * 0.5)), d2W)
	end
	-- bored: slouch, weight shift, foot tapping, looking around
	if boredW > 0.001 then
		pelvisY = lerp(pelvisY, PELV_Y - 0.12, boredW)
		sway = lerp(sway, 0.3 * math.sin(t * 0.5), boredW)
		lean = lerp(lean, 0.18 + 0.05 * math.sin(t * 0.8), boredW)
		tRoll = lerp(tRoll, 0.07, boredW)
		headYaw = lerp(headYaw, 0.6 * math.sin(t * 0.45), boredW)
		headPitch = lerp(headPitch, -0.15 + 0.1 * math.sin(t * 0.9), boredW)
		headRoll = lerp(headRoll, 0.18, boredW)
		lR = lerp(lR, 0.25 * math.max(0, math.sin(t * 6)), boredW)
	end
	-- hand: waving hello
	if handW > 0.001 then
		lean = lerp(lean, -0.04, handW)
		headRoll = lerp(headRoll, 0.12, handW)
		headYaw = lerp(headYaw, 0.2, handW)
		pelvisY = lerp(pelvisY, PELV_Y - 0.05 * math.abs(math.sin(t * 3)), handW)
	end
	-- sit on the ground
	if sitW > 0.001 then
		pelvisY = lerp(pelvisY, 0.75, sitW)
		sway = lerp(sway, 0, sitW)
		pelvisYaw = lerp(pelvisYaw, 0, sitW)
		torsoYaw = lerp(torsoYaw, 0, sitW)
		tRoll = lerp(tRoll, 0, sitW)
		lean = lerp(lean, 0.1 + 0.03 * math.sin(t * 1.4), sitW)
		headYaw = lerp(headYaw, 0.3 * math.sin(t * 0.4), sitW)
		pL, pR = lerp(pL, 0, sitW), lerp(pR, 0, sitW)
	end
	-- kneel on one knee (bow)
	if kneelW > 0.001 then
		pelvisY = lerp(pelvisY, 2.1, kneelW)
		sway = lerp(sway, 0, kneelW)
		pelvisYaw = lerp(pelvisYaw, 0, kneelW)
		torsoYaw = lerp(torsoYaw, 0, kneelW)
		tRoll = lerp(tRoll, 0, kneelW)
		lean = lerp(lean, 0.3, kneelW)
		headPitch = lerp(headPitch, -0.4, kneelW)
		pL, pR = lerp(pL, 0, kneelW), lerp(pR, 0, kneelW)
	end
	if att then
		pelvisY += (att.pY or 0)
		pelvisYaw += att.pYaw or 0
		torsoYaw += att.tYaw or 0
		lean += att.lean or 0
	end
	-- the head stays level while the torso leans
	headPitch += lean * 0.75

	local pelvisRot = CFrame.Angles(0, pelvisYaw, 0)
	local torsoRot = CFrame.Angles(0, torsoYaw, 0) * CFrame.Angles(-lean, 0, 0) * CFrame.Angles(0, 0, tRoll)

	local J = { pelvisRot = pelvisRot, torsoRot = torsoRot, stompL = stompL, stompR = stompR }
	local pelvis = V(sway, pelvisY, 0)
	J.chest = pelvis + torsoRot * V(0, 2.0, 0)
	J.neck = pelvis + torsoRot * V(0, 2.75, 0)
	J.shL = J.chest + torsoRot * V(-SH_W, 0.35, 0)
	J.shR = J.chest + torsoRot * V(SH_W, 0.35, 0)
	J.hipL = pelvis + pelvisRot * V(-HIP_W, 0, 0)
	J.hipR = pelvis + pelvisRot * V(HIP_W, 0, 0)

	-- eyes blink, the antenna sways
	J.blink = ((t + 0.7) % 3.9) < 0.12
	J.ant = 0.15 * math.sin(t * 2.2) + 0.25 * w * math.sin(phase * 2)

	-- head + mask (the mask is hinged on the forehead and flips up and back)
	J.headRot = torsoRot * CFrame.Angles(0, headYaw, 0) * CFrame.Angles(headPitch, 0, 0) * CFrame.Angles(0, 0, headRoll)
	J.headC = J.neck + torsoRot * V(0, 0.75, 0)
	local hingeL, closedL = V(0, 0.55, -0.55), V(0, -0.05, -0.7)
	local mRot = CFrame.Angles(-1.95 * maskW, 0, 0)
	J.maskRot = J.headRot * mRot
	J.maskPos = J.headC + J.headRot * (hingeL + mRot * (closedL - hingeL))
	J.hinge = J.headC + J.headRot * hingeL

	-- legs ----------------------------------------------------------
	local function ankle(side, s, lift)
		local a = V(side * 1.0, 0.3 + lift, -s)
		if sitW > 0 then a = a:Lerp(V(side * 1.0, 0.35, -3.1), sitW) end
		if kneelW > 0 then
			a = a:Lerp((side < 0) and V(-1.0, 0.35, -2.3) or V(1.0, 0.45, 1.8), kneelW)
		end
		return a
	end
	J.ankL, J.ankR = ankle(-1, sL, lL), ankle(1, sR, lR)
	local function pole(side)
		local p = V(0, 0.15, -1)
		p = p:Lerp(V(0, 1, -0.2), sitW)
		if side < 0 then
			p = p:Lerp(V(0, 0.3, -1), kneelW)
		else
			p = p:Lerp(V(0, -1, -0.2), kneelW)
		end
		return pelvisRot * p
	end
	J.kneeL = ik(J.hipL, J.ankL, pole(-1), THIGH)
	J.kneeR = ik(J.hipR, J.ankR, pole(1), THIGH)
	if kneelW > 0.01 then
		J.kneeR = V(J.kneeR.X, math.max(J.kneeR.Y, 0.35), J.kneeR.Z)
	end
	local function toe(ank, pt)
		return ank + pelvisRot * V(0, 0.8 * math.sin(pt) - 0.12, -0.9 * math.cos(pt))
	end
	J.toeL = toe(J.ankL, pL)
	J.toeR = toe(J.ankR, (kneelW > 0.5) and (pR - 1.2 * kneelW) or pR)

	-- arms ----------------------------------------------------------
	local reach = (UARM * 2) * lerp(0.95, 0.62, rb)
	local swing = lerp(0.35, 0.8, rb) * w * math.cos(phase)
	local function locoHand(sh, side)
		local th = ((side < 0) and -swing or swing) + 0.03 * math.sin(t * 1.4 + side)
		return sh + torsoRot * (V(side * 0.3, -math.cos(th), -math.sin(th)) * reach)
	end
	local hL, hR = locoHand(J.shL, -1), locoHand(J.shR, 1)

	if att and att.armW and att.armW > 0 then
		if att.hR then hR = hR:Lerp(J.shR + torsoRot * att.hR, att.armW) end
		if att.hL then hL = hL:Lerp(J.shL + torsoRot * att.hL, att.armW) end
	end
	if d1W > 0.001 then
		local p0, p1 = D1[bi + 1], D1[(bi + 1) % 4 + 1]
		hR = hR:Lerp(J.shR + torsoRot * p0[1]:Lerp(p1[1], snap), d1W)
		hL = hL:Lerp(J.shL + torsoRot * p0[2]:Lerp(p1[2], snap), d1W)
	end
	if d2W > 0.001 then
		local upPose, downPose = V(1.9, 2.8, -0.3), V(-0.6, -3.0, -1.0)
		local even = (math.floor(beat) % 2 == 0)
		local cur, prev = even and upPose or downPose, even and downPose or upPose
		hR = hR:Lerp(J.shR + torsoRot * prev:Lerp(cur, snap), d2W)
		hL = hL:Lerp(J.shL + torsoRot * V(-1.7, -1.0, -0.1), d2W)
	end
	if boredW > 0.001 then
		local scratch = 0.12 * math.sin(t * 5)
		hR = hR:Lerp(J.shR + torsoRot * V(0.2 + scratch, 1.0, -1.4), boredW) -- hand to the head
		hL = hL:Lerp(J.shL + torsoRot * V(-1.7, -1.0, -0.2), boredW) -- other hand on the hip
	end
	if handW > 0.001 then
		hR = hR:Lerp(J.shR + torsoRot * V(0.9 + 0.8 * math.sin(t * 7), 3.0, -0.5), handW)
		hL = hL:Lerp(J.shL + torsoRot * V(-1.7, -1.0, -0.2), handW)
	end
	if sitW > 0.001 then
		hR = hR:Lerp(J.kneeR + V(0.1, 0.55, 0.1), sitW)
		hL = hL:Lerp(J.kneeL + V(-0.1, 0.55, 0.1), sitW)
	end
	if kneelW > 0.001 then
		hR = hR:Lerp(V(1.4, 0.5, -1.2), kneelW) -- fist planted on the ground
		hL = hL:Lerp(J.kneeL + V(-0.1, 0.55, 0.1), kneelW)
	end
	local maxLen = UARM * 2 * 0.999
	hR, hL = clampReach(J.shR, hR, maxLen), clampReach(J.shL, hL, maxLen)
	J.elbL = ik(J.shL, hL, torsoRot * V(-0.35, -0.4, 1.0), UARM)
	J.elbR = ik(J.shR, hR, torsoRot * V(0.35, -0.4, 1.0), UARM)
	J.handL, J.handR = hL, hR

	-- backpack tube (diagonal on the right shoulder)
	J.cannonPos = J.chest + torsoRot * V(1.0, 1.1, 1.05)
	J.cannonDir = torsoRot * V(0.15, 0.75, -0.55)
	return J
end

-- slot target for the MECH form: pos (units), long dir, flat normal
local function mechTarget(id, J)
	local tr, pr = J.torsoRot, J.pelvisRot
	local fwd, right, up = tr * V(0, 0, -1), tr * V(1, 0, 0), tr * V(0, 1, 0)
	if id == "chest" then return J.chest + fwd * 0.95, right, fwd
	elseif id == "back" then return J.chest - fwd * 1.3 + up * 0.1, right, -fwd
	elseif id == "spine" then return (J.pelvis + J.chest) / 2 + fwd * 0.55, right, fwd -- waist plate
	elseif id == "hipP" then return J.pelvis + pr * V(0, 0.1, -0.75), J.hipR - J.hipL, pr * V(0, 0, -1)
	elseif id == "mask" then return J.maskPos, J.maskRot * V(1, 0, 0), J.maskRot * V(0, 0, -1)
	elseif id == "cannon" then return J.cannonPos, J.cannonDir, right
	end
	local side = id:sub(-1)
	local s = (side == "L") and -1 or 1
	local key = id:sub(1, -2)
	if key == "pad" then
		return J["sh" .. side] + up * 0.6 + right * (s * 0.4), fwd, up * 0.8 + right * (s * 0.6)
	elseif key == "thigh" then
		local a, b = J["hip" .. side], J["knee" .. side]
		return (a + b) / 2, b - a, pr * V(0, 0, -1)
	elseif key == "shin" then
		local a, b = J["knee" .. side], J["ank" .. side]
		return (a + b) / 2, b - a, pr * V(0, 0, -1)
	elseif key == "uarm" then
		local a, b = J["sh" .. side], J["elb" .. side]
		return (a + b) / 2, b - a, right * s
	elseif key == "farm" then
		local a, b = J["elb" .. side], J["hand" .. side]
		return (a + b) / 2, b - a, right * s
	elseif key == "foot" then
		local a, b = J["ank" .. side], J["toe" .. side]
		return (a + b) / 2 + V(0, -0.1, 0), b - a, V(0, 1, 0)
	else -- fist
		local a, b = J["elb" .. side], J["hand" .. side]
		local dir = b - a
		return b + (dir.Magnitude > 1e-3 and dir.Unit or V(0, -1, 0)) * 0.4, dir, right * s
	end
end

local function formTarget(form, id, J)
	if form == "mech" then return mechTarget(id, J) end
	if form == "car" then
		local wp = WHEEL[id]
		if wp then
			local side = (id == "footL" or id == "fistL") and -1 or 1
			local st = (id == "footL" or id == "footR") and steer or 0
			local d0 = V(0, math.sin(wheelA), math.cos(wheelA))
			return wp, V(d0.Z * math.sin(st), d0.Y, d0.Z * math.cos(st)),
				V(side * math.cos(st), 0, -side * math.sin(st))
		end
		local e = CAR[id]
		return e[1], e[2], e[3]
	end
	local e = JET[id]
	return e[1], e[2], e[3]
end

