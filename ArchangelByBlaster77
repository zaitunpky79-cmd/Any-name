function skills.FlySlash()
	if not S.flying or S.h < 6 then notify("Fly first (Fly button) to use the flying slash", 3) return end
	shout("FLYING SLASH")
	local a = aimPoint()
	local dir = F3(headingTo(S.pos, a))
	local side = V(-dir.Z, 0, dir.X)
	S.faceH = headingTo(S.pos, a)
	poseSet({armR = 1.7, foreR = 1.0, twist = -0.6, dive = 0.2, armL = 0.3}, 8)
	local back = V(S.pos.X, 0, S.pos.Z) - dir * 12
	glide(back, S.h + 6, 0.45)
	poseSet({armR = 0.4, foreR = -1.0, twist = 0.8, dive = 0.9, armL = 0.3}, 28)
	sfx("slash", 1, 0.8)
	local start = S.pos
	local path = V(a.X, 0, a.Z) + dir * 26
	local t0 = os.clock()
	local dur = 0.38
	local spawned = false
	while true do
		local k = (os.clock() - t0) / dur
		if k >= 1 then break end
		local e = k * k * (3 - 2 * k)
		S.pos = V(mix(start.X, path.X, e), 0, mix(start.Z, path.Z, e))
		S.h = mix(S.h, math.max(10, a.Y - S.gy + 6), 0.08)
		if not spawned and k > 0.45 then
			spawned = true
			local o = V(S.pos.X, S.gy + S.h + 6, S.pos.Z)
			crescent(o, dir, side, 0.9, 15)
			flash(swordTipPos(), 16, COL.LIGHT)
			flashScreen(0.2, COL.LIGHT)
			shakeFrom(o, 0.8, 0.3, 400)
		end
		if math.random() < 0.5 then
			local f = fxTake("R", 1, COL.LIGHT, true)
			if f[1] then
				f[1].use = yAxisCF(V(S.pos.X, S.gy + S.h + 6, S.pos.Z), -dir, UP)
				scatter(f, V(S.pos.X, S.gy + S.h + 6, S.pos.Z), 8, 0.6)
