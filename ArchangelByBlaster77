	bone("Torso", "Root", V(0, 12, 0))
	bone("Head", "Torso", V(0, 18, 0))
	for _, sd in ipairs({-1, 1}) do
		local d = sd < 0 and "L" or "R"
		bone("Arm" .. d, "Torso", V(sd * 3.5, 17, 0))
		bone("Fore" .. d, "Arm" .. d, V(sd * 3.5, 13, 0))
		bone("Thigh" .. d, "Root", V(sd * 1, 10, 0))
		bone("Shin" .. d, "Thigh" .. d, V(sd * 1, 6, 0))
		bone("Foot" .. d, "Shin" .. d, V(sd * 1, 2, 0))
		bone("WingA" .. d, "Torso", V(sd * 2, 17, 2.5))
		bone("WingB" .. d, "WingA" .. d, V(sd * 7.5, 19, 3))
		bone("WingC" .. d, "WingB" .. d, V(sd * 12.5, 22, 3.5))
	end
	-- pelvis, tassets, loincloth
