local function explode(pos, radius, power)
	flash(pos + V(0, radius * 0.3, 0), radius * 1.6, Color3.fromRGB(255, 170, 60))
	ring(pos, radius * 2, Color3.fromRGB(255, 190, 90))
	shakeFrom(pos, power, 0.9, 260 * UN)
end
local function streak(a, b, color)
	local d = (b - a)
	if d.Magnitude < 0.5 then return end
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.fromRGB(150, 210, 255)
	p.Size = V(1.4 * UN, 1.4 * UN, d.Magnitude)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.35), {Transparency = 1, Size = V(0.1, 0.1, d.Magnitude)}):Play()
	Debris:AddItem(p, 0.5)
end
local function burst(pos, n) -- shards flying out (intro shatter)
	for _ = 1, n do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(150, 210, 255)
		local s = (0.4 + math.random() * 0.8) * UN
		p.Size = V(s, s, s)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		p.Parent = workspace
		local vel = V(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5).Unit * (20 + math.random() * 40) * UN
		Debris:AddItem(p, 1.5)
		task.spawn(function()
			local t0 = os.clock()
			while p.Parent and os.clock() - t0 < 1.2 do
				local dt = RunService.RenderStepped:Wait()
				vel = vel + V(0, -60 * dt, 0)
				p.CFrame = p.CFrame + vel * dt
				p.Transparency = clamp((os.clock() - t0) / 1.2, 0, 1)
			end
			pcall(function() p:Destroy() end)
		end)
	end
end
local function snakeShot(origin) -- homing orange snake (parryable in the game; here just a visual)
	local n = 9
	local segs = {}
	for i = 1, n do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Shape = Enum.PartType.Ball
		p.Material = Enum.Material.Neon
		p.Color = (i == 1) and Color3.fromRGB(255, 90, 30) or ORANGE
		local s = (2.4 - i * 0.18) * UN
		p.Size = V(s, s, s)
		p.CFrame = CFrame.new(origin)
		p.Parent = workspace
		segs[i] = p
		Debris:AddItem(p, 5)
	end
	task.spawn(function()
		local pos = origin
		local th = targetHrp(targetPl)
		local dir = th and (th.Position + V(0, 2, 0) - origin).Unit or V(-math.sin(heading), 0.1, -math.cos(heading)).Unit
		local vel = dir * 60 * UN
		local hist = {}
		local t0 = os.clock()
		while os.clock() - t0 < 4 do
			local dt = RunService.RenderStepped:Wait()
			local tt = targetHrp(targetPl)
			if tt then
				local want = (tt.Position + V(0, 2, 0) - pos)
				if want.Magnitude < 3 * UN then flash(pos, 6 * UN, ORANGE) break end
				vel = vel:Lerp(want.Unit * 60 * UN, clamp(dt * 2.5, 0, 1))
			end
			pos = pos + vel * dt
			table.insert(hist, 1, pos)
			if #hist > n * 4 + 2 then table.remove(hist) end
			for i, p in ipairs(segs) do
				local hpz = hist[math.min(#hist, (i - 1) * 3 + 1)]
				if hpz then p.CFrame = CFrame.new(hpz + V(0, math.sin(os.clock() * 12 + i) * 0.4 * UN, 0)) end
			end
		end
		for _, p in ipairs(segs) do pcall(function() p:Destroy() end) end
	end)
end

local function poseSet(t, rate)
	for k in pairs(poseT) do poseT[k] = t[k] or 0 end
	poseRate = rate or 8
end

-- players / input -------------------------------------------------------------------------------------------------------------
function targetHrp(pl)
	local c = pl and pl.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function findPlayer(txt)
	txt = string.lower(txt or ""):match("^%s*(.-)%s*$")
	if txt == "" then return nil end
	local partial
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= lp then
			local n, d = pl.Name:lower(), pl.DisplayName:lower()
			if n == txt or d == txt then return pl end
			if not partial and (n:sub(1, #txt) == txt or d:sub(1, #txt) == txt) then partial = pl end
		end
	end
	return partial
end
local function getMove()
	local x, z = 0, 0
	if controls then
		local ok, v = pcall(function() return controls:GetMoveVector() end)
		if ok and v then x, z = v.X, v.Z end
	end
	if not UIS:GetFocusedTextBox() then
		if UIS:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
		if UIS:IsKeyDown(Enum.KeyCode.S) then z += 1 end
		if UIS:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
		if UIS:IsKeyDown(Enum.KeyCode.D) then x += 1 end
	end
	if pad.f then z -= 1 end
	if pad.b then z += 1 end
	if pad.l then x -= 1 end
	if pad.r then x += 1 end
	local v = V(x, 0, z)
	if v.Magnitude < 0.05 then return V() end
	if v.Magnitude > 1 then v = v.Unit end
	local w = cam.CFrame:VectorToWorldSpace(v)
	w = V(w.X, 0, w.Z)
	if w.Magnitude < 0.01 then return V() end
	return w.Unit * v.Magnitude
end

-- rig helpers --------------------------------------------------------------------------------------------------------------------
local function wpos(bone, rest)
	local w = world[bone]
	if not w then return headPos end
	return (w * CFrame.new(rest - bones[bone].pv)).Position
end
local function F3() return V(-math.sin(heading), 0, -math.cos(heading)) end
local function aimPoint()
	local th = targetHrp(targetPl)
	if th then return th.Position end
	return V(hp.X, gy, hp.Z) + F3() * (26 * UN)
end
local function faceTo(p)
	local d = V(p.X - hp.X, 0, p.Z - hp.Z)
	if d.Magnitude > 0.01 then heading = math.atan2(-d.X, -d.Z) end
end
local function speedMul() return (phase == 2) and 1.35 or 1 end
local function wt(x) task.wait(x / speedMul()) end
local function blink(dest) -- Minos "teleports": instant move with a light streak
	local from = V(hp.X, gy + 8 * UN, hp.Z)
	local ng = groundAt(V(dest.X, gy, dest.Z), 80 * UN)
	streak(from, V(dest.X, ng + 8 * UN, dest.Z))
	flash(from, 8 * UN)
	hp = V(dest.X, 0, dest.Z)
	gy = ng
	flash(V(dest.X, ng + 8 * UN, dest.Z), 8 * UN)
	shakeFrom(V(dest.X, ng, dest.Z), 0.5, 0.3, 200 * UN)
end
local function blinkNear(tp, dist)
	local d = V(hp.X - tp.X, 0, hp.Z - tp.Z)
	d = (d.Magnitude > 0.5) and d.Unit or -F3()
	blink(V(tp.X, 0, tp.Z) + d * dist)
	faceTo(tp)
end
local function glide(dest, lift, secs)
	local p0, l0 = hp, liftY
	local t0 = os.clock()
	while true do
		local k = (os.clock() - t0) / secs
		if k >= 1 then break end
		local e = smooth(k)
		hp = V(mix(p0.X, dest.X, e), 0, mix(p0.Z, dest.Z, e))
		liftY = mix(l0, lift, e)
		RunService.Heartbeat:Wait()
	end
	hp = V(dest.X, 0, dest.Z)
	liftY = lift
end
local function punch(right, big)
	local ak, fk = right and "armRx" or "armLx", right and "foreRx" or "foreLx"
	local w = {lean = 0.12, crouch = 0.15, twist = right and -0.7 or 0.7}
	w[ak], w[fk] = -0.9, 1.3
	poseSet(w, 14)
	wt(0.2)
	local s = {lean = -0.32, crouch = 0.1, twist = right and 0.8 or -0.8}
	s[ak], s[fk] = 1.55, 0
	poseSet(s, 30)
	dashT, dashSpd = 0.12, 40 * UN
	wt(0.1)
	local hpz = wpos(right and "ForeR" or "ForeL", right and info.handR or info.handL)
	flash(hpz, (big and 6 or 3.5) * UN)
	ring(V(hpz.X, gy, hpz.Z), (big and 8 or 4) * UN)
	shakeFrom(hpz, big and 1.0 or 0.6, 0.35, 200 * UN)
end

