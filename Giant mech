local function runSkill(name, pl)
	if not alive then notify("Spawn first", 2) return end
	if cutActive or busy then return end
	if name == "Shot" then fireShot() return end
	if name == "Reload" and not act then reloadAmmo() return end
	if act then notify("Busy: " .. act, 2) return end
	if (name == "Laser") and laser then return end
	act = name
	local ok, err = pcall(skills[name], pl)
	if not ok then warn("[Mech] " .. tostring(err)) end
	hopT = 0
	trailOn(false)
	restPose(4)
	setGlow(baseGlow())
	faceTarget = nil
	act = nil
	punchCd = 0.6
end
local function useSlot(key)
	local pair = SLOTS[key]
	if pair then runSkill(pair[equipped and 2 or 1], targetPl) end
end

