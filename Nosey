		if not ok then
			errT += dt
			if errT > 0.5 then errT = 0; notify("script error: " .. tostring(err), 6); warn("[NoseyBrick] " .. tostring(err)) end
		end
		filT += dt
		if filT > 2then filT = 0; refreshFilters() end
	end
	statT += dt
	if statT > 0.5 then
		statT = 0
		syncButtons()
		if os.clock() > noticeUntil then
			if alive then
				local st = act and act:upper() or (hidden and "Hidden") or (targetPl and ("Targeting " .. targetPl.DisplayName)) or (control and "Controlled") or "Idle"
				statusLbl.Text = string.format("%s | %d bricks | speed %g", st, NEED, SPEED)
			else
				statusLbl.Text = "Ready | uses exactly " .. NEED .. " of your 1x1x3 bricks"
			end
		end
	end
end))
table.insert(conns, RunService.Heartbeat:Connect(function() if alive then applyTargets() end end))
table.insert(conns, RunService.Stepped:Connect(function() if alive then applyTargets() end end))

pcall(countBricks)
