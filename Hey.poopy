mini.Position = UDim2.new(1, -58, 0, 4)
mini.BackgroundColor3 = Color3.fromRGB(52, 52, 66)
mini.Text = "-"
mini.TextColor3 = Color3.new(1, 1, 1)
mini.Font = Enum.Font.GothamBold
