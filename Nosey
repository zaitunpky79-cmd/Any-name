-- intro cutscene (3.5s dark crouch -> 1.2s eyes light up -> 2.2s stands up) -------------------------------
local function runIntro()
	cutActive, skipFlag, busy = true, false, true
	setGlow("Offline")
	crouch, crouchTarget, crouchRate = 1, 1, 4
	cam.CameraType = Enum.CameraType.Scriptable
	cineShow()
	task.delay(4.0, function()
		if cutActive then titleLbl.Visible, subLbl.Visible = true, true; fadeText(titleLbl, 0, 0.8); fadeText(subLbl, 0.2, 1.0) end
	end)
	task.delay(6.0, function() fadeText(titleLbl, 1, 0.6); fadeText(subLbl, 1, 0.6) end)
	task.spawn(function()
		local t0, stage = os.clock(), 0
		local sc = (6 * L) / 10.9
		while alive do
			RunService.RenderStepped:Wait()
			local t = os.clock() - t0
			if skipFlag or t >= 6.9 then break end
			if t >= 3.5 and stage < 1 then stage = 1; setGlow("Online"); shakeOn = true end
			if t >= 4.7 and stage < 2 then stage = 2; crouchRate, crouchTarget = 1.6, 0 end
			local rc = CFrame.new(hp.X, gy, hp.Z) * CFrame.Angles(0, heading, 0)
			local pos, target, fov
			if t < 3.5 then
				local k = smooth(t / 3.5)
				pos = rc:PointToWorldSpace(V(0, mix(-1, 1.5, k) + 2 * sc, mix(-60, -16, k)) * sc)
				target, fov = headPos, mix(70, 50, k)
			elseif t < 4.7 then
				local k = (t - 3.5) / 1.2
				local jitter = V(math.random() - 0.5, math.random() - 0.5, 0) * 0.25 * k * sc
				pos = rc:PointToWorldSpace(V(0, 1.5 + 0.4 * k + 2 * sc, mix(-16, -9, k)) * sc) + jitter
				target, fov = headPos, mix(50, 32, smooth(k))
			else
				local k = smooth((t - 4.7) / 2.2)
				local a = k * 1.1
				local r, h = mix(9, 34, k), mix(2.5, 6, k)
				pos = rc:PointToWorldSpace(V(math.sin(a) * r, h + 2 * sc, -math.cos(a) * r) * sc)
				target = headPos:Lerp(torsoPos, k)
				fov = mix(32, 68, k)
			end
			cam.CFrame = CFrame.lookAt(pos, target)
			cam.FieldOfView = fov
		end
		cutActive, busy, shakeOn = false, false, false
		crouchTarget, crouchRate = 0, 4
		setGlow(baseGlow())
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = baseFov
		cineHide()
	end)
end

-- dismiss / summon ----------------------------------------------------------------------------------
local function dismiss()
	skipFlag = true
	cutActive, busy = false, false
	cam.CameraType = Enum.CameraType.Custom
	pcall(function() cam.FieldOfView = baseFov end)
	cineHide()
	setRide(false)
	for _, s in ipairs(saved) do
		local p = s.p
		if p and p.Parent then
			pcall(function()
				local bf = p:FindFirstChild("NoseyAntiG")
				if bf then bf:Destroy() end
				p.CFrame = s.cf
				p.Anchored = s.anchored
				p.CanCollide = s.collide
				p.Color, p.Material = s.color, s.material
				p.AssemblyLinearVelocity = V()
			end)
		end
	end
	if camPart then camPart:Destroy() end
	camPart = nil
	pool, slots, saved = {}, {}, {}
	alive, control, hidden, targetPl, act, faceTarget = false, false, false, nil, nil, nil
	sink, sinkTarget, curSp = 0, 0, 0
	avatarCF = nil
	cam.CameraSubject = hum
end

local function summon()
	if alive then return end
	local list, dims = gather()
	if not list then notify("Cannot spawn: " .. tostring(dims), 6) return end
	if #list < NEED then
		notify(string.format("Need %d bricks of one size (1x1x3), found %d (%.1fx%.1fx%.1f). Stand next to your own bricks.",
			NEED, #list, dims[1], dims[2], dims[3]), 9)
		return
	end
	pool = {}
	for i = 1, NEED do pool[i] = list[i][1] end
	cx, cz, L = dims[1], dims[2], dims[3]
	bones, order, parts = layout(cx, cz, L)

	slots, saved = {}, {}
	local idx = 0
	for _, pt in ipairs(parts) do
		for j = 1, pt.ny do
			for k = 1, pt.nz do
				for i = 1, pt.nx do
					idx += 1
					local p = pool[idx]
					local off = V((i - 0.5 - pt.nx / 2) * cx, (j - 0.5 - pt.ny / 2) * L, (k - 0.5 - pt.nz / 2) * cz)
					local color, glow = slotStyle(pt.kind, i, k, j, pt.nx, pt.ny)
					slots[idx] = {p = p, bone = pt.bone, off = (pt.c + off) - bones[pt.bone].pv, orient = orientFor(p), color = color, glow = glow}
					saved[idx] = {p = p, cf = p.CFrame, anchored = p.Anchored, collide = p.CanCollide, color = p.Color, material = p.Material}
				end
			end
		end
	end
	for _, s in ipairs(slots) do
		local p = s.p
		pcall(function() p.Anchored = false; p.CanCollide = false end)
		pcall(function()
			local bf = Instance.new("BodyForce")
			bf.Name = "NoseyAntiG"
			bf.Force = V(0, p.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = p
		end)
		pcall(function() p.Color = s.color; p.Material = Enum.Material.SmoothPlastic end)
	end
	pcall(function() lp.MaximumSimulationRadius = math.huge end)
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)

	camPart = mk("Part", {Anchored = true, CanCollide = false, CanQuery = false, Transparency = 1, Size = V(1, 1, 1)}, workspace)
	refreshFilters()
	oldZoomMax, oldZoomMin = lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance
	baseFov = cam.FieldOfView

	local look = hrp.CFrame.LookVector
	look = V(look.X, 0, look.Z)
	look = look.Magnitude > 1e-3 and look.Unit or V(0, 0, -1)
	heading = math.atan2(look.X, look.Z) -- faces you
	local sp0 = hrp.Position + look * (4 * L + 10)
	hp = V(sp0.X, 0, sp0.Z)
	gy = groundAt(V(sp0.X, hrp.Position.Y, sp0.Z), 40)
	crouch, crouchTarget, crouchRate, curSp, wavePh = 1, 1, 4, 0, 0
	sink, sinkTarget, hidden, control, targetPl = 0, 0, false, false, nil
	for k in pairs(pose) do pose[k] = 0; poseT[k] = 0 end
	headPos, torsoPos = V(hp.X, gy + 4.5 * L, hp.Z), V(hp.X, gy + 3 * L, hp.Z)
	alive = true
	setGlow("Offline")
	runIntro()
	notify(string.format("%d bricks used (%.0fx%.0fx%.0f each) | height %.0f studs", NEED, cx, cz, L, 6 * L), 6)
end

-- main step -----------------------------------------------------------------------------------------
local function step(dt)
	local t = os.clock()
	local F = V(-math.sin(heading), 0, -math.cos(heading))
	gy = groundAt(V(hp.X, gy, hp.Z), 6 * L + 30)
	punchCd = math.max(0, punchCd - dt)

	-- 1) movement intent
	local wantDir, tgtSp = nil, 0
	if not (busy or act or hidden or cutActive) then
		if control then
			local mv = getMove()
			if mv.Magnitude > 0.1 then wantDir, tgtSp = mv.Unit, SPEED * math.min(1, mv.Magnitude) end
		elseif targetPl then
			local th = targetHrp(targetPl)
			local tHum = th and th.Parent and th.Parent:FindFirstChildOfClass("Humanoid")
			if not th or not targetPl.Parent then
				targetPl = nil
				notify("Target lost", 3)
			elseif tHum and tHum.Health <= 0 then
				targetPl = nil
				notify("Target down", 3)
			else
				local flat = V(th.Position.X - hp.X, 0, th.Position.Z - hp.Z)
				local dist = flat.Magnitude
				local range = 2.6 * L
				if dist > 1e-3 then wantDir = flat.Unit end
				if dist > range * 0.85 then tgtSp = SPEED * smooth((dist - range * 0.85) / L + 0.25) end
				if dist <= range and punchCd <= 0 then task.spawn(runSkill, "Punch", targetPl) end
			end
		end
	end
	if act and faceTarget then
		local th = targetHrp(faceTarget)
		if th then
			local flat = V(th.Position.X - hp.X, 0, th.Position.Z - hp.Z)
			if flat.Magnitude > 1e-3 then
				heading += clamp(adiff(math.atan2(-flat.X, -flat.Z), heading) * math.min(1, dt * 6), -5 * dt, 5 * dt)
			end
		end
	end
	if wantDir then
		local d = adiff(math.atan2(-wantDir.X, -wantDir.Z), heading)
		heading += clamp(d * math.min(1, dt * 4), -3 * dt, 3 * dt)
	end
	F = V(-math.sin(heading), 0, -math.cos(heading))
	curSp += (tgtSp - curSp) * math.min(1, dt * ((tgtSp > curSp) and 2.5 or 5))
	if curSp > 0.2 then hp = hp + F * curSp * dt end
	if dashT > 0 then dashT -= dt; hp = hp + F * dashSpd * dt end

	-- 2) pose blending
	crouch += (crouchTarget - crouch) * clamp(dt * crouchRate, 0, 1)
	local kp = clamp(dt * poseRate, 0, 1)
	for key, v in pairs(pose) do pose[key] = v + (poseT[key] - v) * kp end
	sink += (sinkTarget - sink) * clamp(dt * 3.5, 0, 1)
	local ce = clamp(crouch + pose.crouch, 0, 1.2)

	-- 3) walk cycle + joints (ported from the Nosey animatronic)
	local sp = curSp
	local a = clamp(sp / 50, 0, 1)
	wavePh += dt * (4 + math.min(sp, 60) * 0.5)
	local sw = math.sin(wavePh)
	local amp = (0.35 + 0.65 * a) * (1 - math.min(ce, 1) * 0.8) * clamp(sp / 4, 0, 1)
	local hL, hR = ce * 1.35 + sw * amp, ce * 1.35 - sw * amp
	local kL = -ce * 2.1 - math.max(0, math.cos(wavePh)) * a * 1.3
	local kR = -ce * 2.1 - math.max(0, -math.cos(wavePh)) * a * 1.3
	local sway = math.sin(t * 2.2) * 0.08
	local tw = shakeOn and math.sin(t * 40) * 0.12 or 0
	local rot = {
		Root = CFrame.new(),
		Torso = CFrame.Angles(-ce * 0.7 - a * 0.45 + pose.lean, pose.twist, 0),
		Head = CFrame.Angles(ce * 0.5 + a * 0.35 + pose.head, 0, math.sin(t * 0.7) * 0.04),
		AntL = CFrame.Angles(0, 0, 0.15 + sway + tw),
		AntR = CFrame.Angles(0, 0, -0.15 - sway - tw),
		ArmL = CFrame.Angles(ce * 0.5 - a * 0.4 - sw * 0.8 * a + pose.arm, pose.spread, 0),
		ArmR = CFrame.Angles(ce * 0.5 - a * 0.4 + sw * 0.8 * a + pose.arm + pose.pArm, -pose.spread, 0),
		ForeL = CFrame.Angles(0.25 + a * 0.9 + ce * 0.4 - pose.arm * 0.15, 0, 0),
		ForeR = CFrame.Angles(0.25 + a * 0.9 + ce * 0.4 - pose.arm * 0.15 + pose.pElbow, 0, 0),
		ThighL = CFrame.Angles(hL, 0, 0), ThighR = CFrame.Angles(hR, 0, 0),
		ShinL = CFrame.Angles(kL, 0, 0), ShinR = CFrame.Angles(kR, 0, 0),
	}
	-- keep the lowest foot on the ground while crouching / walking
	local reach = math.max(L * (math.cos(hL) + math.cos(hL + kL)), L * (math.cos(hR) + math.cos(hR + kR)))
	local baseY = gy + (reach - 2 * L) - sink * 6.6 * L
	local baseCF = CFrame.new(hp.X, baseY, hp.Z) * CFrame.Angles(0, heading, 0)

	-- 4) forward kinematics -> brick CFrames
	local M = {}
	for _, name in ipairs(order) do
		local b = bones[name]
		if b.parent then
			M[name] = M[b.parent] * CFrame.new(b.pv - bones[b.parent].pv) * rot[name]
		else
			M[name] = CFrame.new(b.pv) * rot[name]
		end
	end
	for _, s in ipairs(slots) do
		s.cf = baseCF * M[s.bone] * CFrame.new(s.off) * s.orient
	end
	headPos = (baseCF * M.Head * CFrame.new(V(0, 4.5 * L, 0) - bones.Head.pv)).Position
	torsoPos = (baseCF * M.Torso * CFrame.new(V(0, 3 * L, 0) - bones.Torso.pv)).Position

	-- 5) avatar inside the body + guard (stay the closest player so the bricks stay yours)
	avatarCF = CFrame.new(torsoPos)
	radT += dt
	if radT > 1 then
		radT = 0
		pcall(function() lp.MaximumSimulationRadius = math.huge end)
		pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)
	end
	guardT += dt
	if guardT > 0.1 then
		guardT = 0
		threats = {}
		local near = 120 + 4 * L
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= lp then
				local th = targetHrp(pl)
				if th and (th.Position - torsoPos).Magnitude < near + 6 * L then
					local bp, bd
					for _, s in ipairs(slots) do
						local d = (s.cf.Position - th.Position).Magnitude
						if not bd or d < bd then bd, bp = d, s.cf.Position end
					end
					if bd and bd < near then threats[#threats + 1] = {pos = bp, d = bd} end
				end
			end
		end
		table.sort(threats, function(x, y) return x.d < y.d end)
	end
	if #threats > 0 and ride then
		local k = (math.floor(os.clock() * 8) % #threats) + 1
		avatarCF = CFrame.new(threats[k].pos)
	end
	setRide(not cutActive)
	if not ride then avatarCF = nil end

	-- 6) camera anchor, decay
	camPart.Position = headPos + V(0, 0.8 * L, 0)
	if ride then lp.CameraMinZoomDistance = clamp(5 * L, 12, 2900) end
end

local function applyTargets()
	for _, s in ipairs(slots) do
		local p = s.p
		if p.Parent and s.cf then
			p.CFrame = s.cf
			p.AssemblyLinearVelocity = V()
			p.AssemblyAngularVelocity = V()
		end
	end
	if avatarCF and ride and hrp and hrp.Parent then
		hrp.CFrame = avatarCF
		hrp.AssemblyLinearVelocity = V()
		hrp.AssemblyAngularVelocity = V()
	end
end

