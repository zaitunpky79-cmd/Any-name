local function targetNearest()
	if not alive then return end
	local best, bd = nil, math.huge
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= lp then
			local r = targetHrp(pl)
			if r then
				local d = (r.Position - pos).Magnitude
				if d < bd then best, bd = pl, d end
			end
		end
	end
	if not best then notify("No other player found", 3) return end
	armed = true
	startRage(best)
end
