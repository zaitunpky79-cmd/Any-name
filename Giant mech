local TITLE = "TITAN"
local GLITCH = "#%&@$X0?/\\|"
local function scramble(p)
	local s = ""
	for i = 1, #TITLE do
		if i / #TITLE <= p then
			s ..= TITLE:sub(i, i)
		else
			local r = math.random(#GLITCH)
			s ..= GLITCH:sub(r, r)
		end
	end
	return s
end
