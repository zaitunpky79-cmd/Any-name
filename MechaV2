		s = Instance.new("Sound")
		s.SoundId = SND[key]
		s.Looped = true
		s.Volume = 0
		s.RollOffMinDistance = 250
		s.RollOffMaxDistance = 3000
		s.Parent = camPart
		s:Play()
		loops[key] = s
