	[Enum.KeyCode.One] = function() runSkill("Slash") end,
	[Enum.KeyCode.Two] = function() runSkill("Beam") end,
	[Enum.KeyCode.Three] = function() runSkill("Teleport") end,
	[Enum.KeyCode.Four] = function() toggleKneel() end,
	[Enum.KeyCode.Five] = function() toggleFly() end,
	[Enum.KeyCode.Six] = function() runSkill("FlySlash") end,
	[Enum.KeyCode.Seven] = function() runSkill("FlyBeam") end,
}
table.insert(S.conns, UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightControl then win.Visible = not win.Visible return end
	local f = KEYMAP[i.KeyCode]
	if f then f() end
end))
table.insert(S.conns, lp.CharacterAdded:Connect(function(c)
	refChar(c)
	if S.alive then refreshFilters() end
end))
table.insert(S.conns, RunService.RenderStepped:Connect(function(dt)
	local show = S.control and S.alive and not S.cut
	W2.pad.Visible = show
	W2.ctrlFloat.Visible = not S.cut
	if not show then for k in pairs(S.pad) do S.pad[k] = false end end
	if S.alive and hrp and hrp.Parent then
		local ok, err = pcall(step, math.min(dt, 0.05))
		if ok then
			applyTargets()
		else
			S.errT += dt
			if S.errT > 0.5 then S.errT = 0; notify("script error: " .. tostring(err), 6); warn("[ArchangelMichael] " .. tostring(err)) end
		end
	end
	S.statT += dt
	if S.statT > 0.4 then
		S.statT = 0
		syncButtons()
		if os.clock() > S.noticeUntil then
			if S.alive then
				local st = S.act and S.act:upper() or (S.cut and "CUTSCENE") or (S.kneel and "Kneeling") or (S.flying and "Flying") or (S.control and "Controlled") or "Idle"
				S.statusLbl.Text = string.format("%s | %d bricks | lost %d", st, #S.slots, S.lostN)
			else
				S.statusLbl.Text = string.format("Ready. Needs %d bricks of 10 sizes. Press Check bricks.", TOTAL)
			end
		end
	end
end))
table.insert(S.conns, RunService.Heartbeat:Connect(function() if S.alive then applyTargets() end end))
table.insert(S.conns, RunService.Stepped:Connect(function() if S.alive then applyTargets() end end))

