local SCALE = Color3.fromRGB(34, 96, 58)
local DARK = Color3.fromRGB(22, 64, 42)
local IVORY = Color3.fromRGB(228, 218, 190)
local MEMB = Color3.fromRGB(125, 38, 62)

local function mk(parent, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

local function cyl(parent, color)
	return mk(parent, Enum.PartType.Cylinder, V(1, 1, 1), CFrame.new(), color or SCALE, Enum.Material.Slate)
end

local function ball(parent, color)
	return mk(parent, Enum.PartType.Ball, V(1, 1, 1), CFrame.new(), color or SCALE, Enum.Material.Slate)
end

local function placeCyl(part, a, b, dia)
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		part.Size = V(0.05, dia, dia)
		part.CFrame = CFrame.new(a)
		return
	end
	local dir = d / len
	local up = math.abs(dir.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	part.Size = V(len, dia, dia)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
end

local function setBall(part, p, d)
	part.Size = V(d, d, d)
	part.CFrame = CFrame.new(p)
end

local LEGIDS = { "FL", "FR", "HL", "HR" }
local PANELS = { { 1, 2 }, { 2, 3 }, { 3, 4 }, { 4, "B" } } -- membrane triangles (spar pairs)
local STRIPS = 4

local function destroySkin()
	if skin then
		skin.model:Destroy()
		skin = nil
	end
end

local function buildSkin()
	destroySkin()
	local sz = S.size
	local model = Instance.new("Model")
	model.Name = "DragonSkin"
	skin = { model = model }

	skin.body = cyl(model)
	skin.hipB, skin.chestB = ball(model), ball(model)
	skin.belly = cyl(model, Color3.fromRGB(150, 170, 105))
	skin.neck, skin.neckB = {}, {}
	for i = 1, 3 do
		skin.neck[i] = cyl(model)
		skin.neckB[i] = ball(model)
	end
	skin.head = cyl(model)
	skin.jaw = cyl(model, DARK)
	skin.snoutB = ball(model)
	skin.horns = { cyl(model, IVORY), cyl(model, IVORY) }
	skin.eyes = {
		mk(model, Enum.PartType.Ball, V(1, 1, 1), CFrame.new(), Color3.fromRGB(255, 200, 40), Enum.Material.Neon),
		mk(model, Enum.PartType.Ball, V(1, 1, 1), CFrame.new(), Color3.fromRGB(255, 200, 40), Enum.Material.Neon),
	}
	skin.tail = {}
	for i = 1, 5 do skin.tail[i] = cyl(model) end
	skin.spade = mk(model, nil, V(1, 1, 1), CFrame.new(), DARK, Enum.Material.Slate)
	skin.legs = {}
	for _, id in ipairs(LEGIDS) do
		skin.legs[id] = {
			up = cyl(model), low = cyl(model), paw = cyl(model, DARK),
			knee = ball(model), ank = ball(model),
		}
	end
	skin.wings = {}
	for _, side in ipairs({ "L", "R" }) do
		local w = {
			arm = cyl(model, DARK), fore = cyl(model, DARK),
			spars = {}, joints = { ball(model, DARK), ball(model, DARK), ball(model, DARK) },
			strips = {},
		}
		for i = 1, 4 do w.spars[i] = cyl(model, DARK) end
		for pi = 1, #PANELS do
			w.strips[pi] = {}
			for i = 1, STRIPS do
				w.strips[pi][i] = mk(model, nil, V(1, 1, 1), CFrame.new(), MEMB, Enum.Material.SmoothPlastic, 0.18)
			end
		end
		skin.wings[side] = w
	end
	skin.spikes = {}
	for i = 1, 10 do
		skin.spikes[i] = mk(model, nil, V(1, 1, 1), CFrame.new(), IVORY, Enum.Material.Slate)
	end
	skin.saddle = mk(model, nil, V(1.3, 0.25, 1.6) * sz, CFrame.new(), Color3.fromRGB(110, 70, 40), Enum.Material.Leather)

	-- fire: emitters on an invisible mouth part
	skin.mouth = mk(model, nil, V(0.5, 0.5, 0.5), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic, 1)
	local function emitter(fire)
		local e = Instance.new("ParticleEmitter")
		e.Rate = 0
		e.EmissionDirection = Enum.NormalId.Front
		e.Rotation = NumberRange.new(0, 360)
		if fire then
			e.Lifetime = NumberRange.new(0.5, 0.9)
			e.Speed = NumberRange.new(10 * sz, 18 * sz)
			e.SpreadAngle = Vector2.new(9, 9)
			e.Color = ColorSequence.new(Color3.fromRGB(255, 225, 100), Color3.fromRGB(255, 70, 20))
			e.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.7 * sz),
				NumberSequenceKeypoint.new(1, 2.2 * sz),
			})
			e.Transparency = NumberSequence.new(0.1, 1)
			e.LightEmission = 1
		else
			e.Lifetime = NumberRange.new(1.2, 2.2)
			e.Speed = NumberRange.new(3 * sz, 6 * sz)
			e.SpreadAngle = Vector2.new(22, 22)
			e.Color = ColorSequence.new(Color3.fromRGB(70, 70, 75), Color3.fromRGB(35, 35, 40))
			e.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.6 * sz),
				NumberSequenceKeypoint.new(1, 2.4 * sz),
			})
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			})
			e.LightEmission = 0
		end
		e.Parent = skin.mouth
		return e
	end
	skin.fire = emitter(true)
	skin.smoke = emitter(false)

	local hl = Instance.new("Highlight")
	hl.Adornee = model
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(255, 170, 70)
	hl.OutlineTransparency = 0.3
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model

	model.Parent = workspace
end

-- one membrane triangle (origin, edge A, edge B) filled with thin strips
local function updatePanel(strips, origin, ea, eb, thick)
	local n = #strips
	local wdt = (eb - ea).Magnitude / n * 1.3
	local normal = (ea - origin):Cross(eb - origin)
	for i, part in ipairs(strips) do
		local tgt = ea:Lerp(eb, (i - 0.5) / n)
		local mid = (origin + tgt) / 2
		local len = (tgt - origin).Magnitude
		if len < 1e-3 or normal.Magnitude < 1e-6 then
			part.Size = V(0.05, 0.05, 0.05)
			part.CFrame = CFrame.new(mid)
		else
			part.Size = V(wdt, thick, len)
			part.CFrame = CFrame.lookAt(mid, tgt, normal)
		end
	end
end

local function updateSkin(J, bodyCF)
	local sz = S.size
	local function W(p) return bodyCF:PointToWorldSpace(p * sz) end
	local k = skin

	-- body
	local hip, mid, chest = W(J.hip), W(J.mid), W(J.chest)
	placeCyl(k.body, hip, chest, 1.7 * sz)
	placeCyl(k.belly, hip + bodyCF:VectorToWorldSpace(V(0, -0.45, 0)) * sz, chest + bodyCF:VectorToWorldSpace(V(0, -0.45, 0)) * sz, 1.2 * sz)
	setBall(k.hipB, hip, 1.7 * sz)
	setBall(k.chestB, chest, 1.9 * sz)

	-- neck + head
	local nj = { W(J.n0), W(J.n1), W(J.n2), W(J.n3) }
	local dias = { 1.0, 0.85, 0.7 }
	for i = 1, 3 do
		placeCyl(k.neck[i], nj[i], nj[i + 1], dias[i] * sz)
		setBall(k.neckB[i], nj[i + 1], dias[i] * 1.05 * sz)
	end
	local n3, snout = nj[4], W(J.snout)
	placeCyl(k.head, n3, snout, 0.85 * sz)
	setBall(k.snoutB, snout, 0.7 * sz)
	placeCyl(k.jaw, W(J.jawBase), W(J.jawTip), 0.5 * sz)
	for i = 1, 2 do
		placeCyl(k.horns[i], W(J.hornBase[i]), W(J.hornTip[i]), 0.2 * sz)
		setBall(k.eyes[i], W(J.eye[i]), 0.28 * sz)
	end

	-- tail
	local tdia = { 0.95, 0.8, 0.65, 0.5, 0.35 }
	for i = 1, 5 do
		placeCyl(k.tail[i], W(J["t" .. (i - 1)]), W(J["t" .. i]), tdia[i] * sz)
	end
	local t5 = W(J.t5)
	local td = (t5 - W(J.t4))
	local tup = Vector3.yAxis
	k.spade.Size = V(0.9, 0.12, 1.3) * sz
	k.spade.CFrame = CFrame.lookAt(t5 + td.Unit * 0.5 * sz, t5 + td.Unit * 2 * sz, tup)

	-- legs
	for _, id in ipairs(LEGIDS) do
		local lg = k.legs[id]
		local top, kn, an, to = W(J["top" .. id]), W(J["knee" .. id]), W(J["ank" .. id]), W(J["toe" .. id])
		placeCyl(lg.up, top, kn, 0.75 * sz)
		placeCyl(lg.low, kn, an, 0.55 * sz)
		placeCyl(lg.paw, an, to, 0.45 * sz)
		setBall(lg.knee, kn, 0.7 * sz)
		setBall(lg.ank, an, 0.5 * sz)
	end

	-- wings: bones + a membrane that stretches between the spars
	for _, side in ipairs({ "L", "R" }) do
		local w = k.wings[side]
		local S0, E, Wr = W(J["wS" .. side]), W(J["wE" .. side]), W(J["wW" .. side])
		placeCyl(w.arm, S0, E, 0.34 * sz)
		placeCyl(w.fore, E, Wr, 0.3 * sz)
		setBall(w.joints[1], S0, 0.5 * sz)
		setBall(w.joints[2], E, 0.42 * sz)
		setBall(w.joints[3], Wr, 0.4 * sz)
		local F = {}
		for i = 1, 4 do
			F[i] = W(J["wF" .. i .. side])
			placeCyl(w.spars[i], Wr, F[i], 0.17 * sz)
		end
		local B = W(J["wB" .. side])
		for pi, pr in ipairs(PANELS) do
			local ea = F[pr[1]]
			local eb = (pr[2] == "B") and B or F[pr[2]]
			updatePanel(w.strips[pi], Wr, ea, eb, 0.05 * sz)
		end
	end

	-- back spikes
	local up = bodyCF.UpVector
	for i, key in ipairs({ "t3", "t2", "t1", "hip", "mid", "chest", "n0", "n1", "n2", "n3" }) do
		local p = W(J[key])
		local nxt = (i < 10) and W(J[({ "t3", "t2", "t1", "hip", "mid", "chest", "n0", "n1", "n2", "n3" })[i + 1]]) or p
		local fwd = nxt - p
		local sp = k.spikes[i]
		local h = (i <= 3 and 0.35 or 0.55) * sz
		sp.Size = V(0.14 * sz, h, 0.35 * sz)
		local dirv = fwd.Magnitude > 1e-3 and fwd.Unit or -bodyCF.LookVector
		sp.CFrame = CFrame.lookAt(p + up * (0.8 * sz), p + up * (0.8 * sz) + dirv, up)
	end

	-- saddle on the back
	k.saddle.CFrame = CFrame.lookAt(W(J.seat) - up * 0.15 * sz, W(J.seat) - up * 0.15 * sz + bodyCF.LookVector, up)

	-- fire
	k.mouth.CFrame = CFrame.lookAt(snout, snout + bodyCF:VectorToWorldSpace(J.hd))
	local f = fireW
	k.fire.Rate = f > 0.25 and (140 * f) or 0
	k.smoke.Rate = f > 0.25 and (30 * f) or 0
end

