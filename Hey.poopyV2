local function makeButton(text, x, y, w, h, cb)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w, h)
	b.Position = UDim2.fromOffset(x, y)
	b.BackgroundColor3 = Color3.fromRGB(52, 52, 66)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 13
	b.Text = text
	b.BorderSizePixel = 0
	b.Parent = body
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

local function makeLabel(text, x, y, w)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromOffset(w, 28)
	l.Position = UDim2.fromOffset(x, y)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.Gotham
	l.TextSize = 13
	l.Parent = body
	return l
end

local function makeHoldButton(text, x, y, w, h, setHeld)
	local b = makeButton(text, x, y, w, h, function() end)
	b.MouseButton1Down:Connect(function() setHeld(true) end)
	b.MouseButton1Up:Connect(function() setHeld(false) end)
	b.MouseLeave:Connect(function() setHeld(false) end)
	return b
end

local buildBtn, modeBtn, autoBtn

----------------------------------------------------------------
-- Control mode + camera
----------------------------------------------------------------
local function restoreHum()
	if savedHum and savedHum.hum and savedHum.hum.Parent then
		local h = savedHum.hum
		h.WalkSpeed = savedHum.WalkSpeed
		h.JumpPower = savedHum.JumpPower
		h.JumpHeight = savedHum.JumpHeight
	end
	savedHum = nil
end

local function freezeHum(hum)
	if savedHum and savedHum.hum == hum then return end
	restoreHum()
	savedHum = {
		hum = hum,
		WalkSpeed = hum.WalkSpeed,
		JumpPower = hum.JumpPower,
		JumpHeight = hum.JumpHeight,
	}
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.JumpHeight = 0
end

local function applyMode(hum)
	-- walking is frozen only while you steer by hand
	if S.auto then restoreHum() else freezeHum(hum) end

	-- plane + manual + camera "follow" = scripted chase camera
	local chase = (S.mode == "plane") and (not S.auto) and S.camUFO and (not S.ride)
	S.chase = chase
	if chase then
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Scriptable
		end
		lastSubject = nil
	else
		if cam.CameraType ~= Enum.CameraType.Custom then
			cam.CameraType = Enum.CameraType.Custom
		end
		local want = hum
		if camPart and (not S.auto) and S.camUFO and (not S.ride) then want = camPart end
		if lastSubject ~= want then
			cam.CameraSubject = want
			lastSubject = want
		end
	end
end

local function setMode(newMode)
	if S.mode == newMode then return end
	S.mode = newMode
	if newMode == "plane" then
		-- start flying the way the craft is already moving (or the way you look)
		local hv = V(vel.X, 0, vel.Z)
		if hv.Magnitude > 2 then
			fwd = hv.Unit
		else
			local look = cam.CFrame.LookVector
			local f = V(look.X, 0, look.Z)
			fwd = f.Magnitude > 1e-3 and f.Unit or V(0, 0, -1)
		end
		pitch, bank = 0, 0
	end
	autoTarget = nil
	if modeBtn then modeBtn.Text = "Mode: " .. (newMode == "plane" and "Plane" or "UFO") end
	if S.active then setStatus(newMode == "plane" and "plane mode" or "UFO mode") end
end

local function pickTarget(root, t)
	local ang = math.random() * TAU
	local rad = math.random(80, 260)
	autoTarget = V(
		root.Position.X + math.cos(ang) * rad,
		root.Position.Y + math.random(45, 140),
		root.Position.Z + math.sin(ang) * rad
	)
	autoUntil = t + 16
end

----------------------------------------------------------------
-- Flight models
----------------------------------------------------------------
local function flyUfo(dt, root, hum, t)
	local targetVel
	if S.auto then
		if not autoTarget or (autoTarget - pos).Magnitude < 15 or t > autoUntil then
			pickTarget(root, t)
		end
		local d = autoTarget - pos
		targetVel = (d.Magnitude > 1e-3 and d.Unit or V(0, 0, 0)) * (S.speed * 0.75)
	else
		local md = hum.MoveDirection
		local v = (S.upHeld and 1 or 0) - (S.downHeld and 1 or 0)
		targetVel = V(md.X, 0, md.Z) * S.speed + V(0, v * S.speed * 0.6, 0)
	end
	vel = vel:Lerp(targetVel, 1 - math.exp(-dt * 1.8))
end

local function flyPlane(dt, root, hum, t)
	local desired, pitchTarget = nil, 0
	if S.auto then
		if not autoTarget or (autoTarget - pos).Magnitude < 40 or t > autoUntil then
			pickTarget(root, t)
		end
		local d = autoTarget - pos
		local flat = V(d.X, 0, d.Z)
		if flat.Magnitude > 1 then desired = flat.Unit end
		pitchTarget = math.clamp(d.Y / 80, -1, 1) * math.rad(28)
	else
		local md = hum.MoveDirection
		local flat = V(md.X, 0, md.Z)
		if flat.Magnitude > 0.1 then desired = flat.Unit end
		local v = (S.upHeld and 1 or 0) - (S.downHeld and 1 or 0)
		pitchTarget = v * math.rad(30)
	end

	-- turn toward the wanted heading at a limited rate
	local diff = 0
	if desired then
		local psi = math.atan2(-fwd.X, -fwd.Z)
		local psiD = math.atan2(-desired.X, -desired.Z)
		diff = (psiD - psi + math.pi) % TAU - math.pi
		psi += math.clamp(diff, -TURN_RATE * dt, TURN_RATE * dt)
		fwd = V(-math.sin(psi), 0, -math.cos(psi))
	end
	bank += (math.clamp(diff * 1.2, -0.9, 0.9) - bank) * math.min(1, dt * 4)
	pitch += (pitchTarget - pitch) * math.min(1, dt * 2.5)

	local speed = math.max(45, S.speed * 1.5)
	local dir = V(fwd.X * math.cos(pitch), math.sin(pitch), fwd.Z * math.cos(pitch))
	vel = vel:Lerp(dir * speed, 1 - math.exp(-dt * 2))
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local function step(dt)
	local root, hum = getRoot(), getHum()
	if not root or not hum then return end
	local t = tick()

	applyMode(hum)

	-- morph progress (1.2 s)
	local goal = (S.mode == "plane") and 1 or 0
	morph += math.clamp(goal - morph, -dt / 1.2, dt / 1.2)
	local m = smooth(morph)

	if S.mode == "plane" then
		flyPlane(dt, root, hum, t)
	else
		flyUfo(dt, root, hum, t)
	end
	pos += vel * dt

	-- ground clearance
	local ignore = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ignore, folder) end
	if skin then table.insert(ignore, skin.model) end
	rayParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(V(pos.X, pos.Y + 300, pos.Z), V(0, -2000, 0), rayParams)
	local groundY = hit and hit.Position.Y or nil
	if groundY then
		local minY = groundY + S.size * 1.4
		if pos.Y < minY then
			pos = V(pos.X, pos.Y + (minY - pos.Y) * math.min(1, dt * 6), pos.Z)
			vel = V(vel.X, math.max(vel.Y, 0), vel.Z)
		end
	end
	-- indestructible: never fall into the void
	if S.safe then
		local floor = workspace.FallenPartsDestroyHeight + 100
		if pos.Y < floor then
			pos = V(pos.X, floor, pos.Z)
			vel = V(vel.X, math.max(vel.Y, 0), vel.Z)
		end
	end

	spin += dt * 0.9
	prop += dt * 30

	-- body orientation for each shape, blended by the morph
	local hv = V(vel.X, 0, vel.Z)
	local tilt = CFrame.new()
	if hv.Magnitude > 1 then
		local axis = Vector3.yAxis:Cross(hv.Unit)
		tilt = CFrame.fromAxisAngle(axis, math.clamp(hv.Magnitude / S.speed, 0, 1.2) * math.rad(18))
	end
	local wob = CFrame.Angles(math.sin(t * 1.7) * 0.03, 0, math.cos(t * 1.3) * 0.03)
	local ufoBody = CFrame.new(pos + V(0, math.sin(t * 1.2) * 0.6, 0)) * tilt * wob

	local fwdF = V(fwd.X * math.cos(pitch), math.sin(pitch), fwd.Z * math.cos(pitch))
	local planeBody = CFrame.lookAt(pos, pos + fwdF) * CFrame.Angles(0, 0, bank)

	local bodyCF = ufoBody:Lerp(planeBody, m)
	local sz = S.size

	-- camera anchor / chase camera
	if camPart then camPart.CFrame = CFrame.new(bodyCF.Position) end
	if S.chase then
		local camPos = pos - fwdF * (sz * 10) + V(0, sz * 3, 0)
		local target = CFrame.lookAt(camPos, pos + fwdF * (sz * 8))
		cam.CFrame = cam.CFrame:Lerp(target, math.min(1, dt * 5))
	end

	-- ride on top (optional)
	if S.ride then
		local seat = bodyCF:PointToWorldSpace(V(0, 2.7 * sz + 3, 0):Lerp(V(0, 1.0 * sz + 3, -1.6 * sz), m))
		root.CFrame = CFrame.new(seat) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	-- detailed skin: show the shape we are (becoming)
	if S.skin and skin then
		local showPlane = m >= 0.5
		if skin.showPlane ~= showPlane then
			skin.showPlane = showPlane
			skin.ufoG.Parent = (not showPlane) and skin.model or nil
			skin.planeG.Parent = showPlane and skin.model or nil
		end
		if showPlane then
			skin.plane.body:PivotTo(bodyCF)
			skin.plane.prop:PivotTo(bodyCF * CFrame.new(0, 0, -4.45 * sz) * CFrame.Angles(0, 0, prop))
			skin.plane.strobe.Transparency = (math.floor(t * 3) % 2 == 0) and 0 or 1
		else
			local u = skin.ufo
			u.hull:PivotTo(bodyCF)
			u.lights:PivotTo(bodyCF * CFrame.Angles(0, -spin, 0))
			local n = #u.rimLights
			for i, p in ipairs(u.rimLights) do
				p.Color = Color3.fromHSV((t * 0.25 + i / n) % 1, 0.8, 1)
			end
			local beamLen = groundY and ((bodyCF.Position.Y - 0.95 * sz) - groundY) or 0
			if S.beam and beamLen > 2 then
				u.beam.Transparency = 0.8
				u.beam.Size = V(beamLen, 3.5 * sz, 3.5 * sz)
				u.beam.CFrame = CFrame.new(bodyCF.Position - V(0, 0.95 * sz + beamLen / 2, 0))
					* CFrame.Angles(0, 0, math.pi / 2)
			else
				u.beam.Transparency = 1
			end
		end
	end

	-- indestructible upkeep: one toy re-claimed every 0.1 s, refill every 1.5 s
	if S.safe then
		safeTimer += dt
		if safeTimer >= 0.1 and #claimed > 0 then
			safeTimer = 0
			reclaimIdx = reclaimIdx % #claimed + 1
			local c = claimed[reclaimIdx]
			if c.part.Parent then
				if not ownsPart(c.part) then claim(c.part) end
				c.part.CanCollide = false
			end
		end
		refillTimer += dt
		if refillTimer >= 1.5 then
			refillTimer = 0
			refill()
		end
	end

	-- toys form the craft
	local rot = bodyCF.Rotation
	for _, c in ipairs(claimed) do
		local part = c.part
		if part.Parent then
			local u = ufoLocal(U[c.si], spin)
			local p = planeLocal(PL[c.si], prop)
			local lp3 = u:Lerp(p, m)
			if m > 0 and m < 1 then lp3 += V(0, math.sin(m * math.pi) * 2.5, 0) end
			local target = bodyCF:PointToWorldSpace(lp3 * sz)

			if S.safe then
				makeMovers(c) -- rebuild movers if something removed them
				local lv = part.AssemblyLinearVelocity
				if lv.Magnitude > S.speed * 3 + 250 then -- flung: stop it
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
				if (part.Position - target).Magnitude > 300 then -- thrown away: pull it back
					part.CFrame = CFrame.new(target)
				end
			end
			c.bp.Position = target
			c.bg.CFrame = rot
		end
	end
end

----------------------------------------------------------------
-- Summon / release
----------------------------------------------------------------
local function release()
	S.active = false
	if heartbeat then heartbeat:Disconnect() heartbeat = nil end
	for _, c in ipairs(claimed) do
		if c.bp then c.bp:Destroy() end
		if c.bg then c.bg:Destroy() end
		if c.part and c.part.Parent then c.part.CanCollide = c.oldCollide end
	end
	claimed = {}
	claimedSet = {}
	destroySkin()
	restoreHum()
	cam.CameraType = Enum.CameraType.Custom
	local hum = getHum()
	if hum then cam.CameraSubject = hum end
	lastSubject = nil
	if camPart then camPart:Destroy() camPart = nil end
	if buildBtn then buildBtn.Text = "Summon" end
	setStatus("released")
end

local function build()
	if S.busy or S.active then return end
	local root = getRoot()
	if not root then setStatus("no character") return end

	local parts = getToyParts()
	if #parts == 0 then setStatus("no toys found") return end

	S.busy = true
	setStatus("claiming toys...")
	local origin = root.CFrame
	local teleported = false

	for i = 1, math.min(#U, #parts) do
		local part = parts[i]
		if part.Parent then
			-- only move if the toy is out of grab range
			if (part.Position - root.Position).Magnitude > 30 then
				root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
				teleported = true
				task.wait(0.08)
			end
			if claim(part) then
				addToy(part, #claimed + 1)
			end
		end
	end
	if teleported then root.CFrame = origin end

	if #claimed == 0 then
		S.busy = false
		setStatus("no toys claimed")
		return
	end

	-- take off ahead of you, up in the air
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 1e-3 and flat.Unit or V(0, 0, -1)
	pos = root.Position + flat * 50 + V(0, 35, 0)
	vel = Vector3.zero
	fwd = flat
	pitch, bank = 0, 0
	morph = (S.mode == "plane") and 1 or 0
	autoTarget = nil

	camPart = Instance.new("Part")
	camPart.Name = "UFOCam"
	camPart.Anchored = true
	camPart.CanCollide = false
	camPart.CanQuery = false
	camPart.CanTouch = false
	camPart.Transparency = 1
	camPart.Size = V(1, 1, 1)
	camPart.CFrame = CFrame.new(pos)
	camPart.Parent = workspace

	if S.skin then buildSkin() end

	S.active = true
	buildBtn.Text = "Dismiss"
	setStatus(("flying (%d toys)"):format(#claimed))
	heartbeat = RunService.Heartbeat:Connect(step)
	S.busy = false
end

----------------------------------------------------------------
-- Controls
----------------------------------------------------------------
buildBtn = makeButton("Summon", 10, 24, 180, 30, function()
	if S.active then release() else task.spawn(build) end
end)

modeBtn = makeButton("Mode: UFO", 10, 58, 88, 30, function()
	setMode(S.mode == "ufo" and "plane" or "ufo")
end)

autoBtn = makeButton("Auto: OFF", 102, 58, 88, 30, function(b)
	S.auto = not S.auto
	b.Text = "Auto: " .. (S.auto and "ON" or "OFF")
	b.BackgroundColor3 = S.auto and Color3.fromRGB(70, 110, 200) or Color3.fromRGB(52, 52, 66)
	autoTarget = nil
	if S.active then setStatus(S.auto and "autopilot" or "manual flight") end
end)

makeHoldButton("▲ Up", 10, 92, 88, 28, function(h) S.upHeld = h end)
makeHoldButton("▼ Down", 102, 92, 88, 28, function(h) S.downHeld = h end)

local speedLabel = makeLabel("Speed: 60", 10, 124, 90)
makeButton("-", 104, 124, 40, 28, function()
	S.speed = math.max(20, S.speed - 10)
	speedLabel.Text = "Speed: " .. S.speed
end)
makeButton("+", 150, 124, 40, 28, function()
	S.speed = math.min(250, S.speed + 10)
	speedLabel.Text = "Speed: " .. S.speed
end)

local sizeLabel = makeLabel("Size: 6", 10, 154, 90)
local function changeSize(delta)
	S.size = math.clamp(S.size + delta, 3, 12)
	sizeLabel.Text = "Size: " .. S.size
	if S.active and S.skin then buildSkin() end -- rebuilt at the new size
end
makeButton("-", 104, 154, 40, 28, function() changeSize(-1) end)
makeButton("+", 150, 154, 40, 28, function() changeSize(1) end)

makeButton("Beam: ON", 10, 186, 88, 28, function(b)
	S.beam = not S.beam
	b.Text = "Beam: " .. (S.beam and "ON" or "OFF")
end)
makeButton("Ride: OFF", 102, 186, 88, 28, function(b)
	S.ride = not S.ride
	b.Text = "Ride: " .. (S.ride and "ON" or "OFF")
end)

makeButton("Skin: ON", 10, 218, 88, 28, function(b)
	S.skin = not S.skin
	b.Text = "Skin: " .. (S.skin and "ON" or "OFF")
	if S.active then
		if S.skin then buildSkin() else destroySkin() end
	end
end)
makeButton("Cam: Follow", 102, 218, 88, 28, function(b)
	S.camUFO = not S.camUFO
	b.Text = "Cam: " .. (S.camUFO and "Follow" or "Me")
end)

makeButton("Indestructible: ON", 10, 250, 180, 28, function(b)
	S.safe = not S.safe
	b.Text = "Indestructible: " .. (S.safe and "ON" or "OFF")
	b.BackgroundColor3 = S.safe and Color3.fromRGB(60, 130, 80) or Color3.fromRGB(52, 52, 66)
end).BackgroundColor3 = Color3.fromRGB(60, 130, 80)

-- PC keys: Space = up, Shift = down, M = switch mode
table.insert(conns, UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.Space then S.upHeld = true
	elseif input.KeyCode == Enum.KeyCode.LeftShift then S.downHeld = true
	elseif input.KeyCode == Enum.KeyCode.M then setMode(S.mode == "ufo" and "plane" or "ufo") end
end))
table.insert(conns, UIS.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Space then S.upHeld = false
	elseif input.KeyCode == Enum.KeyCode.LeftShift then S.downHeld = false end
end))

-- Close / unload
local function unload()
	S.dead = true
	release()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	if gui then gui:Destroy() end
	env.FTAPUfoUnload = nil
end
env.FTAPUfoUnload = unload

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(24, 24)
close.Position = UDim2.new(1, -30, 0, 4)
close.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.Font = Enum.Font.GothamBold
close.TextSize = 12
close.BorderSizePixel = 0
close.Parent = main
Instance.new("UICorner", close).CornerRadius = UDim.new(0, 6)
close.MouseButton1Click:Connect(unload)

local mini = Instance.new("TextButton")
mini.Size = UDim2.fromOffset(24, 24)
mini.Position = UDim2.new(1, -58, 0, 4)
mini.BackgroundColor3 = Color3.fromRGB(52, 52, 66)
mini.Text = "-"
mini.TextColor3 = Color3.new(1, 1, 1)
mini.Font = Enum.Font.GothamBold
mini.TextSize = 14
mini.BorderSizePixel = 0
mini.Parent = main
Instance.new("UICorner", mini).CornerRadius = UDim.new(0, 6)
local minimized = false
mini.MouseButton1Click:Connect(function()
	minimized = not minimized
	body.Visible = not minimized
	main.Size = minimized and UDim2.fromOffset(200, 32) or UDim2.fromOffset(200, GUI_H)
	mini.Text = minimized and "+" or "-"
end)

-- Dragging (kept on screen)
do
	local dragging, dragStart, startPos
	title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	table.insert(conns, UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			local vp = gui.AbsoluteSize
			local nx = math.clamp(startPos.X.Offset + d.X, 0, math.max(0, vp.X - main.AbsoluteSize.X))
			local ny = math.clamp(startPos.Y.Offset + d.Y, 0, math.max(0, vp.Y - 40))
			main.Position = UDim2.new(0, nx, 0, ny)
		end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end
