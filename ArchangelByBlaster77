-- EFFECT BRICKS (parked underground, borrowed by the skills) -----------------------------------------------------------------------------------------------
local function fxTake(tp, n, color, neon)
	local out = {}
	local free = S.fxFree[tp]
	if not free then return out end
	for _ = 1, n do
		local s = table.remove(free)
		if not s then break end
		s.use = nil
		pcall(function()
			s.p.Color = color or COL.LIGHT
			s.p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
			s.p.Transparency = 0
		end)
		out[#out + 1] = s
	end
	return out
end
local function fxGive(list)
	for _, s in ipairs(list) do
		s.use = nil
		local free = S.fxFree[s.tp]
		if free then free[#free + 1] = s end
	end
end
local function scatter(list, center, power, secs) -- bricks burst apart with gravity, then return
	local vel = {}
	for i, s in ipairs(list) do
		local p = s.use and s.use.Position or center
		local d = p - center
		d = (d.Magnitude > 0.1) and d.Unit or V(0, 1, 0)
		vel[i] = d * power * (0.5 + math.random() * 0.8) + V(0, power * 0.6, 0)
	end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < secs do
			local dt = RunService.Heartbeat:Wait()
			for i, s in ipairs(list) do
				vel[i] = vel[i] + V(0, -45 * dt, 0)
				if s.use then
					s.use = s.use * CFrame.Angles(dt * 3, dt * 2, 0)
					s.use = s.use + vel[i] * dt
					pcall(function() s.p.Transparency = clamp((os.clock() - t0) / secs, 0, 1) end)
				end
			end
		end
		fxGive(list)
	end)
end
local function ringBricks(center, r0, r1, n, tp, secs, color) -- ring of bricks racing outward along the ground
	local list = fxTake(tp, n, color or COL.GOLD, true)
	n = #list
	if n == 0 then return end
	task.spawn(function()
		local t0 = os.clock()
		while true do
			local k = (os.clock() - t0) / secs
			if k >= 1 then break end
			local r = mix(r0, r1, smooth(k))
			for i, s in ipairs(list) do
				local a = i / n * TAU
				local dir = V(math.cos(a), 0, math.sin(a))
				s.use = yAxisCF(center + dir * r + V(0, 2, 0), dir, V(0, 1, 0))
				pcall(function() s.p.Transparency = clamp(k * 1.3 - 0.3, 0, 1) end)
			end
			RunService.Heartbeat:Wait()
		end
		fxGive(list)
	end)
end
local function feathers(center, n, secs) -- drifting light feathers
	local list = fxTake("K", n, COL.WHITE, true)
	local r = fxTake("R", math.floor(n / 2), COL.LIGHT, true)
	for _, s in ipairs(r) do list[#list + 1] = s end
	local vel = {}
	for i, s in ipairs(list) do
		s.use = CFrame.new(center + V((math.random() - 0.5) * 10, math.random() * 4, (math.random() - 0.5) * 10))
		vel[i] = V((math.random() - 0.5) * 14, 10 + math.random() * 16, (math.random() - 0.5) * 14)
	end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < secs do
			local dt = RunService.Heartbeat:Wait()
			local k = (os.clock() - t0) / secs
			for i, s in ipairs(list) do
				vel[i] = vel[i] + V(math.sin(os.clock() * 2 + i) * 6 * dt, -9 * dt, math.cos(os.clock() * 2 + i) * 6 * dt)
				if s.use then
					s.use = s.use * CFrame.Angles(dt * 2, dt * 3, dt) + vel[i] * dt
					pcall(function() s.p.Transparency = clamp(k * 1.2 - 0.2, 0, 1) end)
				end
			end
		end
		fxGive(list)
	end)
end
-- a chain of 2x2x4 bricks between two points (re-aimed every frame), plus swirling sparks
local function beamFx(getFrom, getTo, secs, color, maxD, thick)
	local list = fxTake("D", maxD or 16, color or COL.LIGHT, true)
	local sheath = thick and fxTake("T", 10, COL.GOLD, true) or {}
	local sparks = fxTake("C", 8, COL.WHITE, true)
	if #list == 0 then return end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < secs do
			local el = os.clock() - t0
			local a, b = getFrom(), getTo()
			local d = b - a
			local len = d.Magnitude
			if len > 1 then
				local dir = d.Unit
				local ref = (math.abs(dir.Y) > 0.9) and V(1, 0, 0) or V(0, 1, 0)
				local u = dir:Cross(ref).Unit
				local v = dir:Cross(u).Unit
				local grow = smooth(el / 0.12)
				local fade = clamp((secs - el) / 0.3, 0, 1)
				for i, s in ipairs(list) do
					local off = 2 + (i - 1) * 4
					if off - 2 < len * grow then
						s.use = yAxisCF(a + dir * off, dir, ref)
						pcall(function() s.p.Transparency = 1 - fade end)
					else
						s.use = nil
					end
				end
				for i, s in ipairs(sheath) do
					local off = 2 + (i - 1) * 6
					local ang = el * 8 + i * 1.3
					if off - 2 < len * grow then
						s.use = yAxisCF(a + dir * off + (u * math.cos(ang) + v * math.sin(ang)) * 4.2, dir, u * math.cos(ang) + v * math.sin(ang))
						pcall(function() s.p.Transparency = 0.2 + (1 - fade) * 0.8 end)
					else
						s.use = nil
					end
				end
				for i, s in ipairs(sparks) do
					local f = (i / #sparks + el * 1.7) % 1
					local ang = i * 1.3 + el * 20
					s.use = CFrame.new(a + dir * (f * len * grow) + (u * math.cos(ang) + v * math.sin(ang)) * 3)
					pcall(function() s.p.Transparency = 1 - fade end)
				end
			end
			RunService.Heartbeat:Wait()
		end
		fxGive(list)
		fxGive(sheath)
		fxGive(sparks)
	end)
end
-- crescent of light (thin 1x4x4 panels) flying forward
local function crescent(origin, dir, side, secs, radius)
	local list = fxTake("T", 10, COL.LIGHT, true)
	local n = #list
	if n == 0 then return end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < secs do
			local k = (os.clock() - t0) / secs
			local c = origin + dir * (k * 80)
			for i, s in ipairs(list) do
				local th = (i / (n + 1) - 0.5) * 2.6
				local radial = dir * math.cos(th) + side * math.sin(th)
				local tangent = -dir * math.sin(th) + side * math.cos(th)
				s.use = yAxisCF(c + radial * (radius or 13) * (1 - k * 0.25), tangent, V(0, 1, 0))
				pcall(function() s.p.Transparency = clamp(k * 1.25 - 0.25, 0, 1) end)
			end
			RunService.Heartbeat:Wait()
		end
		fxGive(list)
	end)
end

-- aiming ------------------------------------------------------------------------------------------------------------------------------------------------------
local function targetHrp(pl)
	local c = pl and pl.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function findPlayer(txt)
	txt = string.lower(txt or ""):match("^%s*(.-)%s*$")
	if txt == "" then return nil end
	local partial
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= lp then
			local n, d = pl.Name:lower(), pl.DisplayName:lower()
			if n == txt or d == txt then return pl end
			if not partial and (n:sub(1, #txt) == txt or d:sub(1, #txt) == txt) then partial = pl end
		end
	end
	return partial
end
local function nearestOther()
	local best, bd
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= lp then
			local th = targetHrp(pl)
			if th then
				local d = (th.Position - hrp.Position).Magnitude
				if d < 150 and (not bd or d < bd) then best, bd = pl, d end
			end
		end
	end
	return best
end
local function F3(h) return V(-math.sin(h), 0, -math.cos(h)) end
local function flatDir(v)
	local f = V(v.X, 0, v.Z)
	return (f.Magnitude > 0.01) and f.Unit or V(0, 0, -1)
end
local function aimPoint()
	local th = targetHrp(S.targetPl or nearestOther())
	if th then return th.Position end
	return V(S.pos.X, S.gy, S.pos.Z) + F3(S.hd) * 50
end
local function headingTo(from, to)
	local d = V(to.X - from.X, 0, to.Z - from.Z)
	if d.Magnitude < 0.01 then return S.hd end
	return math.atan2(-d.X, -d.Z)
end
local function poseSet(t, rate)
	for k in pairs(S.poseT) do S.poseT[k] = t[k] or 0 end
	S.poseRate = rate or 7
end
local function wt(x) task.wait(x) end
local function glide(dest, h, secs) -- move Michael (position + flight height) smoothly
	local p0, h0 = S.pos, S.h
	local t0 = os.clock()
	while true do
		local k = (os.clock() - t0) / secs
		if k >= 1 or S.skip then break end
		local e = smooth(k)
		S.pos = V(mix(p0.X, dest.X, e), 0, mix(p0.Z, dest.Z, e))
		S.h = mix(h0, h, e)
		RunService.Heartbeat:Wait()
	end
	S.pos = V(dest.X, 0, dest.Z)
	S.h = h
end
local function swordTipPos() return S.swTip end

-- SKILLS ---------------------------------------------------------------------------------------------------------------------------------------------------------
local skills = {}
local UP = V(0, 1, 0)
local IDLE_POSE = {armR = 0.1, foreR = 0.9}

function skills.Slash()
	shout("DIVINE SLASH")
	local a = aimPoint()
	S.faceH = headingTo(S.pos, a)
	local dir = F3(headingTo(S.pos, a))
	local side = V(-dir.Z, 0, dir.X)
