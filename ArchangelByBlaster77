-- BRICK DETECTION --------------------------------------------------------------------------------------------------------------------------------------
local function getFolder()
	local f = workspace
	for _, n in ipairs(CFG.PATH) do f = f and f:FindFirstChild(n) end
	if f then return f end
	local b = workspace:FindFirstChild("Bricks")
	return b and (b:FindFirstChild(lp.Name) or b:FindFirstChild(lp.DisplayName)) or nil
end
local function owned(p)
	if not isnetworkowner then return true end
	local ok, r = pcall(isnetworkowner, p)
	return (not ok) or r
end
local function usable(p)
	if not p or not p.Parent or p:IsDescendantOf(char) then return false end
	if p.Anchored then return false end
	local okJ, joints = pcall(function() return p:GetJoints() end)
	if okJ and #joints > 0 then return false end
	return true
end
local function dimsMatch(a, b)
	return math.abs(a[1] - b[1]) < CFG.TOL and math.abs(a[2] - b[2]) < CFG.TOL and math.abs(a[3] - b[3]) < CFG.TOL
end
local function dimsName(d)
	return string.format("%gx%gx%g", math.floor(d[1] * 10 + 0.5) / 10, math.floor(d[2] * 10 + 0.5) / 10, math.floor(d[3] * 10 + 0.5) / 10)
end
local function scan()
	local folder = getFolder()
	if not folder then return nil, "workspace.Bricks.master_ofbuilds not found" end
	local byType, other, unusable = {}, {}, {}
	for _, t in ipairs(TYPES) do byType[t.id] = {}; unusable[t.id] = 0 end
	local base = hrp.Position
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("BasePart") and d.Parent and not d:IsDescendantOf(char) then
			local sz = d.Size
			local a = {sz.X, sz.Y, sz.Z}
			table.sort(a)
			local tid
			for _, t in ipairs(TYPES) do
				if dimsMatch(a, t.dims) then tid = t.id break end
			end
			if usable(d) then
				if tid then
					local l = byType[tid]
					l[#l + 1] = {d, (d.Position - base).Magnitude, owned(d) and 0 or 1}
				else
					local key = dimsName(a)
					if not other[key] then other[key] = {n = 0, dims = a, key = key} end
					other[key].n += 1
				end
			elseif tid then
				unusable[tid] += 1
			end
		end
	end
	for _, l in pairs(byType) do
		table.sort(l, function(x, y)
			if x[3] ~= y[3] then return x[3] < y[3] end
			return x[2] < y[2]
		end)
	end
	return byType, other, unusable
end
local function diagnose(byType, other, unusable)
	local lines, ok = {}, true
	local otherList = {}
	for _, g in pairs(other) do otherList[#otherList + 1] = g end
	table.sort(otherList, function(x, y) return x.n > y.n end)
	for _, t in ipairs(TYPES) do
		local need, have = NEED[t.id], #byType[t.id]
		local nm = dimsName(t.dims)
		if have < need then
			ok = false
			lines[#lines + 1] = string.format("[X] %s: need %d, have %d -> %d MISSING", nm, need, have, need - have)
			local best, bd
			for _, g in ipairs(otherList) do
				local dist = math.abs(g.dims[1] - t.dims[1]) + math.abs(g.dims[2] - t.dims[2]) + math.abs(g.dims[3] - t.dims[3])
				if not bd or dist < bd then best, bd = g, dist end
			end
			if best then lines[#lines + 1] = string.format("    wrong size nearby: %s x%d", best.key, best.n) end
		elseif have > need then
			lines[#lines + 1] = string.format("[!] %s: need %d, have %d (%d extra, unused)", nm, need, have, have - need)
		else
			lines[#lines + 1] = string.format("[OK] %s: need %d, have %d", nm, need, have)
		end
		if unusable[t.id] > 0 then
			lines[#lines + 1] = string.format("    %d more %s are anchored/welded (cannot use)", unusable[t.id], nm)
		end
	end
	if #otherList > 0 then
		local parts = {}
		for i = 1, math.min(3, #otherList) do parts[#parts + 1] = otherList[i].key .. " x" .. otherList[i].n end
		lines[#lines + 1] = "other sizes in your folder: " .. table.concat(parts, ", ")
	end
	return ok, lines
end
local AXV = {x = V(1, 0, 0), y = V(0, 1, 0), z = V(0, 0, 1)}
local function orientFor(p, code)
	code = code or "xzy"
	local sz = {p.Size.X, p.Size.Y, p.Size.Z}
	local idx = {1, 2, 3}
	table.sort(idx, function(a, b) return sz[a] < sz[b] end)
	local ax = {}
	for k = 1, 3 do ax[idx[k]] = AXV[code:sub(k, k)] end
	return CFrame.fromMatrix(V(), ax[1], ax[2])
end
local function yAxisCF(pos, y, ref)
	if y.Magnitude < 1e-4 then return CFrame.new(pos) end
	y = y.Unit
	local x = ref:Cross(y)
	if x.Magnitude < 1e-3 then x = V(1, 0, 0):Cross(y) end
	if x.Magnitude < 1e-3 then x = V(0, 0, 1):Cross(y) end
	return CFrame.fromMatrix(pos, x.Unit, y)
end

