	TweenService:Create(CN.barTop, ti, {Size = UDim2.new(1, 0, 0.12, 0)}):Play()
	TweenService:Create(CN.barBot, ti, {Size = UDim2.new(1, 0, 0.12, 0)}):Play()
end
local function cineHide()
	fadeText(CN.title, 1, 0.4)
	fadeText(CN.sub, 1, 0.4)
	CN.speech.Text = ""
	CN.fade.Visible = false
	CN.skipBtn.Visible = false
	local ti = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(CN.barTop, ti, {Size = UDim2.new(1, 0, 0, 0)}):Play()
	TweenService:Create(CN.barBot, ti, {Size = UDim2.new(1, 0, 0, 0)}):Play()
	if CN.win then CN.win.Visible = CN.winWas ~= false end
	if CN.open then CN.open.Visible = true end
	task.delay(0.8, function()
		if not S.cut then
			CN.barTop.Visible, CN.barBot.Visible, CN.title.Visible, CN.sub.Visible = false, false, false, false
		end
	end)
end
local function startCine(camFn)
	S.cut, S.skip, S.busy = true, false, true
	S.camT0, S.camFn = os.clock(), camFn
	pcall(function() S.walk = hum.WalkSpeed; hum.WalkSpeed = 0 end)
	cam.CameraType = Enum.CameraType.Scriptable
	cineShow()
	local baseFov = cam.FieldOfView
	task.spawn(function()
		while S.cut do
			local dt = RunService.RenderStepped:Wait()
			S.flare = math.max(0, S.flare - dt * 2)
			local ok, pos, target, fov = pcall(S.camFn, os.clock() - S.camT0)
			if ok and pos then
				local jit = V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (S.flare * 5)
				cam.CFrame = CFrame.lookAt(pos + jit, target)
				cam.FieldOfView = fov or 60
			end
		end
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = baseFov
	end)
end
local function endCine()
	S.cut, S.busy, S.camFn, S.skip = false, false, nil, false
	if S.walk then pcall(function() hum.WalkSpeed = S.walk end); S.walk = nil end
	cineHide()
end
local function W(sec) -- abortable wait
	local t0 = os.clock()
	while os.clock() - t0 < sec do
		if S.skip or not S.alive then return true end
		RunService.Heartbeat:Wait()
	end
	return S.skip or not S.alive
end
local function typewrite(text, secs) -- subtitle, one letter at a time. returns true if skipped
	local n = #text
	for i = 1, n do
		if S.skip or not S.alive then return true end
		CN.speech.Text = text:sub(1, i)
		sfx("holy", 0.25, 1 + (i % 3) * 0.1)
		task.wait(secs / n)
	end
	return false
end

-- per-frame step ---------------------------------------------------------------------------------------------------------------------------------------------------
local function getMove()
	local x, z = 0, 0
	if not UIS:GetFocusedTextBox() then
		if UIS:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
		if UIS:IsKeyDown(Enum.KeyCode.S) then z += 1 end
		if UIS:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
		if UIS:IsKeyDown(Enum.KeyCode.D) then x += 1 end
	end
	local pad = S.pad
	if pad.f then z -= 1 end
	if pad.b then z += 1 end
	if pad.l then x -= 1 end
	if pad.r then x += 1 end
	local v = V(x, 0, z)
	if v.Magnitude < 0.05 then return V() end
	if v.Magnitude > 1 then v = v.Unit end
	local w = cam.CFrame:VectorToWorldSpace(v)
	w = V(w.X, 0, w.Z)
	if w.Magnitude < 0.01 then return V() end
	return w.Unit * v.Magnitude
end

local function step(dt)
	local t = os.clock()
	local pose = S.pose
	local P = hrp.CFrame

	-- movement: control (pad / WASD) or follow the owner
	local wantDir, tgtSp = nil, 0
	if not (S.act or S.cut or S.busy or S.kneel) then
		local top = S.flying and CFG.FLY or CFG.WALK
		if S.control then
			local mv = getMove()
			if mv.Magnitude > 0.1 then wantDir, tgtSp = mv.Unit, top * math.min(1, mv.Magnitude + 0.15) end
			if S.flying then
				local up = S.pad.u or (not UIS:GetFocusedTextBox() and UIS:IsKeyDown(Enum.KeyCode.Space))
				local dn = S.pad.d or (not UIS:GetFocusedTextBox() and UIS:IsKeyDown(Enum.KeyCode.LeftShift))
				if up or dn then S.flyTarget = clamp(S.flyTarget + ((up and 1 or 0) - (dn and 1 or 0)) * 30 * dt, 6, 140) end
			end
		else
			local owner = P.Position
			local fp = (P * CFrame.new(-9, 0, 9)).Position
			local flat = V(fp.X - S.pos.X, 0, fp.Z - S.pos.Z)
			local dist = flat.Magnitude
			if dist > 150 then
				S.pos = V(fp.X, 0, fp.Z)
			elseif dist > 14 then
				wantDir, tgtSp = flat.Unit, top * clamp((dist - 12) / 20, 0.25, 1)
			end
			local toOwner = V(owner.X - S.pos.X, 0, owner.Z - S.pos.Z)
			if not wantDir and toOwner.Magnitude > 1 then
				S.hd += clamp(adiff(math.atan2(-toOwner.X, -toOwner.Z), S.hd) * math.min(1, dt * 2), -2 * dt, 2 * dt)
			end
		end
	end
	if S.faceH then
		S.hd += clamp(adiff(S.faceH, S.hd) * math.min(1, dt * 6), -5 * dt, 5 * dt)
	elseif wantDir then
		local d = adiff(math.atan2(-wantDir.X, -wantDir.Z), S.hd)
		S.hd += clamp(d * math.min(1, dt * 4), -3 * dt, 3 * dt)
	end
	local F = F3(S.hd)
	S.curSp += (tgtSp - S.curSp) * math.min(1, dt * ((tgtSp > S.curSp) and 2.2 or 4))
	local prev = S.pos
	if S.curSp > 0.2 then S.pos = S.pos + F * S.curSp * dt end
	if S.dash then
		S.dash.t -= dt
		S.pos = S.pos + F * S.dash.spd * dt
		if S.dash.t <= 0 then S.dash = nil end
	end
	if S.hold and not S.act and os.clock() > S.hold then S.hold = nil end
	local newGy = groundAt(V(S.pos.X, P.Position.Y + 30, S.pos.Z), 40)
	if math.abs(newGy - S.gy) > 14 then S.gy = newGy else S.gy += (newGy - S.gy) * clamp(dt * 8, 0, 1) end
	if not (S.act or S.cut) then
		local targetH = S.flying and S.flyTarget or 0
		S.h += (targetH - S.h) * clamp(dt * 2.4, 0, 1)
		if not S.flying and S.h < 0.05 then S.h = 0 end
	end
	local rawV = (S.pos - prev) / math.max(dt, 1e-3)
	if rawV.Magnitude > 220 then rawV = V() end
	S.vel = S.vel:Lerp(rawV, clamp(dt * 8, 0, 1))
	local sp = S.vel.Magnitude

	-- pose blending
	local kp = clamp(dt * S.poseRate, 0, 1)
	for key, v in pairs(pose) do pose[key] = v + (S.poseT[key] - v) * kp end
	S.kneelK += (((S.kneel and 1) or 0) - S.kneelK) * clamp(dt * 2.6, 0, 1)
	S.swPlant += (((S.kneel and 1) or 0) - S.swPlant) * clamp(dt * 2.2, 0, 1)
	local kn = S.kneelK
	local flyF = smooth(clamp(S.h / 6, 0, 1))
	local gt = S.gt
	gt.gait += (clamp((sp - 1) / 5, 0, 1) - gt.gait) * clamp(dt * 6, 0, 1)
	gt.ph += dt * clamp(sp * 0.07, 0, 2.2)
	local ph = gt.ph % 1
	local sph, cph = math.sin(2 * math.pi * ph), math.cos(2 * math.pi * ph)
	local walkF = gt.gait * (1 - flyF) * (1 - kn)

	-- skeleton
	local breathe = math.sin(t * 1.5) * 0.012
	local legSw = sph * 0.6 * walkF
	local thL = mix(mix(legSw, -0.5, flyF), 0.05, kn)
	local thR = mix(mix(-legSw, -0.5, flyF), 0.05, kn)
	local shL = mix(mix(math.max(0, -legSw) * 0.5, -0.35, flyF), -1.5, kn)
	local shR = mix(mix(math.max(0, legSw) * 0.5, -0.35, flyF), -1.5, kn)
	local speedLean = clamp(sp / CFG.FLY, 0, 1) * 0.7
	local rootPitch = -(flyF * (0.35 + speedLean) + pose.dive) + breathe
	local lean = -0.05 - kn * 0.22 - walkF * 0.08 + pose.lean
	local flapAmp = (0.1 + 0.55 * flyF) + pose.flap
	local flap = math.sin(t * (2.2 + flyF * 6)) * flapAmp
	local wingS = clamp(S.wingS * (1 - kn * 0.8) + flyF * 0.3, 0, 1)
	local fold = 1 - wingS
	local scan = (S.act or S.cut) and 0 or math.sin(t * 0.5) * 0.25
	local rot = {
		Root = CFrame.Angles(rootPitch, 0, sph * 0.02 * walkF),
		Torso = CFrame.Angles(lean, pose.twist + cph * 0.08 * walkF, 0),
		Head = CFrame.Angles(pose.head - kn * 0.6 + 0.05 - lean * 0.4, scan * (1 - kn), 0),
		ArmL = CFrame.Angles(0.15 + pose.armL - cph * 0.5 * walkF + mix(0, 1.0, kn) - flyF * 0.5, 0, -(0.12 + pose.armLz + flyF * 0.1)),
		ArmR = CFrame.Angles(0.15 + pose.armR + cph * 0.5 * walkF + mix(0, 0.9, kn) - flyF * 0.4, 0, 0.12 + pose.armRz + flyF * 0.1),
		ForeL = CFrame.Angles(0.3 + pose.foreL + kn * 0.9, 0, 0),
		ForeR = CFrame.Angles(0.3 + pose.foreR + kn * 0.9, 0, 0),
		ThighL = CFrame.Angles(thL, 0, 0), ThighR = CFrame.Angles(thR, 0, 0),
		ShinL = CFrame.Angles(shL, 0, 0), ShinR = CFrame.Angles(shR, 0, 0),
		FootL = CFrame.Angles(-(thL + shL) * (1 - kn) + kn * 1.4, 0, 0), FootR = CFrame.Angles(-(thR + shR) * (1 - kn) + kn * 1.4, 0, 0),
	}
	for _, sd in ipairs({-1, 1}) do
		local d = sd < 0 and "L" or "R"
		rot["WingA" .. d] = CFrame.Angles(0, -sd * fold * 1.2, sd * flap)
		rot["WingB" .. d] = CFrame.Angles(0, -sd * fold * 0.6, sd * (flap * 0.7 + 0.15 * fold))
		rot["WingC" .. d] = CFrame.Angles(0, 0, sd * (flap * 0.5 + 0.1 * fold))
	end
	local Hh = mix(10, 4.05, kn) + math.sin(t * 1.4) * 0.05 * (1 - kn)
	local bob = flyF * math.sin(t * 1.9) * 0.7
	local baseCF = CFrame.new(S.pos.X, S.gy + (Hh - 10) + S.h + bob, S.pos.Z) * CFrame.Angles(0, S.hd, 0)
	local M, world = {}, S.world
	for _, name in ipairs(S.order) do
		local b = S.bones[name]
		if b.parent then
			M[name] = M[b.parent] * CFrame.new(b.pv - S.bones[b.parent].pv) * rot[name]
		else
			M[name] = CFrame.new(b.pv) * rot[name]
		end
		world[name] = baseCF * M[name]
	end

	-- the sword: in the right hand, or planted in the ground in front of him (kneeling / cutscene)
	local held = world.ForeR * CFrame.new(0, -5, 0) * CFrame.Angles(-HALF, 0, 0)
	local plant = CFrame.new(S.pos.X, S.gy, S.pos.Z) * CFrame.Angles(0, S.hd, 0) * CFrame.new(0, 11, -5.5) * CFrame.Angles(math.pi, 0, 0)
	local swCF = (S.swPlant > 0.001) and held:Lerp(plant, S.swPlant) or held
	S.swCF = swCF
	S.swTip = (swCF * CFrame.new(0, 23.5, 0)).Position

	local park = V(S.pos.X, S.gy - 80, S.pos.Z)
	for _, s in ipairs(S.slots) do
		local cf
		if s.kind == "fk" then
			cf = S.bodyVis and (world[s.bone] * CFrame.new(s.off) * s.orient) or CFrame.new(park + V(s.fi * 0.5, 0, 0))
		elseif s.kind == "sw" then
			cf = S.bodyVis and (swCF * CFrame.new(s.off) * s.orient) or CFrame.new(park + V(s.fi * 0.5, 4, 0))
		else
			cf = s.use and (s.use * s.orient) or CFrame.new(park + V((s.fi % 16) * 5, 8, math.floor(s.fi / 16) * 5 + 8))
		end
		s.cf = cf
	end
	-- nothing may sink into the ground (only matters when he is near it)
	if S.bodyVis and S.h < 3 then
		local lowest = math.huge
		for _, s in ipairs(S.body) do
			local c = s.cf
			local _, _, _, _, _, _, r10, r11, r12 = c:GetComponents()
			local sz = s.p.Size
			local low = c.Position.Y - 0.5 * (math.abs(r10) * sz.X + math.abs(r11) * sz.Y + math.abs(r12) * sz.Z)
			if low < lowest then lowest = low end
		end
		if lowest < S.gy - 0.05 then
			local shift = V(0, S.gy - lowest, 0)
			for _, s in ipairs(S.body) do s.cf = s.cf + shift end
			for k, w in pairs(world) do world[k] = w + shift end
		end
	end
	S.headPos = (world.Head * CFrame.new(0, 2, 0)).Position
	S.bodyPos = (world.Torso * CFrame.new(0, 4, 0)).Position
	if S.camPart then S.camPart.Position = S.bodyPos + V(0, 4, 0) end

	-- glow pulse on the gold parts
	local pulse = 0.65 + 0.35 * math.sin(t * 3)
	for _, s in ipairs(S.body) do
		if s.tag == "glow" or s.tag == "halo" then
			pcall(function()
				s.p.Color = s.color:Lerp(COL.WHITE, 1 - pulse)
				s.p.Material = Enum.Material.Neon
			end)
		end
	end

	S.lostT += dt
	if S.lostT > 0.5 and isnetworkowner and not S.cut then
		S.lostT = 0
		local n = 0
		for _, s in ipairs(S.body) do
			local ok, own = pcall(isnetworkowner, s.p)
			if ok and not own then n += 1 end
		end
		S.lostN = n
		if n > 0 and os.clock() > S.noticeUntil then notify(n .. " bricks lost ownership - stay near Michael", 2) end
	end
end
local function applyTargets()
	for _, s in ipairs(S.slots) do
		local p = s.p
		if p.Parent and s.cf then
			p.CFrame = s.cf
			p.AssemblyLinearVelocity = V()
			p.AssemblyAngularVelocity = V()
		end
	end
end

