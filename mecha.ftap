-- Controls: page 1
----------------------------------------------------------------
curParent = page1
buildBtn = makeButton("Summon Mecha", 10, 22, 180, 28, function()
	if S.active then release() else task.spawn(build) end
end)

for i, m in ipairs({ "mech", "car", "jet" }) do
	local label = ({ mech = "Mech", car = "Car", jet = "Jet" })[m]
	modeBtns[m] = makeButton(label, 10 + (i - 1) * 62, 52, 56, 28, function() setWant(m) end)
end
highlight(modeBtns, "mech")

maskBtn = makeButton("Mask: CLOSED", 10, 82, 88, 28, function() setMask(not S.maskOpen) end)
maskBtn.TextSize = 11
makeButton("Auto: OFF", 102, 82, 88, 28, function(b)
	S.auto = not S.auto
	b.Text = "Auto: " .. (S.auto and "ON" or "OFF")
	b.BackgroundColor3 = S.auto and Color3.fromRGB(70, 110, 200) or Color3.fromRGB(52, 52, 66)
	autoTarget = nil
	homePos = pos
end)

makeButton("👊 Punch", 10, 112, 88, 28, function() startSkill("punch") end)
makeButton("💥 Slam", 102, 112, 88, 28, function() startSkill("slam") end)

makeButton("Run: OFF", 10, 142, 56, 28, function(b)
	S.run = not S.run
	b.Text = "Run: " .. (S.run and "ON" or "OFF")
	b.BackgroundColor3 = S.run and Color3.fromRGB(70, 110, 200) or Color3.fromRGB(52, 52, 66)
end).TextSize = 11
makeHoldButton("▲", 72, 142, 56, 28, function(h) S.upHeld = h end)
makeHoldButton("▼", 134, 142, 56, 28, function(h) S.downHeld = h end)

sizeLabel = makeLabel("Size: 6", 10, 172, 56)
makeButton("Fit", 66, 172, 34, 28, function()
	local fit = fitSize()
	if fit then setSize(fit) end
end)
makeButton("-", 104, 172, 40, 28, function() setSize(S.size - 1) end)
makeButton("+", 150, 172, 40, 28, function() setSize(S.size + 1) end)

local speedLabel = makeLabel("Speed: 1.00x", 10, 202, 90)
makeButton("-", 104, 202, 40, 28, function()
	S.speedMul = math.max(0.5, S.speedMul - 0.25)
	speedLabel.Text = ("Speed: %.2fx"):format(S.speedMul)
end)
makeButton("+", 150, 202, 40, 28, function()
	S.speedMul = math.min(2.5, S.speedMul + 0.25)
	speedLabel.Text = ("Speed: %.2fx"):format(S.speedMul)
end)

makeButton("Cam: Follow", 10, 232, 88, 28, function(b)
	S.camFollow = not S.camFollow
	b.Text = "Cam: " .. (S.camFollow and "Follow" or "Me")
	lastZoom = nil
end)
makeButton("Skin: ON", 102, 232, 88, 28, function(b)
	S.skin = not S.skin
	b.Text = "Skin: " .. (S.skin and "ON" or "OFF")
	if S.active then
		if S.skin then buildSkin() else destroySkin() end
	end
end)

makeButton("Emotes ▶", 10, 262, 88, 28, function() showPage(2) end)
makeButton("Safe: ON", 102, 262, 88, 28, function(b)
	S.safe = not S.safe
	b.Text = "Safe: " .. (S.safe and "ON" or "OFF")
	b.BackgroundColor3 = S.safe and Color3.fromRGB(60, 130, 80) or Color3.fromRGB(52, 52, 66)
end).BackgroundColor3 = Color3.fromRGB(60, 130, 80)

----------------------------------------------------------------
-- Controls: page 2 (6 emotes)
----------------------------------------------------------------
curParent = page2
makeLabel("Emotes (mech form)", 10, 14, 180).TextSize = 12
local function emoteButton(key, text, x, y)
	emoteBtns[key] = makeButton(text, x, y, 88, 36, function() setEmote(key) end)
	emoteBtns[key].TextSize = 12
end
emoteButton("sit", "🪑 Sit", 10, 42)
emoteButton("dance", "🤖 Dance", 102, 42)
emoteButton("kneel", "🙇 Kneel", 10, 82)
emoteButton("dance2", "🕺 Dance 2", 102, 82)
emoteButton("bored", "😑 Bored", 10, 122)
emoteButton("hand", "👋 Hand", 102, 122)
makeButton("Stop emote", 10, 166, 180, 28, function()
	S.emote = nil
	highlight(emoteBtns, nil)
	setStatus("ready")
end)
makeButton("◀ Controls", 10, 200, 180, 28, function() showPage(1) end)
curParent = page1

-- PC keys
table.insert(conns, UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	local k = input.KeyCode
	if k == Enum.KeyCode.Space then S.upHeld = true
	elseif k == Enum.KeyCode.LeftShift then S.downHeld = true
	elseif k == Enum.KeyCode.Q then startSkill("punch")
	elseif k == Enum.KeyCode.E then startSkill("slam")
	elseif k == Enum.KeyCode.M then setMask(not S.maskOpen)
	elseif k == Enum.KeyCode.Z then setWant("mech")
	elseif k == Enum.KeyCode.X then setWant("car")
	elseif k == Enum.KeyCode.C then setWant("jet") end
end))
table.insert(conns, UIS.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Space then S.upHeld = false
	elseif input.KeyCode == Enum.KeyCode.LeftShift then S.downHeld = false end
end))

-- Close / unload
local function unload()
	S.dead = true
	release()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	if gui then gui:Destroy() end
	env.FTAPMechaUnload = nil
end
env.FTAPMechaUnload = unload

