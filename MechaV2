	l.Font = Enum.Font.Gotham
	l.TextSize = 13
	l.Parent = parent
	return l
end

local function makeHoldButton(parent, text, x, y, w, h, setHeld)
	local b = makeButton(parent, text, x, y, w, h, function() end)
	b.MouseButton1Down:Connect(function() setHeld(true) end)
	b.MouseButton1Up:Connect(function() setHeld(false) end)
	b.MouseLeave:Connect(function() setHeld(false) end)
	return b
end

local function setOn(b, on) b.BackgroundColor3 = on and C.on or C.btn end

local function highlight(tbl, key)
	for k, b in pairs(tbl) do setOn(b, k == key) end
end

local buildBtn, maskBtn, sizeLabel, soundBtn
local modeBtns, emoteBtns = {}, {}

----------------------------------------------------------------
-- Control / camera
----------------------------------------------------------------
local function restoreHum()
	if savedHum and savedHum.hum and savedHum.hum.Parent then
		local h = savedHum.hum
		h.WalkSpeed = savedHum.WalkSpeed
		h.JumpPower = savedHum.JumpPower
		h.JumpHeight = savedHum.JumpHeight
	end
	savedHum = nil
end

local function freezeHum(hum)
	if savedHum and savedHum.hum == hum then return end
	restoreHum()
	savedHum = {
		hum = hum,
		WalkSpeed = hum.WalkSpeed,
		JumpPower = hum.JumpPower,
		JumpHeight = hum.JumpHeight,
	}
	hum.WalkSpeed = 0 -- your joystick steers the mecha, not your avatar
	hum.JumpPower = 0
	hum.JumpHeight = 0
end

local function applyControl(hum)
	freezeHum(hum)
	if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
	local want = (camPart and S.camFollow) and camPart or hum
	if lastSubject ~= want then
		cam.CameraSubject = want
		lastSubject = want
	end
	local zoom = S.camFollow and S.size * 8 or origZoom.min
	if lastZoom ~= zoom then
		lp.CameraMinZoomDistance = zoom
		lp.CameraMaxZoomDistance = math.max(origZoom.max, S.size * 50)
		lastZoom = zoom
	end
end

local function getMove(hum)
	local md = hum.MoveDirection
	if md.Magnitude > 0.05 then return V(md.X, 0, md.Z) end
	if controls then
		local ok, mv = pcall(function() return controls:GetMoveVector() end)
		if ok and mv and mv.Magnitude > 0.05 then
			local wv = cam.CFrame:VectorToWorldSpace(V(mv.X, 0, mv.Z))
			wv = V(wv.X, 0, wv.Z)
			if wv.Magnitude > 0.01 then return wv.Unit * math.min(1, mv.Magnitude) end
		end
	end
	return V(0, 0, 0)
end

----------------------------------------------------------------
-- Actions
----------------------------------------------------------------
local function setWant(m)
	if S.want == m then return end
	S.want = m
	highlight(modeBtns, m)
	if S.active then setStatus("transforming: " .. m) end
end

local function setEmote(name)
	if not S.active or S.mode ~= "mech" or S.want ~= "mech" then
		setStatus("emotes need the mech form")
		return
	end
	if S.attack then return end
	S.emote = (S.emote == name) and nil or name
	highlight(emoteBtns, S.emote)
	setStatus(S.emote and ("emote: " .. S.emote) or "ready")
end

local function startSkill(name)
	if not S.active or S.attack or S.mode ~= "mech" or S.want ~= "mech" then return end
	if wM < 0.99 then return end
	local sk = SKILLS[name]
	S.emote = nil
	highlight(emoteBtns, nil)
	local a = { name = name, fn = sk.fn, dur = sk.dur, t0 = tick(), fired = false }
	if name == "punch" then
		punchSide = -punchSide
		a.side = punchSide
		play("whoosh", 1, 0.8)
	else
		play("servo", 1.2, 0.7)
	end
	S.attack = a
	setStatus(name)
end

local function setMask(open)
	S.maskOpen = open
	maskBtn.Text = "Mask: " .. (open and "OPEN" or "CLOSED")
	setOn(maskBtn, open)
	play("click", 1, 1)
	play("servo", 0.7, open and 1.4 or 1.1)
end

-- autopilot: wander around the point where it was switched on
local function autoMove(t, mode)
	if autoPause > t then return V(0, 0, 0) end
	local sz = S.size
	local flatD = autoTarget and V(autoTarget.X - pos.X, 0, autoTarget.Z - pos.Z).Magnitude or 0
	if not autoTarget or flatD < 6 * sz or t > autoUntil then
		local ang = math.random() * TAU
		local rad = math.random(25, 100) * sz / 3
		if mode == "jet" then rad *= 2.2 end
		autoTarget = V(homePos.X + math.cos(ang) * rad, 0, homePos.Z + math.sin(ang) * rad)
		autoAlt = math.random(25, 70) * sz / 3
		autoUntil = t + 25
		if mode ~= "jet" and math.random() < 0.5 then autoPause = t + 1.5 end
	end
	local dv = V(autoTarget.X - pos.X, 0, autoTarget.Z - pos.Z)
	return dv.Magnitude > 1 and dv.Unit or V(0, 0, 0)
end

-- engine / hum loops follow the form and speed
local function updateSounds(mode, speedFrac, throttle, airborne)
	if not S.sound then
		for _, s in pairs(loops) do s.Volume = 0 end
		return
	end
	if mode == "mech" then
		setLoop("hum", 0.10 + 0.05 * speedFrac, 0.45 + 0.1 * speedFrac)
		setLoop("engine", 0, 1)
	elseif mode == "car" then
		setLoop("hum", 0.3 + 0.25 * speedFrac, 0.55 + 1.0 * speedFrac)
		setLoop("engine", 0, 1)
	else
		setLoop("hum", 0, 1)
		setLoop("engine", airborne and (0.35 + 0.65 * throttle) or 0.12, 0.8 + 0.6 * throttle)
	end
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local function step(dt)
	local root, hum = getRoot(), getHum()
	if not root or not hum then return end
	local t = tick()
	local sz = S.size

	applyControl(hum)

	local ignore = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ignore, folder) end
	if skin then table.insert(ignore, skin.model) end
	rayParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(V(pos.X, pos.Y + 8 * sz, pos.Z), V(0, -4000, 0), rayParams)
	local gy = hit and hit.Position.Y or pos.Y
	local alt = math.max(0, pos.Y - gy)

	local function toward(cur, goal, rate) return cur + (goal - cur) * (1 - math.exp(-dt * rate)) end

	-- transform requests: a jet lands first
	local landing = false
	if S.mode ~= S.want then
		if S.mode == "jet" and (alt > 0.6 or jetAir) then
			landing = true
		else
			S.mode = S.want
			local g = V(pos.X, gy + 0.3 * sz, pos.Z)
			if skin then
				spawnRing(g, 9 * sz, NEON, 0.9)
				spawnRing(g, 5 * sz, Color3.new(1, 1, 1), 0.6)
			end
			play("flash", 1.2, 1)
			play("servo", 1.4, 0.8)
			play("metal", 1.2, 0.6)
			task.delay(0.9, function()
				if S.active then
					play("click", 1, 0.8)
					play("metal", 1.4, 0.9)
				end
			end)
			setStatus("transforming...")
		end
	end
	local gM, gC, gJ = (S.mode == "mech") and 1 or 0, (S.mode == "car") and 1 or 0, (S.mode == "jet") and 1 or 0
	local stepW = dt / 1.1
	wM += math.clamp(gM - wM, -stepW, stepW)
	wC += math.clamp(gC - wC, -stepW, stepW)
	wJ += math.clamp(gJ - wJ, -stepW, stepW)
	local tot = wM + wC + wJ
	if tot > 0 then wM, wC, wJ = wM / tot, wC / tot, wJ / tot end
	local settled = math.max(wM, wC, wJ) > 0.995

	-- input (manual or autopilot)
	local mv
	if S.auto then mv = autoMove(t, S.mode) else mv = getMove(hum) end
	local moveInput = mv.Magnitude > 0.1 and settled and not landing
	if moveInput and S.emote and S.mode == "mech" then
		S.emote = nil
		highlight(emoteBtns, nil)
	end

	-- emote weights; the mask is a springy hinge (slight overshoot)
	sitW = toward(sitW, (S.emote == "sit") and 1 or 0, 3)
	kneelW = toward(kneelW, (S.emote == "kneel") and 1 or 0, 3)
	boredW = toward(boredW, (S.emote == "bored") and 1 or 0, 3)
	handW = toward(handW, (S.emote == "hand") and 1 or 0, 4)
	d1W = toward(d1W, (S.emote == "dance") and 1 or 0, 4)
	d2W = toward(d2W, (S.emote == "dance2") and 1 or 0, 4)
	maskV += (90 * ((S.maskOpen and 1 or 0) - maskW) - 11 * maskV) * dt
	maskW = math.clamp(maskW + maskV * dt, -0.06, 1.08)

	-- dance beat sounds
	if S.emote == "dance" or S.emote == "dance2" then
		local bn = math.floor(t * 2)
		if bn ~= lastBeat then
			lastBeat = bn
			play("ping", 0.5, 0.8 + (bn % 4) * 0.15)
		end
	end

	-- current skill
	local a, att, p = S.attack, nil, 0
	if a then
		p = (t - a.t0) / a.dur
		if p >= 1 then
			S.attack = nil
			a = nil
			setStatus("ready")
		else
			att = a.fn(p, a)
		end
	end

	local newYaw = yaw
	local turnN = 0
	local throttle = 0
	local bodyYaw = 0

	if S.mode == "mech" then
		-- ======== MECH: heavy ground walker ========
		local target = 0
		local emoting = S.emote ~= nil
		if moveInput and not emoting then
			target = (S.run and 8 or 3.5) * sz * S.speedMul * (att and att.moveMul or 1)
		end
		if not settled then target = 0 end
		speedNow = toward(speedNow, target, 4)
		runBlend = toward(runBlend, (S.run and moveInput) and 1 or 0, 4)
		if moveInput and not emoting and not (att and att.lockFace) then
			local want = math.atan2(-mv.X, -mv.Z)
			local diff = (want - yaw + math.pi) % TAU - math.pi
			newYaw = yaw + math.clamp(diff, -2.2 * dt, 2.2 * dt)
		end
		local facing = V(-math.sin(yaw), 0, -math.cos(yaw))
		pos += facing * speedNow * dt
		if att and att.rootVel then pos += facing * att.rootVel * dt end
		pos = V(pos.X, pos.Y + (gy - pos.Y) * math.min(1, dt * 15), pos.Z)
		vel = facing * speedNow
		pitch, roll = toward(pitch, 0, 6), toward(roll, 0, 6)
		jetAir = false
	elseif S.mode == "car" then
		-- ======== CAR: drives on the ground ========
		local topSpeed = (S.run and 22 or 14) * sz * S.speedMul
		local target = moveInput and topSpeed or 0
		speedNow = toward(speedNow, target, moveInput and 1.4 or 2.2)
		if moveInput then
			local want = math.atan2(-mv.X, -mv.Z)
			local diff = (want - yaw + math.pi) % TAU - math.pi
			local stp = math.clamp(diff, -2.4 * dt, 2.4 * dt)
			newYaw = yaw + stp
			turnN = math.clamp(stp / math.max(dt, 1e-3) / 2.4, -1, 1)
		end
		local facing = V(-math.sin(yaw), 0, -math.cos(yaw))
		pos += facing * speedNow * dt
		pos = V(pos.X, pos.Y + (gy - pos.Y) * math.min(1, dt * 15), pos.Z)
		vel = facing * speedNow
		wheelA = (wheelA + speedNow * dt / (0.85 * sz)) % TAU
		steer = toward(steer, math.clamp(turnN * 0.5, -0.5, 0.5), 8)
		local frac = math.clamp(speedNow / (14 * sz), 0, 1.6)
		pitch = toward(pitch, -(target - speedNow) / math.max(topSpeed, 1) * 0.08, 5)
		roll = toward(roll, -turnN * 0.1 * frac, 5)
		jetAir = false
	else
		-- ======== JET: fighter jet ========
		local cruise = 20 * sz * S.speedMul
		if landing then
			-- come down and stop before turning back into a mech or car
			local dsc = -math.clamp(alt * 0.8, 6, cruise * 0.45)
			vel = vel:Lerp(V(vel.X * 0.97, dsc, vel.Z * 0.97), 1 - math.exp(-dt * 2))
			pos += vel * dt
			if pos.Y <= gy + 0.3 then
				pos = V(pos.X, gy, pos.Z)
				vel = Vector3.zero
				jetAir = false
				speedNow = 0
			end
		else
			local vIn = (S.upHeld and 1 or 0) - (S.downHeld and 1 or 0)
			if not jetAir and settled and (moveInput or vIn > 0) then
				jetAir = true
				vel = V(-math.sin(yaw), 0.4, -math.cos(yaw)) * cruise * 0.5
			end
			if jetAir then
				if moveInput then
					local want = math.atan2(-mv.X, -mv.Z)
					local diff = (want - yaw + math.pi) % TAU - math.pi
					local stp = math.clamp(diff, -1.3 * dt, 1.3 * dt)
					newYaw = yaw + stp
					turnN = math.clamp(stp / math.max(dt, 1e-3) / 1.3, -1, 1)
				end
				local facing = V(-math.sin(yaw), 0, -math.cos(yaw))
				local vy = vIn * cruise * 0.6
				if S.auto then vy = math.clamp((gy + autoAlt - pos.Y) * 0.8, -cruise * 0.5, cruise * 0.5) end
				local tv = facing * cruise + V(0, vy, 0)
				vel = vel:Lerp(tv, 1 - math.exp(-dt * 1.6))
				pos += vel * dt
				if pos.Y < gy + 0.3 then
					if vel.Y < -cruise * 0.2 then
						vel = V(vel.X, math.abs(vel.Y) * 0.3, vel.Z) -- no crash landings: bounce up
					else
						pos = V(pos.X, gy, pos.Z)
						vel = Vector3.zero
						jetAir = false
					end
				end
			else
				vel = Vector3.zero
				pos = V(pos.X, pos.Y + (gy - pos.Y) * math.min(1, dt * 15), pos.Z)
			end
		end
		local hsp = V(vel.X, 0, vel.Z).Magnitude
		speedNow = hsp
		throttle = jetAir and math.clamp(0.35 + hsp / (cruise * 1.2) * 0.5 + math.max(vel.Y, 0) / cruise * 0.3, 0, 1) or 0
		pitch = toward(pitch, jetAir and (math.clamp(vel.Y / cruise, -1, 1) * 0.6) or 0, 3)
		roll = toward(roll, jetAir and math.clamp(-turnN * 0.9, -0.9, 0.9) or 0, 4)
	end
	yawRate = (newYaw - yaw) / math.max(dt, 1e-3)
	yaw = newYaw

	-- keep within range of your avatar (toy streaming / ownership)
	if S.safe then
		local rp = root.Position
		local off = V(pos.X - rp.X, 0, pos.Z - rp.Z)
		if off.Magnitude > RANGE then
			local back = off.Unit * (off.Magnitude - RANGE)
			pos = V(pos.X - back.X, pos.Y, pos.Z - back.Z)
			vel = vel * 0.5
		end
		local floorY = workspace.FallenPartsDestroyHeight + 100
		if pos.Y < floorY then pos = V(pos.X, floorY, pos.Z) end
	end

	-- poses for every form that is (partly) built
	if att and att.bodyYaw then bodyYaw = att.bodyYaw end
	local J = computeMech(t, dt, att)
	local cfM = CFrame.new(pos) * CFrame.Angles(0, yaw + bodyYaw, 0)
	local cY = 1.5 * sz
	local cfV = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
		* CFrame.new(0, cY, 0) * CFrame.Angles(pitch, 0, roll) * CFrame.new(0, -cY, 0)
	lastBodyCF = cfM

	-- footsteps: dust ring + a heavy metal clank
	if S.mode == "mech" and wM > 0.99 then
		local function stomp(ank)
			local gp = cfM:PointToWorldSpace(ank * sz)
			spawnRing(V(gp.X, gy + 0.2 * sz, gp.Z), 1.6 * sz, Color3.fromRGB(190, 190, 200), 0.4)
			play("metal", 0.9 + 0.5 * runBlend, 0.5 + math.random() * 0.12)
		end
		if J.stompL then stomp(J.ankL) end
		if J.stompR then stomp(J.ankR) end
	end

	-- one-shot effects
	local facingNow = V(-math.sin(yaw), 0, -math.cos(yaw))
	if att and att.fx and a and not a.fired and p >= att.fx.p then
		a.fired = true
		local k = att.fx.kind
		if k == "slam" then
			spawnRing(V(pos.X, gy + 0.3 * sz, pos.Z) + facingNow * 3.3 * sz, 11 * sz, Color3.new(1, 1, 1), 0.8)
			play("boom", 3, 0.9)
			play("metal", 2, 0.45)
		elseif k == "punch" then
			spawnRing(cfM:PointToWorldSpace(J[att.fx.hand] * sz), 2.6 * sz, Color3.fromRGB(255, 200, 120), 0.4)
			play("metal", 2, 0.5)
			play("boom", 1.2, 1.4)
		end
	end
	updateFx()

	-- skin: show the form that is (mostly) built
	if S.skin and skin then
		local shown = (wM >= wC and wM >= wJ) and "mech" or ((wC >= wJ) and "car" or "jet")
		if skin.shown ~= shown then
			for _, k in ipairs({ "mech", "car", "jet" }) do
				skin[k].group.Parent = (k == shown) and skin.model or nil
			end
			skin.shown = shown
		end
		if shown == "mech" then
			updateMechSkin(J, cfM)
		elseif shown == "car" then
			updateCarSkin(cfV, math.clamp(speedNow / (14 * sz), 0, 1))
		else
			updateJetSkin(cfV, throttle, not jetAir and alt < 1)
		end
	end

	updateSounds(S.mode, math.clamp(speedNow / (14 * sz), 0, 1.5), throttle, jetAir)

	if camPart then camPart.CFrame = CFrame.new(pos + V(0, 3.4 * sz, 0)) end
	if not S.auto then homePos = pos end

	-- indestructible upkeep
	if S.safe then
		safeTimer += dt
		if safeTimer >= 0.1 and #claimed > 0 then
			safeTimer = 0
			reclaimIdx = reclaimIdx % #claimed + 1
			local c = claimed[reclaimIdx]
			if c.part.Parent then
				if not ownsPart(c.part) then claim(c.part) end
				c.part.CanCollide = false
			end
		end
		refillTimer += dt
		if refillTimer >= 1.5 then
			refillTimer = 0
			refill()
		end
	end

	-- toys: centered on their skin part and rotated like it, in every form
	local tm = 1 - math.max(wM, wC, wJ) -- lifts the toys while they fly into the new form
	for _, c in ipairs(claimed) do
		local part = c.part
		if part.Parent then
			local id = c.id
			local posAcc, rotAcc, wAcc = Vector3.zero, nil, 0
			for _, f in ipairs({ { "mech", wM, cfM }, { "car", wC, cfV }, { "jet", wJ, cfV } }) do
				local fw = f[2]
				if fw > 0.001 then
					local pu, dr, nr = formTarget(f[1], id, J)
					local cf = f[3]
					posAcc += cf:PointToWorldSpace(pu * sz) * fw
					local rot = orient(c, cf:VectorToWorldSpace(dr), cf:VectorToWorldSpace(nr))
					if not rotAcc then
						rotAcc, wAcc = rot, fw
					else
						wAcc += fw
						rotAcc = rotAcc:Lerp(rot, fw / wAcc)
					end
				end
			end
			if not rotAcc then rotAcc = CFrame.new() end
			local tgt = posAcc + V(0, tm * 3 * sz, 0)
			if S.safe then
				makeMovers(c)
				if part.AssemblyLinearVelocity.Magnitude > 700 + sz * 60 then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
				if (part.Position - tgt).Magnitude > 400 then part.CFrame = CFrame.new(tgt) * rotAcc end
			end
			c.ap.Position = tgt
			c.ao.CFrame = rotAcc
		end
	end
end

----------------------------------------------------------------
-- Summon / release
----------------------------------------------------------------
local function release()
	S.active = false
	S.emote, S.attack = nil, nil
	if heartbeat then heartbeat:Disconnect() heartbeat = nil end
	for _, c in ipairs(claimed) do
		if c.ap then c.ap:Destroy() end
		if c.ao then c.ao:Destroy() end
		if c.att then c.att:Destroy() end
		if c.part and c.part.Parent then c.part.CanCollide = c.oldCollide end
	end
	claimed, claimedSet = {}, {}
	destroySkin()
	stopLoops()
	restoreHum()
	cam.CameraType = Enum.CameraType.Custom
	local hum = getHum()
	if hum then cam.CameraSubject = hum end
	lastSubject = nil
	if origZoom then
		lp.CameraMinZoomDistance = origZoom.min
		lp.CameraMaxZoomDistance = origZoom.max
	end
	lastZoom = nil
	if camPart then camPart:Destroy() camPart = nil end
	if buildBtn then buildBtn.Text = "SUMMON MECHA" end
	setStatus("released")
end

local function setSize(v)
	S.size = math.clamp(v, 3, MAX_SIZE)
	sizeLabel.Text = "Size: " .. S.size
	lastZoom = nil
	if S.active and S.skin then buildSkin() end
end

local function build()
	if S.busy or S.active then return end
	local root = getRoot()
	if not root then setStatus("no character") return end

	local infos = getToyInfos()
	if #infos == 0 then setStatus("no toys found") return end

	S.busy = true
	setStatus("claiming toys...")
	local origin = root.CFrame
	local teleported = false

	-- ladders go to legs / arms / back tube, planks to body / accessories / feet / back plate
	local picks = assign(infos)
	for si = 1, #SLOTS do
		local info = picks[si]
		if info and info.part.Parent then
			local part = info.part
			if (part.Position - root.Position).Magnitude > 30 then
				root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
				teleported = true
				task.wait(0.08)
			end
			if claim(part) then addToy(info, si) end
		end
	end
	if teleported then root.CFrame = origin end

	if #claimed == 0 then
		S.busy = false
		setStatus("no toys claimed")
		return
	end

	local fit = fitSize()
	if fit then S.size = fit end
	sizeLabel.Text = "Size: " .. S.size

	-- appear in front of you, facing you
	local look = root.CFrame.LookVector
	local flat = V(look.X, 0, look.Z)
	flat = flat.Magnitude > 1e-3 and flat.Unit or V(0, 0, -1)
	yaw = math.atan2(flat.X, flat.Z)
	local spot = root.Position + flat * (S.size * 10)
	local ign = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ign, folder) end
	rayParams.FilterDescendantsInstances = ign
	local hit = workspace:Raycast(V(spot.X, root.Position.Y + 30, spot.Z), V(0, -500, 0), rayParams)
	pos = V(spot.X, hit and hit.Position.Y or (root.Position.Y - 3), spot.Z)
	vel, speedNow, runBlend, phase, lastPhase = Vector3.zero, 0, 0, 0, 0
	pitch, roll, yawRate, wheelA, steer = 0, 0, 0, 0, 0
