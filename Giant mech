local function partCount(pt)
	local n = pt.nx * pt.nz * pt.ny
	if pt.tube then n -= math.max(pt.nx - 2, 0) * math.max(pt.nz - 2, 0) * pt.ny end
	return n
end

-- layout: bones, parts, geometry, number of spare "needle" slots --------------------------------------------
local function layout(cxx, czz, LL, tname, fill)
	local T = TEMPLATES[tname]
	local b, o, p = {}, {}, {}
	local function bone(n, par, pv) b[n] = {parent = par, pv = pv}; o[#o + 1] = n end
	local function part(bn, c, dims, kind, e)
		e = e or {}
		p[#p + 1] = {bone = bn, c = c, nx = dims[1], nz = dims[2], ny = dims[3], kind = kind, tube = e.tube, rot = e.rot, ammo = e.ammo}
	end
	local fo, sh, th = T.foot[3], T.shin[3], T.thigh[3]
	local hipH, abH, ch, hh = T.hip[3], T.abd[3], T.chest[3], T.head[3]
	local yKnee = fo + sh
	local yTh = yKnee + th
	local yWa = yTh + hipH
	local yAb = yWa + abH
	local yCh = yAb + ch
	local yHd = yCh + hh
	local legX = T.thigh[1] * cxx / 2
	local chestHalf = T.chest[1] * cxx / 2
	local armX = chestHalf + T.uarm[1] * cxx / 2
	local uaN, foN, fiN = T.uarm[3], T.fore[3], T.fist[3]
	local yFore = yCh - uaN
	local yFist = yFore - foN
	local tube = T.tube
	local sw = T.sword

	bone("Root", nil, V(0, yTh * LL, 0))
	bone("Torso", "Root", V(0, yWa * LL, 0))
	bone("Head", "Torso", V(0, yCh * LL, 0))
	part("Root", V(0, (yTh + hipH / 2) * LL, 0), T.hip, "hip", {tube = tube})
	part("Torso", V(0, (yWa + abH / 2) * LL, 0), T.abd, "abd", {tube = tube})
	part("Torso", V(0, (yAb + ch / 2) * LL, 0), T.chest, "chest", {tube = tube})
	part("Head", V(0, (yCh + hh / 2) * LL, 0), T.head, "head", {tube = tube})

	local chBack = T.chest[2] * czz / 2
	local packZ = chBack
	local packN = 0
	if T.pack then
		part("Torso", V(0, (yAb + T.pack[3] / 2) * LL, chBack + T.pack[2] * czz / 2), T.pack, "pack")
		packZ = chBack + T.pack[2] * czz
		packN = T.pack[3]
	end
	-- ammo pods: 10 vertical launchers behind the shoulders
	local podY = (yAb + packN + 0.5) * LL
	local ai = 0
	for k = 1, 2 do
		for i = 1, 5 do
			ai += 1
			part("Torso", V((i - 3) * cxx, podY, packZ + (k - 0.5) * czz), {1, 1, 1}, "ammo", {ammo = ai})
		end
	end

	for _, s in ipairs({-1, 1}) do
		local d = s < 0 and "L" or "R"
		bone("Thigh" .. d, "Root", V(s * legX, yTh * LL, 0))
		bone("Shin" .. d, "Thigh" .. d, V(s * legX, yKnee * LL, 0))
		bone("Foot" .. d, "Shin" .. d, V(s * legX, fo * LL, 0))
		part("Thigh" .. d, V(s * legX, (yKnee + th / 2) * LL, 0), T.thigh, "thigh", {tube = tube})
		part("Shin" .. d, V(s * legX, (fo + sh / 2) * LL, 0), T.shin, "shin", {tube = tube})
		part("Foot" .. d, V(s * legX, (fo / 2) * LL, -(T.foot[2] - T.shin[2]) * czz / 2), T.foot, "foot")
		bone("Arm" .. d, "Torso", V(s * armX, yCh * LL, 0))
		bone("Fore" .. d, "Arm" .. d, V(s * armX, yFore * LL, 0))
		bone("Hand" .. d, "Fore" .. d, V(s * armX, yFist * LL, 0))
		part("Arm" .. d, V(s * armX, (yCh - uaN / 2) * LL, 0), T.uarm, "arm", {tube = tube})
		part("Fore" .. d, V(s * armX, (yFore - foN / 2) * LL, 0), T.fore, "fore", {tube = tube})
		part("Hand" .. d, V(s * armX, (yFist - fiN / 2) * LL, 0), T.fist, "fist", {tube = tube})
		for n = 1, T.fins do
			local tilt = 0.45 + 0.35 * (n - 1)
			local pvx, pvy, pvz = s * (T.head[1] * cxx / 2), (yCh + hh * 0.65) * LL, (0.3 + (n - 1) * 0.8) * czz
			bone("Fin" .. d .. n, "Head", V(pvx, pvy, pvz))
			part("Fin" .. d .. n, V(pvx + s * math.sin(tilt) * LL / 2, pvy + math.cos(tilt) * LL / 2, pvz), {1, 1, 1}, "fin",
				{rot = CFrame.Angles(0, 0, -s * tilt)})
		end
	end

	-- sword (own local space, origin = hilt centre, blade along +Y)
	bone("Sword", nil, V(0, 0, 0))
	part("Sword", V(0, 0, 0), {1, 1, 1}, "hilt")
	for g = 1, sw[3] do
		part("Sword", V((g - (sw[3] + 1) / 2) * LL, LL / 2 + 0.5 * cxx, 0), {1, 1, 1}, "guard", {rot = CFrame.Angles(0, 0, math.pi / 2)})
	end
	local bladeY0 = LL / 2 + cxx
	part("Sword", V(0, bladeY0 + sw[2] * LL / 2, 0), {sw[1], 1, sw[2]}, "blade")

	-- needle / fin filler bricks (priority ordered) -------------------------------------------------------
	local C = {}
	local function sideSpike(bn, s, xE, y, z, u)
		local dir = V(s * math.cos(u), math.sin(u), 0)
		C[#C + 1] = {bone = bn, c = V(s * xE, y, z) + dir * (LL / 2), rot = CFrame.Angles(0, 0, -s * (math.pi / 2 - u))}
	end
	local function backSpike(bn, x, y, zE, sgn, u)
		local dir = V(0, math.sin(u), sgn * math.cos(u))
		C[#C + 1] = {bone = bn, c = V(x, y, sgn * zE) + dir * (LL / 2), rot = CFrame.Angles(sgn * (math.pi / 2 - u), 0, 0)}
	end
	local function upSpike(bn, s, x, y, z, tilt)
		local dir = V(s * math.sin(tilt), math.cos(tilt), 0)
		C[#C + 1] = {bone = bn, c = V(x, y, z) + dir * (LL / 2), rot = CFrame.Angles(0, 0, -s * tilt)}
	end
	local uNx, uD = T.uarm[1], T.uarm[2]
	local foNx, foD = T.fore[1], T.fore[2]
	local hdNx, hdD = T.head[1], T.head[2]
	local thNx, thD = T.thigh[1], T.thigh[2]
	local shNx, shD = T.shin[1], T.shin[2]
	local hpNx, hpD = T.hip[1], T.hip[2]
	local abNx, abD = T.abd[1], T.abd[2]
	for r = 1, uaN do -- shoulder spikes
		for kz = 1, uD do
			for _, s in ipairs({-1, 1}) do
				local d = s < 0 and "L" or "R"
				sideSpike("Arm" .. d, s, armX + uNx * cxx / 2, (yCh - r + 0.5) * LL, (kz - 0.5 - uD / 2) * czz, ((kz + r) % 2 == 0) and 0.3 or -0.1)
			end
		end
	end
	for _, s in ipairs({-1, 1}) do -- shoulder crown
		local d = s < 0 and "L" or "R"
		for _, zz in ipairs({-1, 1}) do
			upSpike("Arm" .. d, s, s * armX, yCh * LL, zz * (uD * czz / 2 - 0.5 * czz), 0.25)
		end
	end
	for r = 1, foN do -- forearm blades
		for i = 1, foNx do
			for _, s in ipairs({-1, 1}) do
				local d = s < 0 and "L" or "R"
				backSpike("Fore" .. d, s * armX + (i - 0.5 - foNx / 2) * cxx, (yFore - r + 0.5) * LL, foD * czz / 2, 1, 0.2)
			end
		end
	end
	for r = 1, foN do
		for _, s in ipairs({-1, 1}) do
			local d = s < 0 and "L" or "R"
			sideSpike("Fore" .. d, s, armX + foNx * cxx / 2, (yFore - r + 0.5) * LL, 0, 0.1)
		end
	end
	for k = 1, hdD do -- head crown + cheek blades
		for _, s in ipairs({-1, 1}) do
			sideSpike("Head", s, hdNx * cxx / 2, (yHd - 0.5) * LL, (k - 0.5 - hdD / 2) * czz, 0.7)
		end
	end
	for k = 1, hdD do
		for _, s in ipairs({-1, 1}) do
			sideSpike("Head", s, hdNx * cxx / 2, (yCh + 0.5) * LL, (k - 0.5 - hdD / 2) * czz, 0.3)
		end
	end
	for i = 1, hdNx do
		backSpike("Head", (i - 0.5 - hdNx / 2) * cxx, (yHd - 0.5) * LL, hdD * czz / 2, 1, 0.5)
	end
	for r = 1, math.min(sh, 2) do -- knee spikes
		for i = 1, shNx do
			for _, s in ipairs({-1, 1}) do
				local d = s < 0 and "L" or "R"
				backSpike("Shin" .. d, s * legX + (i - 0.5 - shNx / 2) * cxx, (fo + sh - r + 0.5) * LL, shD * czz / 2, -1, 0.1)
			end
		end
	end
	for r = 1, hipH do -- hip skirt
		for k = 1, hpD do
			for _, s in ipairs({-1, 1}) do
				sideSpike("Root", s, hpNx * cxx / 2, (yTh + r - 0.5) * LL, (k - 0.5 - hpD / 2) * czz, -0.15)
			end
		end
	end
	for r = 1, abH do
		for k = 1, abD do
			for _, s in ipairs({-1, 1}) do
				sideSpike("Torso", s, abNx * cxx / 2, (yWa + r - 0.5) * LL, (k - 0.5 - abD / 2) * czz, 0.0)
			end
		end
	end
	for r = 1, th do
		for k = 1, thD do
			for _, s in ipairs({-1, 1}) do
				local d = s < 0 and "L" or "R"
				sideSpike("Thigh" .. d, s, legX + thNx * cxx / 2, (yKnee + r - 0.5) * LL, (k - 0.5 - thD / 2) * czz, 0.05)
			end
		end
	end
	for r = 1, sh do
		for k = 1, shD do
			for _, s in ipairs({-1, 1}) do
				local d = s < 0 and "L" or "R"
				sideSpike("Shin" .. d, s, legX + shNx * cxx / 2, (fo + r - 0.5) * LL, (k - 0.5 - shD / 2) * czz, -0.1)
			end
		end
	end
	for i = 1, math.min(fill or 0, #C) do
		local sp = C[i]
		part(sp.bone, sp.c, {1, 1, 1}, "spike", {rot = sp.rot})
	end

	local g = {
		height = (yHd + 1.1) * LL,
		thighLen = th * LL, shinLen = sh * LL, footH = fo * LL,
		headY = (yCh + hh / 2) * LL, torsoY = (yAb + ch / 2) * LL,
		fistHalf = fiN / 2 * LL,
		stowRel = CFrame.new(chestHalf * 0.45, 0.4 * LL, packZ + 3 * czz) * CFrame.Angles(0, 0, 0.3),
		muzzleRel = V(0, (yAb + ch / 2 - yWa) * LL, -(T.chest[2] * czz / 2) - 0.6 * cxx),
		bladeLen = sw[2] * LL, bladeY0 = bladeY0,
	}
	return b, o, p, g, #C
end

for _, tr in ipairs(TIERS) do
	local _, _, p, _, nc = layout(1, 1, 3, tr.tpl, 0)
	local base = 0
	for _, pt in ipairs(p) do base += partCount(pt) end
	tr.base, tr.cands = base, nc
	tr.need = math.min(tr.target, base + nc)
end
local NEED_MIN, NEED_MAX = TIERS[1].need, TIERS[#TIERS].need
local function planTier(avail)
	local best
	for _, tr in ipairs(TIERS) do
		if tr.need <= avail then best = tr end
	end
	return best
end

-- colors per cell: returns color, glowGroup ("eye" / "core" / "blade")
local function slotStyle(kind, i, k, j, nx, ny)
	if kind == "head" then
		if k == 1 and (ny == 1 or j == ny) then return GLOW.Offline, "eye" end
		if j == 1 and ny > 1 then return STEEL end
		return ARMOR
	elseif kind == "chest" then
		if k == 1 and j == 1 and (i == math.ceil(nx / 2) or i == math.floor(nx / 2) + 1) then return GLOW.Offline, "core" end
		if k == 1 then return BLUE end
		if i == 1 or i == nx then return STEEL end
		return ARMOR
	elseif kind == "abd" then return STEEL
	elseif kind == "hip" then
		if k == 1 and (i == math.ceil(nx / 2) or i == math.floor(nx / 2) + 1) then return GOLD end
		return ARMOR
	elseif kind == "thigh" then return ARMOR
	elseif kind == "shin" then
		if j == ny then return RED end
		return ARMOR
	elseif kind == "foot" then return BLUE
	elseif kind == "arm" then
		if j == ny then return RED end
		return ARMOR
	elseif kind == "fore" then
		if j == 1 and ny > 1 then return GOLD end
		return BLUE
	elseif kind == "fist" then return STEEL
	elseif kind == "pack" then return DARKM
	elseif kind == "ammo" then return ORANGE_C
	elseif kind == "fin" then return GOLD
	elseif kind == "hilt" then return DARKM
	elseif kind == "guard" then return GOLD
	elseif kind == "blade" then return BLADE_OFF, "blade"
	end
	return STEEL
end

-- owner / brick detection ---------------------------------------------------------------------------
local function ownerState(p)
	local function match(v)
		if v == nil then return nil end
		if typeof(v) == "Instance" then v = v.Name end
		if type(v) == "number" then return v == lp.UserId end
		v = tostring(v):lower()
		return v == lp.Name:lower() or v == lp.DisplayName:lower() or v == tostring(lp.UserId)
	end
	local inst = p
	for _ = 1, 4 do
		if not inst or inst == workspace then break end
		for _, nm in ipairs({"Owner", "owner", "Creator", "creator", "Player", "Builder"}) do
			local a = inst:GetAttribute(nm)
			if a ~= nil then return match(a) end
			local c = inst:FindFirstChild(nm)
			if c and c:IsA("ValueBase") then return match(c.Value) end
		end
		local pl = Players:FindFirstChild(inst.Name)
		if pl and pl:IsA("Player") then return pl == lp end
		inst = inst.Parent
	end
	return nil
end
local function usable(p)
	if not p or not p.Parent or p:IsDescendantOf(char) then return false end
	if p.Anchored then return false end
	local okJ, joints = pcall(function() return p:GetJoints() end)
	if okJ and #joints > 0 then return false end
	if ownerState(p) == false then return false end
	if isnetworkowner then
		local okO, own = pcall(isnetworkowner, p)
		if okO and not own then return false end
	end
	return true
end
local function gather()
	local root = workspace:FindFirstChild("Bricks")
	if not root then return nil, "workspace.Bricks not found" end
	local groups, base = {}, hrp.Position
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and usable(d) then
			local s = d.Size
			local a = {s.X, s.Y, s.Z}
			table.sort(a)
			local key = string.format("%.2f,%.2f,%.2f", a[1], a[2], a[3])
			local g = groups[key]
			if not g then g = {dims = a, list = {}}; groups[key] = g end
			g.list[#g.list + 1] = {d, (d.Position - base).Magnitude, ownerState(d) == true and 0 or 1}
		end
	end
	local best, bestScore
	for _, g in pairs(groups) do
		local score = #g.list
		if math.abs(g.dims[3] - WANT_LONG) < 0.3 then score += 1e6 end
		if not bestScore or score > bestScore then best, bestScore = g, score end
	end
	if not best then return nil, "no free bricks found" end
	table.sort(best.list, function(x, y)
		if x[3] ~= y[3] then return x[3] < y[3] end
		return x[2] < y[2]
	end)
	return best.list, best.dims
end
local function orientFor(p)
	local s = p.Size
	local sz = {s.X, s.Y, s.Z}
	local idx = {1, 2, 3}
	table.sort(idx, function(a, b) return sz[a] < sz[b] end)
	local ax = {}
	ax[idx[1]], ax[idx[2]], ax[idx[3]] = V(1, 0, 0), V(0, 0, 1), V(0, 1, 0)
	return CFrame.fromMatrix(V(), ax[1], ax[2])
end

local function groundAt(p, h)
	local res = workspace:Raycast(p + V(0, h, 0), V(0, -(h + 6000), 0), groundP)
	return res and res.Position.Y or p.Y
end
local function refreshFilters()
