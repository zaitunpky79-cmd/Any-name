local function makeButton(text, x, y, w, h, cb)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w, h)
	b.Position = UDim2.fromOffset(x, y)
	b.BackgroundColor3 = Color3.fromRGB(52, 52, 66)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 13
	b.Text = text
	b.BorderSizePixel = 0
	b.Parent = curParent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

local function makeLabel(text, x, y, w)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromOffset(w, 28)
	l.Position = UDim2.fromOffset(x, y)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.Gotham
	l.TextSize = 13
	l.Parent = curParent
	return l
end

local function makeHoldButton(text, x, y, w, h, setHeld)
	local b = makeButton(text, x, y, w, h, function() end)
	b.MouseButton1Down:Connect(function() setHeld(true) end)
	b.MouseButton1Up:Connect(function() setHeld(false) end)
	b.MouseLeave:Connect(function() setHeld(false) end)
	return b
end

