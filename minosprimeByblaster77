-- LAYOUT: Minos Prime as a voxel statue (every cell = one brick) -------------------------------------------------
local cyc = {{1, 1}, {2, 1}, {2, 2}, {1, 2}}
local function checker(i, j, k) return ((i + j + k) % 2 == 0) and BODY1 or BODY2 end
local function slotStyle(kind, i, j, k, nx, ny, nz)
	if kind == "chest" then
		if k == 1 then
			if i == 3 and j == 2 then return HEART, "heart" end
			if (i == 3 and (j == 1 or j == 3)) or (j == 2 and (i == 2 or i == 4)) then return VEIN, "vein" end
		end
		return checker(i, j, k), "body"
	elseif kind == "abdomen" then
		if k == 1 and j == 2 and (i == 2 or i == 3) then return VEIN, "vein" end
		return checker(i, j, k), "body"
	elseif kind == "head" then
		if i == 2 and k == 1 and (j == 1 or j == 2) then return false end -- the hole where the face should be
		if i == 2 and k == 2 and (j == 1 or j == 2) then return HOLE, "hole" end
		return checker(i, j, k), "body"
	elseif kind == "crown" then return CROWN, "body"
	elseif kind:sub(1, 5) == "upper" then -- snake spiral around the arm
		local c = cyc[((j - 1) % 4) + 1]
		if i == c[1] and k == c[2] then return SNAKE, "snake" end
		return checker(i, j, k), "body"
	elseif kind:sub(1, 4) == "fore" then
		local c = cyc[((j + 2) % 4) + 1]
		if i == c[1] and k == c[2] then return SNAKE, "snake" end
		return checker(i, j, k), "body"
	elseif kind == "thigh" then
		if k == 1 and i == 2 and j % 2 == 0 then return VEIN, "vein" end
		return checker(i, j, k), "body"
	end
	return checker(i, j, k), "body"
end

local function layout(c)
	local function sc(v) return V(v.X * c.X, v.Y * c.Y, v.Z * c.Z) end
	local b, o, cells = {}, {}, {}
	local function bone(n, par, pv) b[n] = {parent = par, pv = sc(pv)}; o[#o + 1] = n end
	local function fill(bn, ctr, nx, ny, nz, kind, opt)
		for j = 1, ny do
			for k = 1, nz do
				for i = 1, nx do
					local color, tag = slotStyle(kind, i, j, k, nx, ny, nz)
					if color then
						local pos = ctr + V(i - 0.5 - nx / 2, j - 0.5 - ny / 2, k - 0.5 - nz / 2)
						cells[#cells + 1] = {bone = bn, pos = sc(pos), color = color, tag = tag, opt = opt}
					end
				end
			end
		end
	end
	bone("Root", nil, V(0, 9, 0))
	bone("Waist", "Root", V(0, 11, 0))
	bone("Chest", "Waist", V(0, 14, 0))
	bone("Head", "Chest", V(0, 18, 0))
	fill("Root", V(0, 10, 0), 6, 2, 2, "pelvis")
	fill("Waist", V(0, 12.5, 0), 4, 3, 2, "abdomen")
	fill("Chest", V(0, 15.5, 0), 6, 3, 2, "chest")
	fill("Chest", V(0, 17.5, 0), 2, 1, 2, "neck")
	fill("Head", V(0, 19.5, 0), 3, 3, 3, "head")
	local crown = {{-1, -1, 2}, {0, -1, 3}, {1, -1, 2}, {-1, 0, 3}, {1, 0, 3}, {-1, 1, 2}, {0, 1, 3}, {1, 1, 2}} -- uneven prisms
	for _, cr in ipairs(crown) do fill("Head", V(cr[1], 21 + cr[3] / 2, cr[2]), 1, cr[3], 1, "crown", "crown") end
	for _, sd in ipairs({-1, 1}) do
		local d = sd < 0 and "L" or "R"
		bone("Arm" .. d, "Chest", V(sd * 4, 16, 0))
		bone("Fore" .. d, "Arm" .. d, V(sd * 4, 12, 0))
		bone("Thigh" .. d, "Root", V(sd * 1.5, 9, 0))
		bone("Shin" .. d, "Thigh" .. d, V(sd * 1.5, 5, 0))
		bone("Foot" .. d, "Shin" .. d, V(sd * 1.5, 1, 0))
		fill("Arm" .. d, V(sd * 4, 16, 0), 2, 2, 2, "shoulder")
		fill("Arm" .. d, V(sd * 4, 13.5, 0), 2, 3, 2, "upper" .. d)
		fill("Fore" .. d, V(sd * 4, 10.5, 0), 2, 3, 2, "fore" .. d)
		fill("Fore" .. d, V(sd * 4, 8, 0), 2, 2, 2, "hand", "hands")
		fill("Thigh" .. d, V(sd * 1.5, 7, 0), 2, 4, 2, "thigh")
		fill("Shin" .. d, V(sd * 1.5, 3, 0), 2, 4, 2, "shin")
		fill("Foot" .. d, V(sd * 1.5, 0.5, -0.5), 2, 1, 3, "foot")
	end
	local inf = {
		hipY = 9 * c.Y, Fh = 1 * c.Y, seg = 4 * c.Y,
		headC = sc(V(0, 19.5, 0)), chestC = sc(V(0, 15.5, 0)),
		handL = sc(V(-4, 8, 0)), handR = sc(V(4, 8, 0)), footL = sc(V(-1.5, 0.5, -0.5)), footR = sc(V(1.5, 0.5, -0.5)),
	}
	return b, o, cells, inf
end
local DROP_ORDER = {"crown", "hands"}
local function totalOf(cells, drop)
	local n = 0
	for _, c in ipairs(cells) do
		if not (c.opt and drop[c.opt]) then n += 1 end
	end
	return n
end
local NEED_FULL, NEED_CORE
do
	local _, _, cells = layout(V(1, 1, 1))
	NEED_FULL = totalOf(cells, {})
	NEED_CORE = totalOf(cells, {crown = true, hands = true})
end

-- brick finding ---------------------------------------------------------------------------------------------------
local function getFolder()
	local f = workspace
	for _, n in ipairs(CFG.PATH) do f = f and f:FindFirstChild(n) end
	if f then return f end
	local b = workspace:FindFirstChild("Bricks")
	return b and (b:FindFirstChild(lp.Name) or b:FindFirstChild(lp.DisplayName)) or nil
end
local function owned(p)
	if not isnetworkowner then return true end
	local ok, r = pcall(isnetworkowner, p)
	return (not ok) or r
end
local function usable(p)
	if not p or not p.Parent or p:IsDescendantOf(char) then return false end
	if p.Anchored then return false end
	local okJ, joints = pcall(function() return p:GetJoints() end)
	if okJ and #joints > 0 then return false end
	return true
end
local function gather()
	local folder = getFolder()
	if not folder then return nil, "workspace.Bricks.master_ofbuilds not found" end
	local groups, base = {}, hrp.Position
	for _, d in ipairs(folder:GetDescendants()) do -- every child brick
		if d:IsA("BasePart") and usable(d) then
			local sz = d.Size
			local a = {sz.X, sz.Y, sz.Z}
			table.sort(a)
			local key = string.format("%.2f,%.2f,%.2f", a[1], a[2], a[3])
			local g = groups[key]
			if not g then g = {dims = a, list = {}}; groups[key] = g end
			g.list[#g.list + 1] = {d, (d.Position - base).Magnitude, owned(d) and 0 or 1}
		end
	end
	local best, bestScore
	for _, g in pairs(groups) do
		local score = #g.list
		if math.abs(g.dims[3] - CFG.WANT_LONG) < 0.3 then score += 1e6 end
		if not bestScore or score > bestScore then best, bestScore = g, score end
	end
	if not best then return nil, "no free (unanchored, unwelded) bricks found" end
	table.sort(best.list, function(x, y)
		if x[3] ~= y[3] then return x[3] < y[3] end
		return x[2] < y[2]
	end)
	return best.list, best.dims
end
local function orientFor(p)
	local sz = {p.Size.X, p.Size.Y, p.Size.Z}
	local idx = {1, 2, 3}
	table.sort(idx, function(a, b) return sz[a] < sz[b] end)
	local ax = {}
	ax[idx[1]], ax[idx[2]], ax[idx[3]] = V(1, 0, 0), V(0, 0, 1), V(0, 1, 0)
	return CFrame.fromMatrix(V(), ax[1], ax[2])
end
local function groundAt(p, h)
	local res = workspace:Raycast(p + V(0, h, 0), V(0, -(h + 3000), 0), groundP)
	return res and res.Position.Y or p.Y
end
local function refreshFilters()
	local f = {char}
	if camPart then f[#f + 1] = camPart end
	for _, p in ipairs(pool) do f[#f + 1] = p end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then f[#f + 1] = pl.Character end
	end
	groundP.FilterDescendantsInstances = f
end

-- local look (colors / glow / flames) -------------------------------------------------------------------------------------
local function repaint(k, p2)
	for _, s in ipairs(slots) do
		local p = s.p
		if p.Parent then
			pcall(function()
				local c = s.color
				if s.tag ~= "hole" then c = c:Lerp(Color3.fromRGB(30, 45, 85), 1 - k) end
				if p2 > 0 and s.tag == "body" then c = c:Lerp(Color3.fromRGB(70, 150, 255), p2 * 0.4) end
				p.Color = c
				p.Transparency = mix(0.7, s.trn, k)
			end)
		end
	end
end
local function setFlames(on)
	for _, e in ipairs(flames) do pcall(function() e:Destroy() end) end
	flames = {}
	if not on then return end
	for i, s in ipairs(slots) do
		if s.tag == "body" and i % 6 == 0 and s.p.Parent then
			local e = Instance.new("ParticleEmitter")
			e.Color = ColorSequence.new(Color3.fromRGB(130, 200, 255), Color3.fromRGB(40, 90, 255))
			e.LightEmission = 1
			e.Rate = 6
			e.Lifetime = NumberRange.new(0.6, 1.0)
			e.Speed = NumberRange.new(2, 5)
			e.SpreadAngle = Vector2.new(30, 30)
			e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.2 * UN), NumberSequenceKeypoint.new(1, 0)})
			e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
			e.Acceleration = V(0, 6, 0)
			e.Parent = s.p
			flames[#flames + 1] = e
		end
	end
end

-- avatar rides inside the body ----------------------------------------------------------------------------------------------
local function carryAvatar(on)
	if on then
		pcall(function() hum.PlatformStand = true end)
		avatarSaved = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then avatarSaved[d] = d.CanCollide; d.CanCollide = false end
		end
		pcall(function()
			local old = hrp:FindFirstChild("MinosAvatarAntiG")
			if old then old:Destroy() end
			local bf = Instance.new("BodyForce")
			bf.Name = "MinosAvatarAntiG"
			bf.Force = V(0, hrp.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = hrp
		end)
	else
		pcall(function() local bf = hrp:FindFirstChild("MinosAvatarAntiG"); if bf then bf:Destroy() end end)
		for d, c in pairs(avatarSaved) do pcall(function() d.CanCollide = c end) end
		avatarSaved = {}
		pcall(function() hum.PlatformStand = false end)
		pcall(function() hrp.AssemblyLinearVelocity = V() end)
	end
end
local function setRide(on)
	if on == ride then return end
	ride = on
	carryAvatar(on)
	if on then
		cam.CameraSubject = camPart
		lp.CameraMaxZoomDistance = 3000
		lp.CameraMinZoomDistance = clamp(14 * UN, 20, 400)
	else
		pcall(function() hrp.CFrame = CFrame.new(hp.X, gy + 8, hp.Z) end)
		cam.CameraSubject = hum
		lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance = oldZoomMax, oldZoomMin
	end
end

