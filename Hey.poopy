local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

-- Re-run safe. The other toy scripts use the same toys, so unload them too.
local env = (getgenv and getgenv()) or _G
if env.FTAPUfoUnload then pcall(env.FTAPUfoUnload) end
for _, k in ipairs({
	"FTAPSusanooForm1Unload", "FTAPSusanooHalfUnload", "FTAPSusanooUnload",
	"FTAPHandUnload", "FTAPSnakeUnload",
}) do
	if env[k] then pcall(env[k]) end
end

local MAX_TOYS = 20
local TAU = math.pi * 2
local V = Vector3.new

----------------------------------------------------------------
-- State
----------------------------------------------------------------
local S = {
	active = false,
	busy = false,
	dead = false,
	auto = false, -- autopilot
	ride = false, -- carry you on top (off = you stay on the ground)
	skin = true, -- detailed local saucer
	beam = true, -- tractor beam
	camUFO = true, -- camera follows the UFO while you fly by hand
	size = 6, -- studs per unit (saucer is 8 units wide)
	speed = 60, -- studs / second
	upHeld = false,
	downHeld = false,
}
local claimed = {} -- { part, bp, bg, slot, oldCollide }
local heartbeat
local conns = {}
local skin = nil
local camPart = nil
local savedHum = nil

-- flight state
local pos = Vector3.zero
local vel = Vector3.zero
local spin = 0
local autoTarget = nil
local autoUntil = 0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getRoot()
	local char = lp.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local char = lp.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

----------------------------------------------------------------
-- Toy layout: 20 slots (priority order: apex, belly, rim, inner, dome)
----------------------------------------------------------------
local slots = { { kind = "apex" }, { kind = "bottom" } }
for i = 1, 10 do table.insert(slots, { kind = "rim", i = i }) end
for i = 1, 5 do table.insert(slots, { kind = "inner", i = i }) end
for i = 1, 3 do table.insert(slots, { kind = "dome", i = i }) end

-- position of one toy in saucer space (units)
local function slotLocal(s, sp)
	local k = s.kind
	if k == "apex" then
		return V(0, 1.9, 0)
	elseif k == "bottom" then
		return V(0, -1.0, 0)
	elseif k == "rim" then
		local a = sp + (s.i - 1) * TAU / 10
		return V(math.cos(a) * 4, 0, math.sin(a) * 4)
	elseif k == "inner" then
		local a = -sp * 0.6 + (s.i - 1) * TAU / 5
		return V(math.cos(a) * 2.3, 0.4, math.sin(a) * 2.3)
	else
		local a = sp * 1.5 + (s.i - 1) * TAU / 3
		return V(math.cos(a) * 0.9, 1.1, math.sin(a) * 0.9)
	end
end

----------------------------------------------------------------
-- Toys
----------------------------------------------------------------
local function getToyFolder()
	return workspace:FindFirstChild(lp.Name .. "SpawnedInToys")
		or workspace:FindFirstChild("Ketik_Ketikketik4SpawnedInToys")
end

local function getToyParts()
	local parts = {}
	local folder = getToyFolder()
	if not folder then return parts end
	for _, toy in ipairs(folder:GetChildren()) do
		local sp = toy:FindFirstChild("SoundPart")
		if sp and sp:IsA("BasePart") then
			table.insert(parts, sp)
			if #parts >= MAX_TOYS then break end
		end
	end
	return parts
end

local function claim(part)
	-- The remote name/arguments may change when the game updates.
	return pcall(function()
		RS.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
	end)
end

----------------------------------------------------------------
-- SKIN: detailed saucer (client-side parts, only you see them)
----------------------------------------------------------------
local function mk(parent, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

local function newModel(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	local root = mk(m, nil, V(0.2, 0.2, 0.2), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic, 1)
	m.PrimaryPart = root
	m.Parent = parent
	return m
end

local function destroySkin()
	if skin then
		skin.model:Destroy()
		skin = nil
	end
end

local function buildSkin()
	destroySkin()
	local sz = S.size
	local model = Instance.new("Model")
	model.Name = "UFOSkin"
	skin = { model = model }

	-- hull + dome (moves with the saucer)
	local hull = newModel(model, "Hull")
	local flat = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis -> up
	local function disc(y, dia, thick, color, material, transparency)
		return mk(hull, Enum.PartType.Cylinder, V(thick * sz, dia * sz, dia * sz),
			CFrame.new(0, y * sz, 0) * flat, color, material, transparency)
	end
	disc(0.00, 8.0, 0.8, Color3.fromRGB(170, 175, 190), Enum.Material.Metal)
	disc(0.55, 6.2, 0.5, Color3.fromRGB(150, 156, 175), Enum.Material.Metal)
	disc(-0.55, 5.0, 0.5, Color3.fromRGB(105, 110, 130), Enum.Material.Metal)
	disc(-0.95, 2.0, 0.4, Color3.fromRGB(80, 255, 255), Enum.Material.Neon)
	disc(0.0, 8.15, 0.18, Color3.fromRGB(70, 75, 95), Enum.Material.Metal) -- dark rim band
	-- glass dome with a glowing alien light inside
	mk(hull, Enum.PartType.Ball, V(3.2, 3.2, 3.2) * sz, CFrame.new(0, 1.0 * sz, 0),
		Color3.fromRGB(130, 225, 255), Enum.Material.Glass, 0.45)
	mk(hull, Enum.PartType.Ball, V(1.1, 1.1, 1.1) * sz, CFrame.new(0, 1.0 * sz, 0),
		Color3.fromRGB(120, 255, 170), Enum.Material.Neon, 0.15)
	-- antenna
	mk(hull, nil, V(0.12, 0.9, 0.12) * sz, CFrame.new(0, 2.75 * sz, 0),
		Color3.fromRGB(190, 195, 210), Enum.Material.Metal)
	mk(hull, Enum.PartType.Ball, V(0.3, 0.3, 0.3) * sz, CFrame.new(0, 3.25 * sz, 0),
		Color3.fromRGB(255, 80, 80), Enum.Material.Neon)
	skin.hull = hull

	-- spinning lights
	local lights = newModel(model, "Lights")
	skin.rimLights = {}
	local N = 16
	for i = 1, N do
		local a = (i - 1) * TAU / N
		local p = mk(lights, Enum.PartType.Ball, V(0.5, 0.5, 0.5) * sz,
			CFrame.new(math.cos(a) * 4.0 * sz, 0, math.sin(a) * 4.0 * sz),
			Color3.new(1, 1, 1), Enum.Material.Neon)
		table.insert(skin.rimLights, p)
	end
	for i = 1, 8 do
		local a = (i - 1) * TAU / 8
		mk(lights, Enum.PartType.Ball, V(0.42, 0.42, 0.42) * sz,
			CFrame.new(math.cos(a) * 2.3 * sz, -0.8 * sz, math.sin(a) * 2.3 * sz),
			Color3.fromRGB(255, 240, 150), Enum.Material.Neon)
	end
	skin.lights = lights

	-- tractor beam
	skin.beam = mk(model, Enum.PartType.Cylinder, V(10, 3.5 * sz, 3.5 * sz), CFrame.new(),
		Color3.fromRGB(150, 255, 200), Enum.Material.Neon, 0.8)

	-- outline so you can always find it, even far away or behind things
	local hl = Instance.new("Highlight")
	hl.Adornee = model
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(150, 255, 255)
	hl.OutlineTransparency = 0.25
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model

	model.Parent = workspace
end

