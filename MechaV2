end))

-- Close / minimize / drag
local function unload()
	S.dead = true
	release()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	if gui then gui:Destroy() end
	env.FTAPMechaUnload = nil
end
env.FTAPMechaUnload = unload
close.MouseButton1Click:Connect(unload)

local minimized = false
mini.MouseButton1Click:Connect(function()
	minimized = not minimized
	subTitle.Visible, content.Visible, status.Visible, buildBtn.Visible = not minimized, not minimized, not minimized, not minimized
	main.Size = minimized and UDim2.fromOffset(GUI_W, 34) or UDim2.fromOffset(GUI_W, GUI_H)
	mini.Text = minimized and "+" or "-"
end)

do
	local dragging, dragStart, startPos
	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	table.insert(conns, UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			local vp = gui.AbsoluteSize
			local nx = math.clamp(startPos.X.Offset + d.X, 0, math.max(0, vp.X - main.AbsoluteSize.X))
			local ny = math.clamp(startPos.Y.Offset + d.Y, 0, math.max(0, vp.Y - 40))
			main.Position = UDim2.new(0, nx, 0, ny)
		end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end
