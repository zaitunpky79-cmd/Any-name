local function getToyFolder()
	return workspace:FindFirstChild(lp.Name .. "SpawnedInToys")
		or workspace:FindFirstChild("master_ofbuildsSpawnedInToys")
		or workspace:FindFirstChild("Ketik_Ketikketik4SpawnedInToys")
end

local function toyMain(toy)
	if toy:IsA("BasePart") then return toy end
	return toy:FindFirstChild("SoundPart") or toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart", true)
end

-- kind: "L" ladder / "F" plank. Given by the toy's NAME; otherwise by its shape.
local function classify(part, kindOverride)
	local s = part.Size
	local dims = { { s.X, 1 }, { s.Y, 2 }, { s.Z, 3 } }
	table.sort(dims, function(a, b) return a[1] > b[1] end)
	local L, M, T = dims[1][1], dims[2][1], dims[3][1]
	local kind = kindOverride
	if not kind then
		kind = "F"
		if L / math.max(M, 1e-3) >= 2.2 then
			kind = "L"
		elseif T / math.max(M, 1e-3) > 0.5 and L / math.max(T, 1e-3) >= 3 then
			kind = "L"
		end
	end
	return { part = part, kind = kind, aL = dims[1][2], aM = dims[2][2], aT = dims[3][2], len = L }
end

local function getToyInfos()
	local out = {}
	local folder = getToyFolder()
	if not folder then return out end
	for _, toy in ipairs(folder:GetChildren()) do
		local part = toyMain(toy)
		if part and part:IsA("BasePart") then
			local nm = string.lower(toy.Name)
			local kind
			if string.find(nm, "ladder", 1, true) then
				kind = "L"
			elseif string.find(nm, "pallet", 1, true) or string.find(nm, "plank", 1, true) then
				kind = "F"
			end
			table.insert(out, classify(part, kind))
			if #out >= MAX_TOYS then break end
		end
	end
	return out
end

