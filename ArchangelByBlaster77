-- CUTSCENE: a beam of light made of bricks, Michael kneels in it, takes the sword, speaks -----------------------------------------------------------------------
local function lightColumn(center, gyC)
	local ls = fxTake("L", 16, COL.LIGHT, true)
	local vs = fxTake("V", 10, COL.GOLD, true)
	local ds = fxTake("D", 6, COL.WHITE, true)
	local drop = 260
	local ctl = {list = {}, t0 = os.clock()}
	for i, s in ipairs(ls) do s.ty = gyC + 2 + (i - 1) * 4; s.tx, s.tz = center.X, center.Z; ctl.list[#ctl.list + 1] = s end
	for i, s in ipairs(vs) do
		local a = (i % 4) / 4 * TAU
		s.ty = gyC + 6 + math.floor((i - 1) / 4) * 18
		s.tx, s.tz = center.X + math.cos(a) * 6.5, center.Z + math.sin(a) * 6.5
		s.ang = a
		ctl.list[#ctl.list + 1] = s
	end
	for i, s in ipairs(ds) do
		local a = i / #ds * TAU
		s.ty = gyC + 10 + (i - 1) * 8
		s.tx, s.tz = center.X + math.cos(a) * 4.2, center.Z + math.sin(a) * 4.2
		s.ang = a
		ctl.list[#ctl.list + 1] = s
	end
	task.spawn(function()
		while not ctl.stop do
			RunService.Heartbeat:Wait()
			local el = os.clock() - ctl.t0
			local k = smooth(el / 0.5)
			for _, s in ipairs(ctl.list) do
				local y = s.ty + (1 - k) * drop
				local pos = V(s.tx, y, s.tz)
				if s.ang then
					s.use = yAxisCF(pos, UP, V(math.cos(s.ang), 0, math.sin(s.ang)))
				else
					s.use = CFrame.new(pos) * CFrame.Angles(0, el * 0.6, 0)
				end
				pcall(function() s.p.Transparency = ctl.fade or 0 end)
			end
		end
		local all = {}
		for _, s in ipairs(ctl.list) do all[#all + 1] = s end
		scatter(all, center + V(0, 20, 0), 46, 1.2)
	end)
	-- the full-height shaft of light (local parts) so the beam reaches the sky
	local shaft = {}
	for i = 1, 3 do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Shape = Enum.PartType.Cylinder
		p.Material = Enum.Material.Neon
		p.Color = (i == 1) and COL.WHITE or COL.GOLD
		p.Transparency = 0.2 + i * 0.2
		p.Size = V(700, 8 + i * 5, 8 + i * 5)
		p.CFrame = CFrame.new(center.X, gyC + 345, center.Z) * CFrame.Angles(0, 0, HALF)
		p.Parent = workspace
		shaft[i] = p
	end
	ctl.shaft = shaft
	return ctl
end

local function runIntro(arena, hdFace)
	local UNIT = 1
	startCine(function(t)
		local ctr = V(arena.X, S.gy, arena.Z)
		local ahead = F3(S.hd)
		local right = CFrame.Angles(0, S.hd, 0):VectorToWorldSpace(V(1, 0, 0))
		if t < 2.0 then -- looking up at the darkening sky
			local k = smooth(t / 2.0)
			return ctr + ahead * 70 + right * 20 + V(0, 4, 0), ctr + V(0, mix(70, 90, k), 0), mix(60, 55, k)
		elseif t < 5.6 then -- the beam hits; follow it down to the ground
			local k = smooth((t - 2.0) / 3.6)
			return ctr + ahead * mix(70, 46, k) + right * mix(20, -18, k) + V(0, mix(6, 22, k), 0), ctr + V(0, mix(60, 14, k), 0), mix(62, 50, k)
		elseif t < 8.8 then -- Michael kneeling, slow orbit
			local k = smooth((t - 5.6) / 3.2)
			local a = mix(-0.7, 0.5, k)
			return ctr + CFrame.Angles(0, S.hd, 0):VectorToWorldSpace(V(math.sin(a) * 30, mix(5, 10, k), -math.cos(a) * 30)), S.bodyPos - V(0, 2, 0), mix(55, 46, k)
		elseif t < 11.4 then -- hands on the sword, then pulling it out
			local k = smooth((t - 8.8) / 2.6)
			return ctr + ahead * mix(26, 34, k) + right * mix(8, 14, k) + V(0, mix(5, 3, k), 0), ctr + V(0, mix(10, 14, k), 0), mix(48, 56, k)
		elseif t < 17.8 then -- face close-up for the speech
			local k = smooth((t - 11.4) / 6.4)
			return S.headPos + ahead * mix(20, 12, k) + right * mix(6, -2, k) + V(0, mix(-3, 0, k), 0), S.headPos + V(0, 1, 0), mix(44, 32, k)
		else -- pull back wide for the title
			local k = smooth((t - 17.8) / 2.6)
			return ctr + ahead * mix(26, 70, k) + right * mix(4, 18, k) + V(0, mix(8, 22, k), 0), S.bodyPos, mix(46, 62, k)
		end
	end)
	task.spawn(function()
		local col
		local function seq()
			TweenService:Create(CN.fade, TweenInfo.new(1.4), {BackgroundTransparency = 1}):Play()
			skyDim(true)
			sfx("holy", 0.7, 0.5)
			if W(2.0) then return end
			-- the beam of light made of bricks shoots down from the sky
			col = lightColumn(arena, S.gy)
			sfx("boom")
			sfx("beam", 1.2, 0.6)
			flashScreen(0.9, COL.LIGHT)
			S.flare = 1
			ring(V(arena.X, S.gy, arena.Z), 30, COL.GOLD, 1.0)
			ring(V(arena.X, S.gy, arena.Z), 50, COL.WHITE, 1.4)
			dust(V(arena.X, S.gy, arena.Z), 40, 14, COL.LIGHT)
			if W(0.5) then return end
			for i = 1, 5 do
				ring(V(arena.X, S.gy, arena.Z), 12 + i * 6, COL.GOLD, 0.8)
				shakeFrom(V(arena.X, S.gy, arena.Z), 1, 0.3, 600)
				S.flare = 0.5
				if W(0.6) then return end
			end
			-- the light opens: Michael is revealed, kneeling
			col.stop = true
			for _, p in ipairs(col.shaft) do
				TweenService:Create(p, TweenInfo.new(1.4), {Transparency = 1}):Play()
				Debris:AddItem(p, 1.6)
			end
			S.bodyVis = true
			flashScreen(0.9, COL.WHITE)
			sfx("holy", 1.2)
			feathers(V(arena.X, S.gy + 8, arena.Z), 16, 3)
			ring(V(arena.X, S.gy, arena.Z), 40, COL.WHITE, 1.2)
			S.flare = 1
			if W(0.6) then return end
			-- wings unfold, head still bowed
			local t0 = os.clock()
			while os.clock() - t0 < 2.0 do
				S.wingS = mix(0.25, 0.85, smooth((os.clock() - t0) / 2.0))
				RunService.Heartbeat:Wait()
				if S.skip then return end
			end
			sfx("wing")
			if W(1.2) then return end
			-- he lifts his head and grips the sword
			poseSet({head = 0.7, armL = 0.2}, 2)
			if W(1.0) then return end
			sfx("holy", 1, 0.8)
			poseSet({head = 0.3}, 3)
			if W(0.6) then return end
			-- pulls the sword out of the ground and rises
			S.kneel = false
			S.wingS = 0.9
			local t2 = os.clock()
			while os.clock() - t2 < 1.8 do
				RunService.Heartbeat:Wait()
				if S.skip then return end
				if math.random() < 0.3 then dust(V(arena.X, S.gy, arena.Z) + F3(S.hd) * 5.5, 6, 8, COL.LIGHT) end
			end
			ring(V(arena.X, S.gy, arena.Z), 36, COL.GOLD, 1.0)
			ring(V(arena.X, S.gy, arena.Z), 20, COL.WHITE, 0.7)
			shakeFrom(V(arena.X, S.gy, arena.Z), 1.4, 0.6, 600)
			flashScreen(0.4, COL.LIGHT)
			sfx("boom", 0.8)
			poseSet({armR = 1.1, foreR = 0.2, head = 0.25}, 4) -- the sword raised
			feathers(V(arena.X, S.gy + 10, arena.Z), 12, 3)
			if W(1.6) then return end
			-- he speaks
			for i, line in ipairs(CFG.SPEECH) do
				CN.speech.Text = ""
				if typewrite(line, math.max(0.9, #line * 0.11)) then return end
				if W((i == #CFG.SPEECH) and 1.4 or 0.7) then return end
			end
			CN.speech.Text = ""
			titleCard("ARCHANGEL MICHAEL", "ANGEL OF ALL ANGELS")
			sfx("holy", 1.2, 0.7)
			ring(V(arena.X, S.gy, arena.Z), 44, COL.GOLD, 1.2)
			if W(3.0) then return end
		end
		seq()
		-- final state (also when skipped)
		if col then col.stop = true; for _, p in ipairs(col.shaft) do pcall(function() p:Destroy() end) end end
		S.bodyVis = true
		S.kneel = false
		S.kneelK, S.swPlant = 0, 0
		S.wingS = 0.8
		S.flare = 0
		CN.speech.Text = ""
		skyDim(false)
		poseSet(IDLE_POSE, 4)
		for k in pairs(S.pose) do S.pose[k] = S.poseT[k] end
		endCine()
		if S.alive then notify("Michael has descended. Keys 1-7: Slash, Beam, Teleport, Kneel, Fly, Fly Slash, Fly Beam.", 7) end
	end)
end

-- summon / dismiss -------------------------------------------------------------------------------------------------------------------------------------------------
local function finishDismiss()
	setControl(false)
	for _, s in ipairs(S.saved or {}) do
		local p = s.p
		if p and p.Parent then
			pcall(function()
				local bf = p:FindFirstChild("MichaelAntiG")
				if bf then bf:Destroy() end
				p.CFrame = s.cf
				p.Anchored = s.anchored
				p.CanCollide = s.collide
				p.Color, p.Material, p.Transparency = s.color, s.material, s.transparency
				p.AssemblyLinearVelocity = V()
			end)
		end
	end
	if S.camPart then S.camPart:Destroy(); S.camPart = nil end
	skyDim(false)
	S.pool, S.slots, S.body, S.swSlots, S.saved, S.fxFree = {}, {}, {}, {}, {}, {}
	S.alive, S.act, S.targetPl, S.dismissing, S.flying, S.kneel, S.h = false, nil, nil, false, false, false, 0
end
local function runDiagnosis()
	local byType, other, unusable = scan()
	if not byType then return nil, {tostring(other)} end
	local ok, lines = diagnose(byType, other, unusable)
	return ok, lines, byType
end
local CNinfo = {lbl = nil}
local function summon()
	if S.alive or S.dismissing then return end
	local ok, lines, byType = runDiagnosis()
	if ok == nil then notify("Cannot scan: " .. tostring(lines[1]), 8) return end
	if CNinfo.lbl then CNinfo.lbl.Text = table.concat(lines, "\n") end
	if not ok then
		for _, l in ipairs(lines) do
			if l:sub(1, 3) == "[X]" then notify("Cannot summon: " .. l, 9) break end
		end
		return
	end
	local notOwned = 0
	local chosen = {}
	for _, t in ipairs(TYPES) do
		local list = byType[t.id]
		chosen[t.id] = {}
		for i = 1, NEED[t.id] do
			chosen[t.id][i] = list[i][1]
			if list[i][3] ~= 0 then notOwned += 1 end
		end
	end
	if isnetworkowner and notOwned > 0 then
		notify(string.format("%d of the bricks are not yours right now. Walk next to your bricks and summon again.", notOwned), 9)
		return
	end
	local counter = {}
	for _, t in ipairs(TYPES) do counter[t.id] = 0 end
	local function nextBrick(tp)
		counter[tp] += 1
		return chosen[tp][counter[tp]]
	end
	local bones, order, cells = bodyCells()
	S.bones, S.order = bones, order
	S.slots, S.body, S.swSlots, S.saved, S.pool, S.fxFree = {}, {}, {}, {}, {}, {}
	for _, t in ipairs(TYPES) do S.fxFree[t.id] = {} end
	local function register(p, s)
		S.pool[#S.pool + 1] = p
		S.slots[#S.slots + 1] = s
		S.saved[#S.saved + 1] = {p = p, cf = p.CFrame, anchored = p.Anchored, collide = p.CanCollide, color = p.Color, material = p.Material, transparency = p.Transparency}
	end
	local fi = 0
	for _, c in ipairs(cells) do
		local p = nextBrick(c.tp)
		fi += 1
		local s = {p = p, kind = "fk", tp = c.tp, bone = c.bone, off = c.pos - bones[c.bone].pv, orient = orientFor(p, c.code), color = c.color, tag = c.tag, fi = fi}
		register(p, s)
		S.body[#S.body + 1] = s
	end
	for _, c in ipairs(swordCells()) do
		local p = nextBrick(c.tp)
		fi += 1
		local s = {p = p, kind = "sw", tp = c.tp, off = c.pos, orient = orientFor(p, c.code), color = c.color, tag = c.tag, fi = fi}
		register(p, s)
		S.body[#S.body + 1] = s
	end
	local fx = 0
	for _, t in ipairs(TYPES) do
		for _ = 1, EFFECT[t.id] or 0 do
			local p = nextBrick(t.id)
			fx += 1
			local s = {p = p, kind = "fx", tp = t.id, fi = fx, orient = orientFor(p, "xzy"), color = COL.LIGHT, tag = "fx"}
			register(p, s)
			S.fxFree[t.id][#S.fxFree[t.id] + 1] = s
		end
	end
	for _, s in ipairs(S.slots) do
		local p = s.p
		pcall(function() p.Anchored = false; p.CanCollide = false end)
		pcall(function()
			local bf = Instance.new("BodyForce")
			bf.Name = "MichaelAntiG"
			bf.Force = V(0, p.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = p
		end)
		pcall(function()
			p.Color = s.color
			p.Material = (s.kind ~= "fx" and (s.tag == "glow" or s.tag == "halo")) and Enum.Material.Neon or Enum.Material.SmoothPlastic
			p.Transparency = 0
		end)
	end
	pcall(function() lp.MaximumSimulationRadius = math.huge end)
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)
	refreshFilters()

	-- arena: in front of you, Michael faces you
	local hcf = hrp.CFrame
	local look = flatDir(hcf.LookVector)
	local ap = hcf.Position + look * 48
	S.pos = V(ap.X, 0, ap.Z)
	S.hd = math.atan2(look.X, look.Z)
	S.gy = groundAt(V(ap.X, hcf.Position.Y + 20, ap.Z), 60)
	S.vel, S.curSp, S.h, S.dash, S.faceH, S.hold = V(), 0, 0, nil, nil, nil
	S.flying, S.kneel, S.kneelK, S.swPlant, S.wingS = false, true, 1, 1, 0.25
	S.bodyVis = false
	S.control, S.targetPl, S.act = false, nil, nil
	S.gt = {ph = 0, gait = 0}
	for k in pairs(S.pose) do S.pose[k] = 0; S.poseT[k] = 0 end
	S.world = {}
	S.alive = true
	step(0.016)
	applyTargets()
	CN.fade.BackgroundTransparency = 0
	CN.fade.Visible = true
	runIntro(Vector3.new(ap.X, 0, ap.Z), S.hd)
	notify(string.format("Summoning Michael with %d bricks (%d body + %d effect)...", #S.slots, #S.body, fx), 5)
end
local function dismiss()
	if not S.alive or S.dismissing then return end
	S.dismissing = true
	S.skip = true
	S.targetPl = nil
	task.spawn(function()
		task.wait(0.25)
		endCine()
		S.act = "Dismiss"
		S.flying, S.kneel = false, false
		flash(V(S.pos.X, S.gy + 9, S.pos.Z), 18, COL.LIGHT)
		feathers(V(S.pos.X, S.gy + 10, S.pos.Z), 14, 2)
		local t0 = os.clock()
		while os.clock() - t0 < 1.0 do
			local k = (os.clock() - t0) / 1.0
			for _, s in ipairs(S.body) do pcall(function() s.p.Transparency = clamp(k, 0, 1) end) end
			RunService.Heartbeat:Wait()
		end
		finishDismiss()
		notify("Michael dismissed. Bricks returned.", 3)
	end)
end

