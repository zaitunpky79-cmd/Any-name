	S.dash = {spd = 22, t = 0.2}
	wt(0.1)
	local o = V(S.pos.X, S.gy + S.h + 9, S.pos.Z)
	crescent(o + dir * 3, dir, side, 0.9, 14)
	flash(swordTipPos(), 12, COL.LIGHT)
	for i = 1, 4 do ring(V(S.pos.X, S.gy, S.pos.Z) + dir * (i * 14), 6 + i * 3, COL.GOLD, 0.5) end
	shakeFrom(o, 0.8, 0.3, 300)
	wt(0.5)
	poseSet(IDLE_POSE, 5)
	S.faceH = nil
end

function skills.Beam()
	shout("SWORD BEAM")
	local a = aimPoint()
	S.faceH = headingTo(S.pos, a)
	poseSet({armR = 1.2, foreR = -1.2, lean = -0.05, armL = 0.4}, 7) -- sword out in front
	wt(0.6)
	sfx("beam", 1, 0.9)
	local charge = fxTake("M", 6, COL.WHITE, true)
	local t0 = os.clock()
	while os.clock() - t0 < 0.8 do -- light gathers in the blade
		local k = (os.clock() - t0) / 0.8
		local tip = swordTipPos()
		for i, s in ipairs(charge) do
			local ang = i / #charge * TAU + k * 12
			s.use = CFrame.new(tip + V(math.cos(ang), math.sin(ang * 1.4), math.sin(ang)) * (8 * (1 - k) + 1.5)) * CFrame.Angles(k * 7, k * 5, 0)
		end
		RunService.Heartbeat:Wait()
	end
	fxGive(charge)
	flash(swordTipPos(), 14, COL.WHITE)
	flashScreen(0.3, COL.LIGHT)
	sfx("boom", 0.8)
	local tgt = V(a.X, a.Y + 2, a.Z)
	local dur = 1.4
	beamFx(function() return swordTipPos() end, function() return tgt end, dur, COL.LIGHT, 16, true)
	local t1 = os.clock()
	while os.clock() - t1 < dur do
		ring(V(a.X, S.gy, a.Z), 8 + (os.clock() - t1) * 12, COL.GOLD, 0.4)
		shakeFrom(a, 0.6, 0.15, 400)
		task.wait(0.18)
	end
	flash(tgt, 22, COL.LIGHT)
	ringBricks(V(a.X, S.gy, a.Z), 3, 26, 8, "M", 0.7, COL.GOLD)
	shakeFrom(a, 1.4, 0.5, 500)
	wt(0.4)
	poseSet(IDLE_POSE, 5)
	S.faceH = nil
end

function skills.Teleport() -- teleport behind people
	shout("TELEPORT")
	local th = targetHrp(S.targetPl or nearestOther())
	local dest, face
	if th then
		local l = flatDir(th.CFrame.LookVector)
		dest = V(th.Position.X, 0, th.Position.Z) - l * 8
		face = th.Position
	else
		local l = F3(S.hd)
		dest = V(S.pos.X, 0, S.pos.Z) + l * 40
		face = dest + l * 20
	end
	local from = V(S.pos.X, S.gy + S.h + 8, S.pos.Z)
	sfx("tp")
	flash(from, 16, COL.LIGHT)
	feathers(from, 10, 1.4)
	ring(V(S.pos.X, S.gy, S.pos.Z), 14, COL.GOLD, 0.6)
	local ng = groundAt(V(dest.X, hrp.Position.Y + 20, dest.Z), 60)
	local to = V(dest.X, ng + S.h + 8, dest.Z)
	streak(from, to, COL.LIGHT, 1.6)
	S.pos = V(dest.X, 0, dest.Z)
	S.gy = ng
	S.hd = headingTo(S.pos, face)
	flash(to, 16, COL.LIGHT)
	feathers(to, 10, 1.4)
	ring(V(dest.X, ng, dest.Z), 14, COL.GOLD, 0.6)
	shakeFrom(to, 0.8, 0.25, 300)
