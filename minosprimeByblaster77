RunService:BindToRenderStep("MinosShake", Enum.RenderPriority.Camera.Value + 1, function()
	local left = shakeEnd - os.clock()
	if left > 0 and not cutActive then
		local a = shakeAmp * math.min(1, left)
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0)
			* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)
	end
end)
local function shakeFrom(pos, power, secs, range)
	local k = clamp(1 - (cam.CFrame.Position - pos).Magnitude / range, 0, 1)
	if k > 0 then shakeAmp, shakeEnd = power * k, os.clock() + secs end
end
local function ring(pos, radius, color)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.fromRGB(140, 200, 255)
	p.Transparency = 0.35
	p.Size = V(0.4, 2, 2)
	p.CFrame = CFrame.new(pos + V(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = V(0.4, radius * 2, radius * 2), Transparency = 1}):Play()
	Debris:AddItem(p, 0.9)
end
local function flash(pos, size, color)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.fromRGB(150, 210, 255)
	p.Size = V(size * 0.4, size * 0.4, size * 0.4)
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.2), {Size = V(size, size, size), Transparency = 1}):Play()
	Debris:AddItem(p, 0.3)
end
local function explode(pos, radius, power)
	flash(pos + V(0, radius * 0.3, 0), radius * 1.6, Color3.fromRGB(255, 170, 60))
	ring(pos, radius * 2, Color3.fromRGB(255, 190, 90))
	shakeFrom(pos, power, 0.9, 260 * UN)
end
local function streak(a, b, color)
	local d = (b - a)
	if d.Magnitude < 0.5 then return end
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.fromRGB(150, 210, 255)
	p.Size = V(1.4 * UN, 1.4 * UN, d.Magnitude)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.35), {Transparency = 1, Size = V(0.1, 0.1, d.Magnitude)}):Play()
	Debris:AddItem(p, 0.5)
end
local function burst(pos, n) -- shards flying out (intro shatter)
	for _ = 1, n do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(150, 210, 255)
	p.Size = V(size * 0.4, size * 0.4, size * 0.4)
