-- [[ DRAGON SKELETAL & LERP SMOOTH WING RUNNING LOOP ]] --
RS.Heartbeat:Connect(function(dt)
    local totalProps = #wingRemoteCache
    if not petMode or totalProps < 1 then return end

    local t = tick()
    local currentPos = VirtualRootCFrame.Position
    local calculatedVelocity = (currentPos - lastPosition) / math.max(dt, 0.001)
    lastPosition = currentPos

    local lagComp = flying and math.clamp(flySpeed * 0.25, 0, 50) or 0
    local safePing = math.clamp(estimatedPing, 0.01, 0.25)
    
    local predictedPosition = currentPos + (calculatedVelocity * safePing)
    local baseTargetCF = CFrame.new(predictedPosition, predictedPosition + VirtualRootCFrame.LookVector)
    
    local finalPos = baseTargetCF * CFrame.new(0, flying and -4 or 7, (flying and -5 or 0) - lagComp)
    local rotCF = CFrame.Angles(math.rad(MANUAL_ROTATION.X), math.rad(MANUAL_ROTATION.Y), math.rad(MANUAL_ROTATION.Z))
    local rollManeuverCF = CFrame.Angles(math.rad(currentRoll), 0, 0) 

    local lerpAlpha = 1 - math.exp(-14 * dt)

    local wingSpeed = flying and 8 or 4
    local waveValue = (math.sin(t * wingSpeed) + 1) / 2 

    local tailSpeed = 6

    for i, offset in ipairs(B2SpiritParts) do
        if i <= totalProps then
            local animatedOffset = offset

            if i >= 4 and i <= 9 then
                local wingIdx = i - 3 
                local upCF = CustomWingUp[wingIdx]
                local dnCF = CustomWingDn[wingIdx]
                
                if upCF and dnCF then
                    local blendedWingCF = upCF:Lerp(dnCF, waveValue)
                    local pureRotation = blendedWingCF - blendedWingCF.Position
                    local centerAlignment = Vector3.new(-20, 0, 7) 
                    animatedOffset = CFrame.new(blendedWingCF.Position + centerAlignment) * pureRotation
                end

            -- MODIFIKASI SEGMEN EKOR (SEGMENT 10 DIKUNCI / NO ANIMATION)
            elseif i == 10 then
                -- Prop ke-10 dikunci sepenuhnya ke nilai offset aslinya (Statis)
                animatedOffset = offset
                
            elseif i >= 11 and i <= 15 then
                local tailIndex = (i - 9)
                local chainDelay = math.sin((t * tailSpeed) - (tailIndex * 0.5))
                local angleY = math.rad(chainDelay * (12 / (tailIndex * 0.5)))
                animatedOffset = offset * CFrame.Angles(0, angleY, 0)
            end

            local targetCF = finalPos * rotCF * rollManeuverCF * animatedOffset
            currentCFrames[i] = (currentCFrames[i] or targetCF):Lerp(targetCF, lerpAlpha)
        end
    end

    if t - lastNetworkUpdate > 0.014 then
        local canUpdateColor = (t - lastColorUpdate > 0.05)
        local frameCFrames = currentCFrames
        
        for i = 1, totalProps do
            local prop = wingRemoteCache[i]
            local targetCFrame = frameCFrames[i]
            
            if prop and targetCFrame then
                task.spawn(function()
                    local cfR = prop:FindFirstChild("SetCurrentCFrame")
                    if cfR then 
                        local startSend = os.clock()
                        pcall(function() 
                            cfR:InvokeServer(targetCFrame) 
                            if i == 1 then
                                estimatedPing = (estimatedPing * 0.85) + ((os.clock() - startSend) * 0.15)
                            end
                        end) 
                    end
                    
                    if canUpdateColor and i == colorIndex then
                        local crR = prop:FindFirstChild("ChangePropColor")
                        if crR then pcall(function() crR:InvokeServer(getAbyssColor(t, i)) end) end
                    end
                end)
            end
        end
        
        if canUpdateColor then
            colorIndex = (colorIndex % totalProps) + 1
            lastColorUpdate = t
        end
        lastNetworkUpdate = t
    end
end)

RS.RenderStepped:Connect(function(dt)
    local char = LP.Character
    if flying and char and char:FindFirstChild("HumanoidRootPart") then
        local root, hum, cam = char.HumanoidRootPart, char.Humanoid, workspace.CurrentCamera
        local bv = root:FindFirstChild("CodeVel") or Instance.new("BodyVelocity", root)
        local bg = root:FindFirstChild("CodeGyro") or Instance.new("BodyGyro", root)
        bv.Name, bg.Name = "CodeVel", "CodeGyro"
        bv.MaxForce, bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8), Vector3.new(1e8, 1e8, 1e8)
        bg.P, bg.D, hum.PlatformStand = 48000, 520, true
        
        local rel = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
        local rawVel = ((cam.CFrame.LookVector * -rel.Z) + (cam.CFrame.RightVector * rel.X) + (Vector3.new(0,1,0) * vVect))
        
        bv.Velocity = (rawVel.Magnitude > 0) and (rawVel.Unit * (flySpeed * 25)) or Vector3.zero
        bg.CFrame = cam.CFrame

        local targetRoll = 0
        local activeLerpSpeed = ROLL_SPEED

        if rawVel.Magnitude > 0 then
            if math.abs(rel.X) > 0.1 then
                targetRoll = math.clamp(-rel.X * MAX_ROLL, -MAX_ROLL, MAX_ROLL)
            else
                targetRoll = 0
            end
        else
            local rawMouseDelta = UIS:GetMouseDelta()
            smoothedMouseX = smoothedMouseX + (rawMouseDelta.X - smoothedMouseX) * math.min(18 * dt, 1)
            
            if math.abs(smoothedMouseX) > 0.5 then
                targetRoll = math.clamp(-smoothedMouseX * 1.8, -MAX_ROLL, MAX_ROLL)
            else
                targetRoll = 0
            end
        end
        
        if math.abs(targetRoll) < 0.5 then
            targetRoll = 0
            activeLerpSpeed = BASE_RETURN_SPEED + (math.abs(currentRoll) * 0.4) 
        end
        
        currentRoll = currentRoll + (targetRoll - currentRoll) * (1 - math.exp(-activeLerpSpeed * dt))
    else
        currentRoll = currentRoll + (0 - currentRoll) * (1 - math.exp(-22 * dt))
    end
    
    if noclip and char then 
        for _, v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end 
    end
end)

