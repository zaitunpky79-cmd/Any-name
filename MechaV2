		e.Color = ColorSequence.new(Color3.fromRGB(150, 150, 155), Color3.fromRGB(90, 90, 95))
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3 * sz), NumberSequenceKeypoint.new(1, 1.2 * sz) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		e.LightEmission = 0
	end
	e.Parent = parent
	return e
end

